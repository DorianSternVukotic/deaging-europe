---
/**
 * ExpandableDrawer — a native <details> drawer on ink hairlines: a big title
 * (plus an optional one-line short answer, always visible) and a chevron;
 * open, the full content. Content stays in the DOM, so it is searchable and
 * keyboard/screen-reader friendly without JS.
 *
 * Drawers stack without gaps: each draws its top rule, the last one in a run
 * draws the bottom rule too. Full content goes in the default slot (or pass
 * `bodyHtml`).
 */
interface Props {
  id?: string;
  title: string;
  /** One-line plain-language answer, always visible. Omit for title-only. */
  short?: string;
  /** Full content as HTML. Alternative to the default slot. */
  bodyHtml?: string;
  class?: string;
}
const { id, title, short, bodyHtml, class: className = '' } = Astro.props;
---

<details id={id} class:list={['exp-drawer group scroll-mt-32 border-t border-ink last:border-b', className]}>
  <summary class="exp-summary cursor-pointer grid grid-cols-[minmax(0,1fr)_40px] md:grid-cols-[minmax(0,1fr)_44px] gap-4 md:gap-6 items-center py-3.5 min-h-[44px]">
    <div class="min-w-0 max-w-[980px]">
      <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">
        {title}
      </h3>
      {short && <p class="mt-1 text-ink/65 text-[15px] leading-snug">{short}</p>}
    </div>
    <span class="toggle justify-self-end" aria-hidden="true"></span>
  </summary>

  <div class="exp-body pb-6 max-w-[900px]">
    {bodyHtml ? (
      <div class="prose-anti" set:html={bodyHtml}></div>
    ) : (
      <div class="prose-anti"><slot /></div>
    )}
    <button type="button" class="exp-collapse cta mt-4">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
      Show less
    </button>
  </div>
</details>

<script>
  // "Show less" lives at the bottom of the body, outside the <summary>, so a
  // click there can't toggle the <details> natively — close it manually.
  document.querySelectorAll<HTMLButtonElement>('.exp-collapse').forEach((btn) => {
    btn.addEventListener('click', () => {
      const drawer = btn.closest('details');
      if (!drawer) return;
      drawer.open = false;
      drawer.querySelector('summary')?.scrollIntoView({ block: 'nearest' });
    });
  });
</script>

<style>
  /* The opener: an accent chevron drawn in CSS, pointing up when open. */
  .toggle {
    position: relative;
    width: 40px;
    height: 40px;
    display: block;
    color: var(--color-accent);
    transition: color 0.15s ease, transform 0.2s ease;
  }
  .toggle::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 7px;
    width: 15px;
    height: 15px;
    margin-left: -7.5px;
    border-right: 3px solid currentColor;
    border-bottom: 3px solid currentColor;
    transform: rotate(45deg);
  }
  @media (min-width: 768px) {
    .toggle { width: 44px; height: 44px; }
    .toggle::after { width: 17px; height: 17px; margin-left: -8.5px; }
  }
  summary:hover .toggle { color: var(--color-ink); }
  details[open] > summary .toggle { transform: rotate(180deg); color: var(--color-accent); }

  /* Reveal-on-open feel — the body fades in. Respects reduced motion. */
  .exp-drawer .exp-body { animation: exp-reveal 0.22s ease-out; }
  @keyframes exp-reveal {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .exp-drawer .exp-body { animation: none; }
  }
</style>
