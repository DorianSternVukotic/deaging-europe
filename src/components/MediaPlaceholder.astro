---
/**
 * MediaPlaceholder — the flat bench-grey figure field with a mono caption
 * top-left, for image/video slots while the real assets aren't ready:
 *
 *   image: "the pinch test, two sites" / "4:5 · to be supplied"
 *   video: "VIDEO · 16:9 · 2:00" with a centred play square
 *
 * The aspect-ratio box keeps layout from jumping when the asset drops in.
 * `caption` renders below the frame.
 */
interface Props {
  /** "image" or "video" — controls the chrome */
  kind?: 'image' | 'video';
  /** CSS aspect ratio (e.g. "16/9", "4/5", "1/1") */
  ratio?: string;
  /** What the picture will show — the caption's first line */
  label?: string;
  /** Video length shown in the caption, e.g. "2:00" */
  duration?: string;
  /** Text under the frame */
  caption?: string;
  /** Optional extra classes */
  class?: string;
}

const { kind = 'image', ratio = '16/9', label, duration = '2:00', caption, class: klass = '' } = Astro.props;

const ratioLabel = ratio.replace('/', ':');
const line1 = kind === 'video' ? `VIDEO · ${ratioLabel} · ${duration}` : label;
const line2 = kind === 'video' ? label : `${ratioLabel} · to be supplied`;
const aria = kind === 'video' ? `Video placeholder, ${label ?? ''}` : `Image placeholder, ${label ?? ''}`;
---

<figure class={`media-ph ${klass}`}>
  <div class="relative w-full overflow-hidden bg-bench" style={`aspect-ratio: ${ratio};`} role="img" aria-label={aria}>
    <div class="absolute top-3.5 left-4 right-4 font-mono text-[11px] tracking-[0.04em] leading-normal text-steel">
      {line1}{line2 && <><br />{line2}</>}
    </div>
    {kind === 'video' && (
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 border border-ink flex items-center justify-center text-ink text-lg" aria-hidden="true">▶</div>
    )}
  </div>
  {caption && <figcaption class="mt-2.5 font-display font-medium text-lg leading-snug tracking-tight">{caption}</figcaption>}
</figure>
