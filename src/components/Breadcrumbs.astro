---
/**
 * Breadcrumbs — the visible trail that matches the BreadcrumbList schema
 * BaseLayout emits. Rendered by BaseLayout at the top of <main>, so it sits
 * under the header and the hero's top padding absorbs it (negative margin).
 * The last item is the current page (no link).
 */
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---
{items.length > 1 && (
  <nav aria-label="Breadcrumb" class="max-w-[1440px] mx-auto px-5 md:px-14 pt-5 -mb-8 md:-mb-12">
    <ol class="mono flex flex-wrap items-center gap-x-2 gap-y-1">
      {items.map((item, i) => (
        <li class="flex items-center gap-x-2" aria-current={i === items.length - 1 ? 'page' : undefined}>
          {i > 0 && <span aria-hidden="true" class="text-ink/30">/</span>}
          {item.href && i < items.length - 1 ? (
            <a href={item.href} class="hover:text-accent transition-colors">{item.name}</a>
          ) : (
            <span class="text-ink">{item.name}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}
