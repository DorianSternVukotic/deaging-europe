---
/**
 * EvidenceRow — one collapsible row in the "what the evidence says" chart,
 * rating first.
 *
 * Closed: a four-cell scale (one cell per tier, filled in the tier's colour)
 * with the tier word under it, then the title with its one-line summary,
 * then a chevron. The summary stays visible so a skimmer
 * gets the gist without opening anything.
 *
 * Open: the summary as a lead, the body, the key/value fields (best for,
 * sessions, downtime, cost) on hairlines, and — when `figure` is set — a 4:5
 * figure beside it (the row's own photo, or the placeholder field).
 *
 * Rows stack on ink hairlines; the chart wrapper draws the column heads.
 */
import MediaPlaceholder from './MediaPlaceholder.astro';
import { evidenceColor, type Evidence } from '../data/evidence';

// Structural shape, so the row works with any data module (collagen, future guides…)
// without coupling to one Section type.
interface EvidenceItem {
  id: string;
  title: string;
  tldr: string;
  evidence?: Evidence;
  bodyHtml: string;
  note?: string;
  sessions?: string;
  downtime?: string;
  cost?: string;
  /** Optional 4:5 photo shown beside the expanded body (needs `figure`). */
  image?: { src: string; alt: string };
}

interface Props {
  s: EvidenceItem;
  /** Show the 4:5 figure (photo or placeholder) beside the expanded body. */
  figure?: boolean;
  /** Render expanded on load (e.g. the row that carries the product pick). */
  open?: boolean;
}
const { s, figure = false, open = false } = Astro.props;

const level: Record<Evidence, number> = { strong: 4, moderate: 3, emerging: 2, limited: 1 };
const word: Record<Evidence, string> = {
  strong: 'Strong evidence',
  moderate: 'Moderate evidence',
  emerging: 'Emerging evidence',
  limited: 'Limited evidence',
};
const tier = s.evidence;
const n = tier ? level[tier] : 0;

const fields: { k: string; v: string }[] = [];
if (s.note) fields.push({ k: 'Best for', v: s.note.replace(/^best for:\s*/i, '') });
if (s.sessions) fields.push({ k: 'Sessions', v: s.sessions });
if (s.downtime) fields.push({ k: 'Downtime', v: s.downtime });
if (s.cost) fields.push({ k: 'Cost', v: s.cost });
const subject = s.title.split(/[:(—]/)[0].trim().toLowerCase();
---

<details id={s.id} class="card group scroll-mt-32 border-b border-ink py-4" data-evidence={tier ?? 'none'} open={open}>
  <summary class="chart-row cursor-pointer grid grid-cols-[minmax(0,1fr)_40px] md:grid-cols-[200px_minmax(0,1fr)_44px] gap-x-4 gap-y-2.5 md:gap-x-8 items-start md:items-center min-h-[44px]">
    {/* ── Rating ── */}
    <div class="reading col-start-1 flex flex-col gap-1.5 w-full md:w-[200px]" aria-label={tier ? `${word[tier]}, ${n} out of 4` : 'Information'}>
      <div class="scale grid grid-cols-4 gap-px h-3.5 md:h-4" aria-hidden="true">
        {[1, 2, 3, 4].map((i) => (
          <span class="block h-full bg-bench" style={tier && i <= n ? `background: ${evidenceColor[tier]};` : undefined}></span>
        ))}
      </div>
      <span class="label">{tier ? word[tier] : 'Information'}</span>
    </div>

    {/* ── Title + summary ── */}
    <div class="col-start-1 md:col-start-2 min-w-0">
      <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent transition-colors">{s.title}</h3>
      <p class="hidden md:block mt-1 text-sm text-ink/60 leading-snug truncate">{s.tldr}</p>
    </div>

    <span class="toggle col-start-2 row-start-1 row-span-2 self-start md:col-start-3 md:row-span-1 md:self-center justify-self-end" aria-hidden="true"></span>
  </summary>

  <div class:list={['card-body mt-4 pt-4 border-t border-ink/15 grid gap-8 lg:gap-10 items-start', figure && 'lg:grid-cols-[minmax(0,1fr)_320px]']}>
    <div class="min-w-0">
      <p class="font-display font-medium text-lg md:text-xl leading-snug tracking-tight mb-3.5">{s.tldr}</p>
      <div class="prose-anti" set:html={s.bodyHtml}></div>
      {fields.length > 0 && (
        <dl class="mt-3.5 border-t border-ink/15">
          {fields.map((f) => (
            <div class="grid grid-cols-[100px_minmax(0,1fr)] md:grid-cols-[120px_minmax(0,1fr)] gap-3 md:gap-4 py-2 border-b border-ink/15 text-sm leading-normal">
              <dt class="eyebrow eyebrow--steel pt-0.5">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
    {figure && (
      <div class="lg:w-80 shrink-0">
        {s.image ? (
          <img src={s.image.src} alt={s.image.alt} loading="lazy" class="w-full aspect-[4/5] object-cover" />
        ) : (
          <MediaPlaceholder kind="image" ratio="4/5" label={subject} />
        )}
      </div>
    )}
  </div>
</details>

<style>
  /* The opener: an accent chevron drawn in CSS, pointing up when open. */
  .toggle {
    position: relative;
    width: 40px;
    height: 40px;
    display: block;
    color: var(--color-accent);
    transition: color 0.15s ease, transform 0.2s ease;
  }
  .toggle::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 7px;
    width: 15px;
    height: 15px;
    margin-left: -7.5px;
    border-right: 3px solid currentColor;
    border-bottom: 3px solid currentColor;
    transform: rotate(45deg);
  }
  @media (min-width: 768px) {
    .toggle { width: 44px; height: 44px; }
    .toggle::after { width: 17px; height: 17px; margin-left: -8.5px; }
  }
  summary:hover .toggle { color: var(--color-ink); }
  details[open] > summary .toggle { transform: rotate(180deg); color: var(--color-accent); }
</style>
