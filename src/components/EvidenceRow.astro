---
/**
 * EvidenceRow — one collapsible row in the "what the evidence says" chart.
 *
 * EXPERIMENTAL: two variants of the evidence indicator, so they can be
 * compared. Both cap the indicator to a fixed width (instead of letting it
 * stretch across the whole row) and use the reclaimed space for the section's
 * one-line summary, which was previously hidden until expansion.
 *
 *   variant="bar"  — fixed-width strength bar (longer = stronger) + word
 *   variant="pips" — 4-segment strength meter + word
 */
import MediaPlaceholder from './MediaPlaceholder.astro';
import { evidenceColor, type Evidence } from '../data/evidence';

// Structural shape, so the row works with any data module (collagen, future guides…)
// without coupling to one Section type.
interface EvidenceItem {
  id: string;
  title: string;
  tldr: string;
  evidence?: Evidence;
  bodyHtml: string;
  note?: string;
  sessions?: string;
  downtime?: string;
  cost?: string;
  /** Optional 4:5 photo shown beside the expanded body (needs `mediaTone`). */
  image?: { src: string; alt: string };
}

interface Props {
  s: EvidenceItem;
  variant: 'bar' | 'pips';
  /** Small label tag on the right (e.g. focus area or cause). Pre-resolved. */
  tag?: string;
  /** Show a 4/5 media placeholder in the expanded body. */
  mediaTone?: 'rose' | 'gold';
  /** Render expanded on load (e.g. the row that carries the product pick). */
  open?: boolean;
}
const { s, variant, tag, mediaTone, open = false } = Astro.props;

const evidenceWidth: Record<Evidence, number> = { strong: 100, moderate: 75, emerging: 50, limited: 25 };
const evidenceLevel: Record<Evidence, number> = { strong: 4, moderate: 3, emerging: 2, limited: 1 };

const evidence = s.evidence ?? 'limited';
const hasRating = !!s.evidence;
---

<details id={s.id} class="card group scroll-mt-32 transition" data-evidence={s.evidence ?? 'none'} open={open}>
  <summary class="chart-row cursor-pointer list-none block py-2.5 px-3 -mx-3 border border-transparent hover:border-ink/10 hover:bg-bone/70 transition">
    <div class="flex items-center gap-3">
    <div class="flex-1 min-w-0 md:flex-none md:w-52 text-base md:text-sm font-medium text-ink/85 leading-snug group-hover:text-rose">{s.title}</div>

    {/* ── Evidence indicator ──
         Mobile: a fixed-width block, so weaker ratings don't trail a long
         empty track. Desktop (md+): a four-segment ruled bar, each segment wide
         enough to hold the tier word, which sits in the first one — so the word
         is the unit of the scale, length reads as longer = stronger down the
         sorted list, and every row shows all four segments. */}
    {variant === 'bar' ? (
      <>
        {hasRating ? (
          <span
            class="md:hidden shrink-0 w-24 inline-flex items-center justify-center py-1 text-xs uppercase tracking-widest font-semibold text-white"
            style={`background: ${evidenceColor[evidence]};`}
          >{evidence}</span>
        ) : (
          <span class="md:hidden shrink-0 w-24 inline-flex items-center justify-center py-1 text-xs uppercase tracking-widest font-semibold bg-ink/10 text-ink/50">info</span>
        )}
        <div class:list={['hidden md:block shrink-0 relative w-72 h-5 bg-ink/[0.07]', hasRating && 'scale-track']}>
          {hasRating ? (
            <div
              class="absolute inset-y-0 left-0 flex items-center px-2"
              style={`width: ${evidenceWidth[evidence]}%; background: ${evidenceColor[evidence]};`}
            >
              <span class="text-[10px] uppercase tracking-wider font-semibold text-white whitespace-nowrap">{evidence}</span>
            </div>
          ) : (
            <div class="absolute inset-0 flex items-center px-2">
              <span class="text-[10px] uppercase tracking-wider font-semibold text-ink/45">info</span>
            </div>
          )}
        </div>
      </>
    ) : (
      <div class="shrink-0 md:w-48 flex items-center gap-2">
        {hasRating ? (
          <>
            <span class="flex gap-1" aria-hidden="true">
              {[1, 2, 3, 4].map((i) => (
                <span
                  class="w-2.5 h-2.5"
                  style={`background: ${i <= evidenceLevel[evidence] ? evidenceColor[evidence] : 'rgba(28,25,23,0.12)'};`}
                ></span>
              ))}
            </span>
            <span class="text-[10px] uppercase tracking-widest font-semibold" style={`color: ${evidenceColor[evidence]};`}>{evidence}</span>
          </>
        ) : (
          <span class="text-[10px] uppercase tracking-widest font-semibold text-ink/45">info</span>
        )}
      </div>
    )}

    {/* ── Summary preview, fills the reclaimed space (desktop only) ── */}
    <p class="hidden lg:block flex-1 min-w-0 truncate text-sm text-ink/55 leading-snug">{s.tldr}</p>

    {tag && (
      <span class="hidden lg:inline-flex shrink-0 text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 bg-bone text-ink/60 border border-ink/10 whitespace-nowrap">
        {tag}
      </span>
    )}
    <span class="caret shrink-0 ml-auto w-9 h-9 flex items-center justify-center text-rose bg-rose/10 group-hover:bg-rose group-hover:text-white group-open:bg-rose group-open:text-white transition" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </span>
    </div>
  </summary>

  <div class="card-body px-3 pb-6 pt-3 grid md:grid-cols-[1fr_auto] gap-6 items-start">
    <div class="min-w-0">
      <p class="text-ink/80 text-base leading-relaxed pb-4 mb-4 border-b border-ink/10">{s.tldr}</p>
      {s.note && <p class="-mt-2 mb-4 text-xs text-ink/55 italic">{s.note}</p>}
      <div class="prose-anti text-ink/85" set:html={s.bodyHtml}></div>
      {(s.sessions || s.downtime || s.cost) && (
        <dl class="mt-5 grid grid-cols-3 gap-3 text-xs">
          {s.sessions && (
            <div class="bg-bone/60 p-3">
              <dt class="uppercase tracking-widest text-ink/50 text-[10px]">Sessions</dt>
              <dd class="mt-1 font-medium text-ink/85">{s.sessions}</dd>
            </div>
          )}
          {s.downtime && (
            <div class="bg-bone/60 p-3">
              <dt class="uppercase tracking-widest text-ink/50 text-[10px]">Downtime</dt>
              <dd class="mt-1 font-medium text-ink/85">{s.downtime}</dd>
            </div>
          )}
          {s.cost && (
            <div class="bg-bone/60 p-3">
              <dt class="uppercase tracking-widest text-ink/50 text-[10px]">Cost</dt>
              <dd class="mt-1 font-medium text-ink/85">{s.cost}</dd>
            </div>
          )}
        </dl>
      )}
    </div>
    {mediaTone && (
      <div class="md:w-56 shrink-0">
        {s.image ? (
          <img src={s.image.src} alt={s.image.alt} loading="lazy" class="w-full aspect-[4/5] object-cover" />
        ) : (
          <MediaPlaceholder kind="image" ratio="4/5" label={s.title} tone={mediaTone} />
        )}
      </div>
    )}
  </div>
</details>

<style>
  /* The bar is a ruled scale: a hairline tick at each of the four tiers
     (limited 25 · emerging 50 · moderate 75 · strong 100), drawn over the
     whole track including the fill, so every rating shows all four segments
     and how many are filled. Each segment is wide enough for the tier word,
     which sits inside the first one, so no tick runs through text. Unrated
     rows get the plain track without the scale. */
  .scale-track::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to right,
      transparent 0,
      transparent calc(25% - 1px),
      rgba(26, 20, 16, 0.25) calc(25% - 1px),
      rgba(26, 20, 16, 0.25) 25%
    );
  }
</style>
