---
/**
 * ProductFaq — the shop's own questions, answered with the evidence.
 * Native <details> drawers, content stays in the DOM.
 */
import ExpandableDrawer from './ExpandableDrawer.astro';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props { locale: Locale; faq: { q: string; a: string }[] }
const { locale, faq } = Astro.props;
---
{faq.length > 0 && (
  <section id="faq" class="scroll-mt-32">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <h2 class="font-display text-3xl md:text-4xl">{t(locale, 'product.faq.title')}</h2>
      <div class="mt-8 grid gap-2 max-w-3xl">
        {faq.map((f, i) => (
          <ExpandableDrawer id={`faq-${i + 1}`} title={f.q}>
            <p>{f.a}</p>
          </ExpandableDrawer>
        ))}
      </div>
    </div>
  </section>
)}
