---
/**
 * ProductHowTo — the three steps (a real sequence, so they are numbered) and
 * the timeline of what the trials measured, and when.
 */
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  howTo?: { steps: string[]; timeline: { when: string; what: string }[] };
}
const { locale, howTo } = Astro.props;
---
{howTo && (
  <section id="how-to" class="scroll-mt-32 bg-white border-y border-ink/5">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20 grid lg:grid-cols-2 gap-12 lg:gap-16">
      <div>
        <h2 class="font-display text-3xl md:text-4xl">{t(locale, 'product.howto.title')}</h2>
        <ol class="mt-6 space-y-5">
          {howTo.steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="font-display text-3xl text-rose leading-none w-8 shrink-0">{i + 1}</span>
              <p class="text-ink/80 leading-relaxed pt-1">{s}</p>
            </li>
          ))}
        </ol>
      </div>

      {howTo.timeline.length > 0 && (
        <div>
          <h2 class="font-display text-3xl md:text-4xl">{t(locale, 'product.timeline.title')}</h2>
          <ol class="timeline mt-6 relative border-l border-ink/15 pl-6 space-y-6">
            {howTo.timeline.map((tl) => (
              <li class="relative">
                <span class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 rounded-full bg-sage ring-4 ring-white" aria-hidden="true"></span>
                <p class="text-[11px] uppercase tracking-widest text-sage font-semibold">{tl.when}</p>
                <p class="mt-1 text-sm text-ink/80 leading-relaxed">{tl.what}</p>
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>
  </section>
)}
