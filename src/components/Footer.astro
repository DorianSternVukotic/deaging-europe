---
/**
 * Footer — an ink hairline, three columns on the ground colour, links in the
 * accent, the copyright line in mono.
 */
import { type Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
interface Props { locale: Locale }
const { locale } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-ink">
  <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-7 pb-9 grid md:grid-cols-3 gap-8 text-sm leading-normal text-ink/75">
    <div>
      <p class="wordmark">DeAging Europe</p>
      <p class="mt-2.5">{t(locale, 'footer.tagline')}</p>
    </div>
    <div>
      <p class="eyebrow eyebrow--steel mb-2.5">Disclaimer</p>
      <p>{t(locale, 'footer.disclaimer')}</p>
    </div>
    <div>
      <p class="eyebrow eyebrow--steel mb-2.5">{t(locale, 'nav.contact')}</p>
      <p><a href="mailto:dorian.sternvukotic@gmail.com" class="text-accent hover:text-ink">dorian.sternvukotic@gmail.com</a></p>
      <p class="mt-2"><a href="/contact" class="text-accent hover:text-ink">List your product in Europe</a>. We handle everything.</p>
      <p class="mono mt-4 uppercase">© {year} DeAging Europe. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
</style>
