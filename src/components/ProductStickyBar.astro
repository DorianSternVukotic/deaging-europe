---
/**
 * ProductStickyBar — bottom bar with the price and the buy button, on every
 * width. Slides in once the hero's own button has scrolled out of view; on
 * desktop it also carries the variant pills so a reader can switch packs
 * without scrolling back up.
 */
interface Props {
  price?: string;
  currency: string;
  buyUrl: string;
  cta: string;
  title: string;
  priceLine?: string;
  variants?: { short: string; price: string; url: string }[];
}
const { price, currency, buyUrl, cta, title, priceLine, variants = [] } = Astro.props;
const symbol = currency === 'EUR' ? '€' : `${currency} `;
---
<div id="sticky-buy" class="fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 border-t border-ink/10 bg-white/95 backdrop-blur" aria-hidden="true">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-3 flex items-center gap-4 md:gap-6">
    <div class="min-w-0 flex-1">
      <p class="font-display text-base md:text-xl leading-tight truncate">{title}</p>
      {price && (
        <p class="text-sm text-ink/60 truncate">
          <span class="font-semibold text-ink/80">{symbol}{price}</span>{priceLine && <span class="hidden sm:inline"> · {priceLine}</span>}
        </p>
      )}
    </div>
    {variants.length > 0 && (
      <div class="hidden lg:flex flex-wrap justify-end gap-2 max-w-md">
        {variants.map((v) => (
          <a href={v.url} target="_blank" rel="sponsored noopener" class="rounded-full border border-ink/15 px-3 py-1 text-xs hover:border-rose hover:text-rose transition whitespace-nowrap">
            {v.short} <span class="text-ink/45">· {symbol}{v.price}</span>
          </a>
        ))}
      </div>
    )}
    <a href={buyUrl} target="_blank" rel="sponsored noopener" class="inline-flex items-center gap-2 rounded-full bg-rose px-5 md:px-7 py-3 text-sm md:text-base font-semibold text-bone hover:bg-ink transition whitespace-nowrap">
      {cta}
      <svg class="hidden md:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
    </a>
  </div>
</div>
<div class="h-20" aria-hidden="true"></div>

<script>
  // Show once the hero's own button has scrolled above the viewport; hide
  // again whenever it is back on screen or below it (e.g. after a jump to top).
  const bar = document.getElementById('sticky-buy');
  const cta = document.getElementById('buy-cta');
  if (bar && cta) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const show = cta.getBoundingClientRect().bottom < 0;
      bar.classList.toggle('translate-y-full', !show);
      bar.setAttribute('aria-hidden', show ? 'false' : 'true');
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
