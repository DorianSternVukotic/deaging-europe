---
/**
 * JourneyTimeline — the four-stage client-journey map for clinic pages.
 *
 * A restyle of the pick-card grid: numbered white cards joined by a
 * connecting line (horizontal on desktop, vertical on mobile), so the
 * relationship arc reads as one continuous path rather than four offers.
 */
interface Stage {
  step: number;
  title: string;
  /** One-line essence, always visible under the title. */
  short: string;
  bodyHtml: string;
}

interface Props {
  stages: Stage[];
  class?: string;
}
const { stages, class: className = '' } = Astro.props;
---

<ol class:list={['journey-timeline relative grid gap-4 md:grid-cols-4', className]}>
  {/* Connecting line — shows through the grid gaps behind the white cards. */}
  <div
    class="absolute hidden md:block top-12 left-8 right-8 border-t-2 border-dashed border-rose/30 pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute md:hidden top-8 bottom-8 left-9 border-l-2 border-dashed border-rose/30 pointer-events-none"
    aria-hidden="true"
  ></div>

  {stages.map((st) => (
    <li class="relative bg-white rounded-2xl border border-ink/10 p-6 flex flex-col hover:border-rose/40 hover:shadow-sm transition">
      <span class="font-display text-5xl leading-none text-rose" aria-hidden="true">
        {String(st.step).padStart(2, '0')}
      </span>
      <h3 class="font-display text-2xl leading-tight mt-4">{st.title}</h3>
      <p class="mt-1 text-sm font-medium text-sage">{st.short}</p>
      <div class="mt-3 text-sm text-ink/65 leading-relaxed journey-body" set:html={st.bodyHtml}></div>
    </li>
  ))}
</ol>

<style>
  .journey-body :global(p) {
    margin-block: 0.5em;
  }
  .journey-body :global(p:first-child) {
    margin-top: 0;
  }
  .journey-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .journey-body :global(a) {
    color: var(--color-rose);
    text-decoration: underline;
    text-decoration-color: rgba(184, 130, 109, 0.4);
    text-underline-offset: 2px;
  }
</style>
