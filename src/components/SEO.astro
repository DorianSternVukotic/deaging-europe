---
/**
 * The SEO head: title, description, canonical, hreflang, Open Graph, Twitter,
 * robots and the page's JSON-LD blocks. Rendered by BaseLayout only.
 *
 * `noindex` pages (the 404) get title, description and a noindex robots tag
 * and nothing else — no canonical, no share tags, no schema.
 *
 * Wix's edge appends its own dashboard-derived title/canonical/og tags after
 * these on every page (see CLAUDE.md → Deployment); ours come first.
 */
import { LOCALES, HREFLANG, type Locale, DEFAULT_LOCALE } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import { SITE_NAME, OG_LOCALE, DEFAULT_OG_IMAGE } from '../data/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Path *after* the locale segment (e.g. "products/collagen-max-pro"). */
  path?: string;
  /** Share image (site-relative or absolute); falls back to the default 1200×630. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article' | 'product';
  /** ISO dates, articles only → article:published_time / article:modified_time. */
  published?: string;
  updated?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  locale,
  path = '',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  type = 'website',
  published,
  updated,
  noindex = false,
  jsonLd,
} = Astro.props;
const site = Astro.site ?? new URL('https://deagingeurope.example');
const canonical = new URL(localePath(locale, path), site).toString();
const og = image
  ? { src: new URL(image, site).toString(), width: imageWidth, height: imageHeight, alt: imageAlt }
  : { ...DEFAULT_OG_IMAGE, src: new URL(DEFAULT_OG_IMAGE.src, site).toString() };
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{title}</title>
<meta name="description" content={description} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <Fragment>
    <link rel="canonical" href={canonical} />

    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={HREFLANG[l]} href={new URL(localePath(l, path), site).toString()} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LOCALE, path), site).toString()} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale] ?? locale} />
    <meta property="og:image" content={og.src} />
    {og.width && og.height && (
      <Fragment>
        <meta property="og:image:width" content={String(og.width)} />
        <meta property="og:image:height" content={String(og.height)} />
      </Fragment>
    )}
    {og.alt && <meta property="og:image:alt" content={og.alt} />}
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    {type === 'article' && updated && <meta property="article:modified_time" content={updated} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.src} />
    {og.alt && <meta name="twitter:image:alt" content={og.alt} />}

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />

    {jsonLdArray.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </Fragment>
)}
