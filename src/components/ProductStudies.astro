---
/**
 * ProductStudies — the papers and regulatory opinions behind the actives,
 * each with its evidence tier. Replaces the old "reviewed by" doctor block:
 * the citations are the authority here, not a portrait.
 */
import { evidenceColor, type Evidence } from '../data/evidence';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Study {
  title: string;
  journal: string;
  year: number;
  summary: string;
  url?: string;
  evidence: Evidence;
  tag?: string;
}
interface Props { locale: Locale; studies: Study[]; guideHref: string }
const { locale, studies, guideHref } = Astro.props;
---
{studies.length > 0 && (
  <section id="evidence" class="band scroll-mt-32">
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-16 md:py-20">
      <p class="eyebrow">{t(locale, 'product.studies.eyebrow')}</p>
      <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{t(locale, 'product.studies.title')}</h2>

      <div class="tiles mt-10 md:grid-cols-2">
        {studies.map((s) => (
          <article class="tile">
            <div class="flex items-center justify-between gap-4">
              <p class="mono uppercase text-white/55">{s.journal} · {s.year}</p>
              <span class="text-[10px] uppercase tracking-widest font-semibold whitespace-nowrap" style={`color:${evidenceColor[s.evidence]}`}>
                {t(locale, `product.evidence.${s.evidence}`)}
              </span>
            </div>
            {s.tag && <p class="mt-3 text-xs text-sky">{s.tag}</p>}
            <h3 class="text-xl leading-snug mt-1">{s.title}</h3>
            <p class="mt-3 text-sm text-white/75 leading-relaxed flex-1">{s.summary}</p>
            {s.url && (
              <a href={s.url} target="_blank" rel="noopener nofollow" class="cta mt-4 self-start">
                {t(locale, 'product.readStudy')}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
              </a>
            )}
          </article>
        ))}
      </div>

      <a href={guideHref} class="cta mt-10">
        {t(locale, 'product.guide')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
      </a>
    </div>
  </section>
)}
