---
/**
 * The thin-lips guide (/thin-lips) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video,
 * the three drivers as cards, evidence strength as the primary visual
 * signal, one interactive block (situation matcher) and a month-by-month
 * action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { guideMeta, formatDate } from '../data/guides';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/thin-lips';

const locale = DEFAULT_LOCALE;
const guide = guideMeta('thin-lips');
const title = 'Thinning lips and lost definition — every treatment graded by evidence | DeAging Europe';
const description =
  'The ageing lip lengthens, rolls inward, fades and loses its support more than it shrinks — MRI shows the upper lip growing 2.5 mm while total volume stays the same. The ruler-and-profile self-check that sorts length from volume from contrast, and lip colour, hyaluronic filler, the toxin flip, fat, implants, the lip lift and the dentist graded by trial evidence, with the overfilled lip treated as a problem of its own.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-how-much': '0.5–1 mL, border first',
  'faq-how-long': 'About a year on the scale',
  'faq-filler-vs-lift': 'The ruler decides',
  'faq-lip-flip': 'A millimetre for two months',
  'faq-natural': 'Ratio 1:2, half the syringe',
  'faq-stretch': 'No — but it lingers',
  'faq-dissolve': 'Gel yes, the rest no',
  'faq-lipstick': 'The edge has gone; redraw it',
  'faq-cost-ladder': '€10 to €5,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'My lips look thinner and my upper lip seems to have got longer',
    paths: [
      { id: 'type-length', title: 'The long upper lip', why: 'measure the philtrum and count the teeth showing at rest' },
      { id: 'surg-lip-lift', title: 'The subnasal lip lift', why: 'philtrum shortened 2–3.5 mm and tooth show doubled across 1,754 patients' },
      { id: 'inj-lip-flip', title: 'A lip flip first, as a preview', why: 'two months of eversion for the price of a haircut' },
      { id: 'inj-ha-lips', title: 'A little gel after the lift, not instead', why: '0.5 mL does after what 2 mL could not before' },
    ],
  },
  {
    concern: 'My lipstick bleeds and the edge of my lip has gone',
    paths: [
      { id: 'type-contrast', title: 'Paler lips, a lost border', why: 'contrast falls with age and raters read it as age' },
      { id: 'home-contrast', title: 'Colour and a liner on the border', why: 'raising contrast made faces look younger in three countries' },
      { id: 'home-retinoid-spf', title: 'A retinoid and sunscreen on the skin above', why: 'rebuilds the dermis the ridge sits in' },
      { id: 'inj-ha-border', title: 'A fine gel along the border', why: '0.3–0.5 mL redraws the ridge without volume' },
    ],
  },
  {
    concern: 'I want a subtle, natural refresh, not a duck',
    paths: [
      { id: 'faq-natural', title: 'How the duck is built', why: 'ratio, technique, volume and repetition' },
      { id: 'inj-ha-border', title: 'Border first', why: 'definition without projection' },
      { id: 'inj-ha-lips', title: 'Then 0.5–1 mL in the body, at 9–12 months', why: 'the volumes and intervals the trials used' },
      { id: 'safety-migration-overfill', title: 'Why not every four months', why: 'gel outlasts its label on imaging and layers up' },
    ],
  },
  {
    concern: 'I have had filler and there is a firm shelf above my lip',
    paths: [
      { id: 'type-overfilled', title: 'The migrated, overfilled lip', why: 'most filler sits in muscle; vertical techniques migrate' },
      { id: 'clinic-hyaluronidase-reset', title: 'Dissolve, then wait two months', why: '84% resolve; the natural lip returns over weeks' },
      { id: 'workup', title: 'Then the ruler and the profile', why: 'a plan built on measurements, not the syringe' },
    ],
  },
  {
    concern: 'I want something that lasts more than a year',
    paths: [
      { id: 'surg-lip-lift', title: 'The lip lift, if the lip is long', why: 'permanent, measured, and the only fix for length' },
      { id: 'surg-implants', title: 'Silicone implants, with eyes open', why: 'permanent but reversible; palpable and unforgiving of asymmetry' },
      { id: 'inj-fat', title: 'Fat grafting — and its five-year data', why: 'retention tracks weight gain; satisfaction returned to baseline' },
      { id: 'faq-how-long', title: 'What "a year" of filler actually means', why: '60% still fuller at twelve months' },
    ],
  },
  {
    concern: 'I do not want needles',
    paths: [
      { id: 'home-contrast', title: 'Colour and a liner', why: 'the one needle-free treatment with an experiment' },
      { id: 'home-retinoid-spf', title: 'Retinoid and sunscreen', why: 'the edge, slowly' },
      { id: 'home-topical-ha', title: 'A hyaluronic lip serum', why: 'hydration and shine, measured in fractions of a millimetre' },
      { id: 'home-plumpers', title: 'What the glosses and pumps do', why: 'irritation and bruising, no trials' },
    ],
  },
  {
    concern: 'I have lost teeth or wear a denture and my mouth has collapsed',
    paths: [
      { id: 'type-support', title: 'Lost support behind the lip', why: 'teeth and bone hold the lip forward' },
      { id: 'clinic-dental-support', title: 'A dentist who understands lip support', why: 'dentures closed the nasolabial angle 8°; implants moved the lip 3.4 mm' },
      { id: 'inj-ha-lips', title: 'Gel only after the support is back', why: 'a cosmetic answer to a structural question otherwise' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the ruler, the profile, the teeth and the old photograph',
    when: 'Before anything',
    blurb: 'Philtrum length, tooth show at rest, a profile and a front photograph without colour, the photograph from your thirties; every previous syringe written down; cold-sore history; a dentist if teeth are missing or worn.',
  },
  {
    id: 'home-contrast',
    step: 'Day 1 onward: the contrast and the edge',
    when: 'Whatever else you do',
    blurb: 'A colour a shade redder than your lip and a liner on the border; sunscreen every morning and a retinoid at night on the skin above the lip; the plumping gloss retired; a hyaluronic lip serum if you like the feel.',
  },
  {
    id: 'inj-ha-lips',
    step: 'Month 1–3: the injectable for your type',
    when: 'Judged at four weeks on the profile photograph',
    blurb: 'A fine gel along the border for the lost edge, 0.5–1 mL border-and-body for the flattened lip with a touch-up at four weeks, or a 4-unit lip flip as a two-month preview of eversion; antiviral cover if you get cold sores; dissolving first if there is a shelf.',
  },
  {
    id: 'surg-lip-lift',
    step: 'Month 6 onward: the permanent options, for the right lip',
    when: 'After a year of knowing what you like',
    blurb: 'The lip lift for the long philtrum with no tooth show; the dental prosthesis for the collapsed mouth; implants or fat only with a surgeon who has done hundreds; the gel repeated at nine to twelve months, never four.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="thin-lips" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Thinning lips &amp; lost definition</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Thinning lips, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          The ageing lip lengthens, rolls inward, fades and loses its support more than it shrinks &mdash; MRI shows
          the upper lip growing 2.5 mm while its total volume stays the same, which is why volume alone gives the
          look everyone recognises. Below, the ruler-and-profile self-check that sorts length from volume from
          contrast, every treatment from lip colour to the lip lift graded by the trials behind it, and the overfilled
          lip treated as the problem it has become.
        </p>
        <p class="meta">
          Updated <time datetime={guide.updated}>{formatDate(guide.updated)}</time> · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Thinning lips — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'inj' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="Where the gel goes — the border, the body, and the artery a millimetre away" />
                <MediaPlaceholder kind="image" ratio="16/9" label="The same lip in profile at 25, 55, and after a lift — length, not volume" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'inj-ha-lips',
                    kind: 'For the flattened lip',
                    title: 'Hyaluronic gel, in trial volumes',
                    blurb: 'Sixteen randomised trials: fullness improved in 60%, appearance in 82%; 80–88% responders at two to three months and about 60% at a year. Border first, 0.5–1 mL, repeated at nine to twelve months.',
                  },
                  {
                    id: 'surg-lip-lift',
                    kind: 'For the long lip',
                    title: 'The subnasal lip lift',
                    blurb: 'Philtrum shortened from 14–14.5 mm to 10.8–12 mm, vermilion raised about 2 mm and tooth show doubled across seven studies of 1,754 patients — the only treatment for the change MRI actually finds.',
                  },
                  {
                    id: 'home-contrast',
                    kind: 'For the faded lip',
                    title: 'Colour and a liner',
                    blurb: 'Raising lip-to-skin contrast made the same faces look younger to raters in three countries, and makeup made 40- and 50-year-old women look younger in three experiments. Free, reversible, measured.',
                  },
                  {
                    id: 'clinic-hyaluronidase-reset',
                    kind: 'For the overfilled lip',
                    title: 'Dissolve, then measure',
                    blurb: 'Hyaluronidase resolved 84% of pooled hyaluronic cases; the shelf above the lip and the lost bow both respond, and the natural lip returns over a month — the reset before any new plan.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your lips</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Measure first, restore the contrast, replace only the volume that left, and reach for the permanent options once you know what you like.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, randomised trials, meta-analyses, clinical series or regulatory
            summaries, linked inline within each section. Primary sources: PubMed/PMC, the Aesthetic Surgery Journal,
            Dermatologic Surgery, Plastic and Reconstructive Surgery, the Journal of Plastic, Reconstructive &amp;
            Aesthetic Surgery, JAMA Facial Plastic Surgery, PLOS One, the Journal of Cosmetic Dermatology, the FDA's
            device summaries and the ASPS and ISAPS procedure statistics.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. A lip that goes white, mottled or disproportionately painful after
          an injection is an emergency to be dissolved that afternoon; anyone with cold sores takes antiviral cover
          before lip injections; and calcium hydroxylapatite, poly-L-lactic acid and permanent fillers do not belong
          in a lip.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
