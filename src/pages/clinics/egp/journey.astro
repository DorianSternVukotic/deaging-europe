---
/**
 * Clinic present-page — the in-person, practitioner-facing twin of
 * /clinics/egp. Same four journey stages, same follow-up model (single source
 * of truth in src/data/egp.ts), but rendered as a calm, projector/print-ready
 * walk-through the practitioner shows WITH the client in the room.
 *
 * The public page sets the expectation ("you'll be on a written, year-long
 * plan with follow-ups"); this page is how the clinic delivers it. The two are
 * wired to the same `journeyStages` and `followUpProtocols`, so they cannot
 * drift apart. Internal-facing — linked only from the public journey section.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { clinic, followUpProtocols, allTreatments } from '../../../data/egp';
import { DEFAULT_LOCALE } from '../../../i18n/ui';

const locale = DEFAULT_LOCALE;
const { meta, booking } = clinic;

const title = `The Care Journey — in-person present view | ${meta.name}`;
const description =
  'Practitioner present view: how EGP delivers the year-long care journey the public page promises. The same four stages, with the in-room playbook.';

// id → title, so the follow-up protocols can name the treatments they govern.
const txTitle: Record<string, string> = Object.fromEntries(allTreatments().map((t) => [t.id, t.title]));

// Playbook §1 — the mindset reframe (present-only framing).
const mindsetRows = [
  { hospital: 'The patient presents a problem', aesthetic: 'The client presents a goal' },
  { hospital: 'Success = the problem is resolved', aesthetic: 'Success = years of trust, a face that ages well' },
  { hospital: 'Discharge is the goal', aesthetic: 'Discharge doesn’t exist — the relationship is the product' },
  { hospital: 'An episode of care', aesthetic: 'Continuity of care' },
];

// Playbook §3 — the First-Year Map the client leaves with.
const mapPhases = [
  { phase: 'Phase 1 · Foundation', when: 'Month 0–1', note: 'First treatment, plus the 2-week review — pre-booked on the Map.' },
  { phase: 'Phase 2 · Build', when: 'Months 2–4', note: 'The core of the plan; every interval gets its biological “why”.' },
  { phase: 'Phase 3 · Rhythm', when: 'Months 5–11', note: 'Maintenance scheduled by biology, not demand.' },
  { phase: 'Month 12 · The annual edit', when: 'Month 12', note: 'Full reassessment with photos. Keep what earned its place.' },
];

// Playbook §10 — compliance non-negotiables (condensed).
const compliancePoints = [
  'Never name a POM in public — no toxin brand names anywhere. Public framing is always “consultation for lines and wrinkles” (Reg 284 HMR 2012; CAP 12.12).',
  'No remote prescribing, ever — face-to-face assessment before any prescription-only medicine.',
  'No before/after of toxin results in public; signed, dated, unmanipulated consent on file before any case photo is published (CAP 3.45–3.50).',
  'No urgency mechanics, no fear appeals, never “risk-free”. Under-18s: no cosmetic injectables.',
  'Substantiate or shelve “award-winning”, “1000+ treatments”, “100% satisfaction”.',
];

const stages = clinic.journeyStages;
const nonPomProtocols = followUpProtocols.filter((p) => !p.pom);
const pomProtocols = followUpProtocols.filter((p) => p.pom);
---

<BaseLayout title={title} description={description} locale={locale} path={`clinics/${clinic.slug}/journey`}>
  <article class="bg-bone text-ink">
    <div class="max-w-5xl mx-auto px-6 py-10 md:py-16">

      <!-- ════════ HEADER ════════ -->
      <header class="border-b border-ink/10 pb-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <p class="text-xs uppercase tracking-[0.35em] text-sage">Practitioner present view · Internal</p>
          <div class="no-print flex items-center gap-3 text-xs">
            <a href="/clinics/egp" class="text-ink/55 hover:text-rose transition">← The public page</a>
            <button
              type="button"
              data-print
              class="px-3 py-1.5 rounded-full border border-ink/20 font-medium hover:border-rose hover:text-rose transition"
            >Print / PDF</button>
          </div>
        </div>
        <h1 class="font-display text-4xl md:text-6xl mt-5 leading-[1.04] max-w-3xl">
          One treatment is the start. A year is the relationship<span class="text-rose">.</span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg text-ink/75 leading-relaxed">
          This is how we deliver the journey the website promises. Walk the client through it in the room — the
          <strong>same four stages</strong> they saw online, now with what to say and do at each one.
        </p>
        <p class="mt-4 max-w-2xl text-sm text-ink/55 border-l-2 border-rose/40 pl-4">
          Public page → sets the expectation. This page → keeps it. They draw on one shared journey model, so they always match.
        </p>
      </header>

      <!-- ════════ MINDSET REFRAME (§1) ════════ -->
      <section class="mt-12 break-inside-avoid">
        <p class="text-xs uppercase tracking-[0.3em] text-sage">Before you start · the reframe</p>
        <h2 class="font-display text-3xl md:text-4xl mt-2">Hospital medicine discharges. Aesthetic medicine cultivates.</h2>
        <div class="mt-6 grid sm:grid-cols-2 gap-px bg-ink/10 rounded-2xl overflow-hidden border border-ink/10">
          <div class="bg-bone px-5 py-3 text-[11px] uppercase tracking-widest font-semibold text-ink/50">Hospital instinct</div>
          <div class="bg-bone px-5 py-3 text-[11px] uppercase tracking-widest font-semibold text-rose">Aesthetic reality</div>
          {mindsetRows.map((r) => (
            <>
              <div class="bg-white px-5 py-3 text-sm text-ink/70">{r.hospital}</div>
              <div class="bg-white px-5 py-3 text-sm text-ink/90 font-medium">{r.aesthetic}</div>
            </>
          ))}
        </div>
        <p class="mt-5 font-display text-2xl md:text-3xl text-ink/90 max-w-3xl">
          The whole flip is one question: not <span class="text-ink/50">“What is wrong?”</span> but <span class="text-rose">“What do you want?”</span>
        </p>
      </section>

      <!-- ════════ THE FOUR STAGES ════════ -->
      <section class="mt-14">
        <p class="text-xs uppercase tracking-[0.3em] text-sage">The journey · four stages</p>
        <h2 class="font-display text-3xl md:text-4xl mt-2">What the client sees · what you do</h2>

        <ol class="mt-8 space-y-5">
          {stages.map((st) => (
            <li class="bg-white rounded-2xl border border-ink/10 overflow-hidden break-inside-avoid">
              <div class="grid md:grid-cols-[1fr_1.5fr]">

                {/* LEFT — what the client sees (the public side) */}
                <div class="bg-bone/50 p-6 md:p-7 border-b md:border-b-0 md:border-r border-ink/10">
                  <span class="font-display text-5xl leading-none text-rose">{String(st.step).padStart(2, '0')}</span>
                  <h3 class="font-display text-2xl mt-3">{st.title}</h3>
                  <p class="mt-1 text-sm font-medium text-sage">{st.short}</p>
                  <p class="mt-4 text-[11px] uppercase tracking-widest font-semibold text-ink/40">The client sees</p>
                  <div class="mt-1.5 text-sm text-ink/70 leading-relaxed present-body" set:html={st.bodyHtml}></div>
                </div>

                {/* RIGHT — how you deliver it (the practitioner side) */}
                {st.practitioner && (
                  <div class="p-6 md:p-7">
                    <div class="flex items-start justify-between gap-3">
                      <p class="text-[11px] uppercase tracking-widest font-semibold text-rose">You deliver</p>
                      <span class="shrink-0 text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 rounded-full bg-ink/[0.06] text-ink/50">Playbook {st.practitioner.playbookRef}</span>
                    </div>
                    <p class="mt-2 text-[15px] text-ink/85 leading-relaxed">{st.practitioner.goal}</p>

                    <div class="mt-5 grid sm:grid-cols-2 gap-5">
                      <div>
                        <p class="text-[11px] uppercase tracking-widest font-semibold text-ink/45">Say</p>
                        <ul class="mt-2 space-y-2">
                          {st.practitioner.say.map((s) => (
                            <li class="text-sm text-ink/80 leading-snug border-l-2 border-rose/30 pl-3 italic">{s}</li>
                          ))}
                        </ul>
                      </div>
                      <div>
                        <p class="text-[11px] uppercase tracking-widest font-semibold text-ink/45">Do</p>
                        <ul class="mt-2 space-y-1.5">
                          {st.practitioner.do.map((d) => (
                            <li class="text-sm text-ink/80 leading-snug flex gap-2">
                              <span class="text-sage shrink-0">✓</span><span>{d}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    <div class="mt-5 grid sm:grid-cols-2 gap-3">
                      <div class="rounded-xl bg-rose/[0.06] border border-rose/15 p-3.5">
                        <p class="text-[10px] uppercase tracking-widest font-semibold text-rose">Sets up the next visit</p>
                        <p class="mt-1 text-sm text-ink/80 leading-snug">{st.practitioner.followUpTrigger}</p>
                      </div>
                      <div class="rounded-xl bg-ink/[0.04] border border-ink/10 p-3.5">
                        <p class="text-[10px] uppercase tracking-widest font-semibold text-ink/45">Watch out</p>
                        <p class="mt-1 text-sm text-ink/70 leading-snug">{st.practitioner.watchOut}</p>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ════════ THE FOLLOW-UP ENGINE (§4/§9) ════════ -->
      <section class="mt-14">
        <p class="text-xs uppercase tracking-[0.3em] text-sage">Stage 03, in detail · the follow-up engine</p>
        <h2 class="font-display text-3xl md:text-4xl mt-2">Every treatment names its own next visit</h2>
        <p class="mt-3 text-ink/70 max-w-2xl">
          This is the connective tissue. Each class has a biological rhythm; the client already saw the short version
          (“<span class="text-sage font-medium">Then · …</span>”) on the menu. Here is the full chain, and the line to say.
        </p>

        <div class="mt-8 grid md:grid-cols-2 gap-5">
          {nonPomProtocols.map((p) => (
            <div class="bg-white rounded-2xl border border-ink/10 p-6 break-inside-avoid flex flex-col">
              <h3 class="font-display text-xl leading-tight">{p.label}</h3>

              <ol class="mt-4 flex flex-wrap items-stretch gap-2">
                {p.chain.map((c, i) => (
                  <li class="flex items-center gap-2">
                    <div class="rounded-lg bg-bone/70 border border-ink/[0.07] px-3 py-2 min-w-max">
                      <p class="text-[10px] uppercase tracking-wider font-semibold text-sage">{c.when}</p>
                      <p class="text-xs text-ink/80 leading-snug">{c.what}</p>
                    </div>
                    {i < p.chain.length - 1 && <span class="text-ink/25 text-sm" aria-hidden="true">→</span>}
                  </li>
                ))}
              </ol>

              <p class="mt-4 text-sm text-ink/80 leading-snug border-l-2 border-rose/30 pl-3 italic">{p.sentence}</p>

              <div class="mt-4 pt-3 border-t border-ink/[0.07] flex flex-wrap gap-1.5">
                {p.appliesTo.map((id) => (
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-ink/[0.05] text-ink/55">{txTitle[id] ?? id}</span>
                ))}
              </div>
            </div>
          ))}
        </div>

        {pomProtocols.length > 0 && (
          <div class="mt-5 rounded-2xl border border-dashed border-ink/20 bg-ink/[0.02] p-6 break-inside-avoid">
            <p class="text-[11px] uppercase tracking-widest font-semibold text-ink/50">Prescription-only — consultation path only</p>
            <p class="mt-2 text-sm text-ink/70 max-w-2xl">
              These never get an interval, price or booking link in public — the website keeps them consultation-only and so does this view.
            </p>
            <ul class="mt-4 grid sm:grid-cols-2 gap-3">
              {pomProtocols.map((p) => (
                <li class="rounded-xl bg-white border border-ink/10 p-4">
                  <p class="font-medium text-ink/85 text-sm">{p.label}</p>
                  <p class="mt-1 text-sm text-ink/65 leading-snug">{p.sentence}</p>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {p.appliesTo.map((id) => (
                      <span class="text-[10px] px-2 py-0.5 rounded-full bg-ink/[0.05] text-ink/55">{txTitle[id] ?? id}</span>
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <!-- ════════ THE FIRST-YEAR MAP (§3) ════════ -->
      <section class="mt-14 break-inside-avoid">
        <p class="text-xs uppercase tracking-[0.3em] text-sage">The leave-behind · §3</p>
        <h2 class="font-display text-3xl md:text-4xl mt-2">Every consultation ends with this on paper</h2>
        <p class="mt-3 text-ink/70 max-w-2xl">
          The written First-Year Map is the single most powerful retention instrument — and the medico-legal plan record.
          The website now promises it, so every client must actually receive one.
        </p>
        <div class="mt-6 rounded-2xl border border-ink/10 bg-white overflow-hidden">
          <div class="bg-ink text-bone px-6 py-4 flex flex-wrap items-baseline justify-between gap-2">
            <span class="font-display text-xl">EGP Aesthetics — First-Year Map</span>
            <span class="text-xs text-bone/60">Goal, in the client’s own words · written by Eli / Galina</span>
          </div>
          <ol class="divide-y divide-ink/[0.07]">
            {mapPhases.map((m) => (
              <li class="px-6 py-4 grid grid-cols-[auto_1fr] gap-4 items-baseline">
                <span class="text-[11px] uppercase tracking-wider font-semibold text-sage w-28">{m.when}</span>
                <span>
                  <span class="font-medium text-ink/85">{m.phase}</span>
                  <span class="block text-sm text-ink/65 leading-snug mt-0.5">{m.note}</span>
                </span>
              </li>
            ))}
          </ol>
          <p class="px-6 py-3 text-xs text-ink/50 italic border-t border-ink/[0.07]">
            Optional items are labelled “enhancements, not corrections”. Indicative year total may be edited <em>down</em>.
          </p>
        </div>
      </section>

      <!-- ════════ COMPLIANCE ONE-PAGER (§10) ════════ -->
      <section class="mt-14 break-inside-avoid">
        <p class="text-xs uppercase tracking-[0.3em] text-sage">Whole team · §10</p>
        <h2 class="font-display text-3xl md:text-4xl mt-2">Retention never tips into a breach</h2>
        <ul class="mt-6 grid gap-2.5">
          {compliancePoints.map((c) => (
            <li class="flex gap-3 text-sm text-ink/75 leading-snug bg-white rounded-xl border border-ink/10 p-4">
              <span class="text-rose shrink-0">●</span><span>{c}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- ════════ FOOTER ════════ -->
      <footer class="mt-14 pt-8 border-t border-ink/10">
        <p class="text-sm text-ink/60 max-w-2xl">
          This present view pairs with the public clinic page at
          <a href="/clinics/egp" class="text-rose underline decoration-rose/40 underline-offset-2 hover:decoration-rose">/clinics/egp</a>.
          The website sets the expectation; this is how the room delivers it. Internal document — not for publication.
        </p>
        <div class="no-print mt-5 flex flex-wrap gap-3">
          <a
            href={booking.consultation}
            target="_blank"
            rel="noopener nofollow"
            class="px-5 py-2.5 rounded-full bg-rose text-bone text-sm font-medium hover:bg-rose/90 transition"
          >Open Fresha</a>
          <a href="/clinics/egp" class="px-5 py-2.5 rounded-full border border-ink/20 text-sm font-medium hover:border-rose hover:text-rose transition">Back to the public page</a>
        </div>
      </footer>
    </div>
  </article>

  <style>
    .present-body :global(p) { margin-block: 0.4em; }
    .present-body :global(p:first-child) { margin-top: 0; }
    .present-body :global(strong) { color: var(--color-ink); font-weight: 600; }

    @media print {
      :global(body > header), :global(body > footer), .no-print { display: none !important; }
      article { background: white !important; }
      section, li, .break-inside-avoid { break-inside: avoid; }
      h1 { font-size: 2.5rem !important; }
    }
  </style>

  <script is:inline>
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>
