---
/**
 * The biostimulator guide (/regenerative-aesthetics) — in-clinic layout:
 * evidence strength as the primary visual signal, all content in the DOM,
 * one interactive block (concern matcher), and the injectables compared as
 * cards. The path is kept because 35 guides link here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { guideMeta, formatDate } from '../data/guides';
import {
  keyTakeaways,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/regenerative-aesthetics';

const locale = DEFAULT_LOCALE;
const guide = guideMeta('regenerative-aesthetics');
const title = 'Biostimulators & regenerative injectables — every product graded | DeAging Europe';
const description =
  'Sculptra, Radiesse, Ellansé, Profhilo and the HA boosters, polynucleotides, PRP and PRF, nanofat, exosomes and "stem cells" graded on their own trials — what each can do, how long it lasts, what it costs in Europe, which are CE-marked devices and which have no licence at all, and the nodule, vascular and hygiene risks the consult skips.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const evidencePillClass = (e?: Evidence) =>
  e === 'strong'
    ? 'tier-pill tier-strong'
    : e === 'moderate'
    ? 'tier-pill tier-moderate'
    : e === 'emerging'
    ? 'tier-pill tier-emerging'
    : 'tier-pill tier-none';

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

// Bottom-line answer shown in the collapsed FAQ card.
const faqAnswer: Record<string, string> = {
  'faq-longest': 'PCL, then PLLA, then CaHA',
  'faq-sessions': '2–3; judge at 3–6 months',
  'faq-sculptra-vs-radiesse': 'Diffuse vs contour',
  'faq-profhilo': 'For glow, yes; for lift, no',
  'faq-under-eye': 'Neither beat placebo',
  'faq-exosomes-legal': 'Topical only',
  'faq-replace-filler': 'Sometimes; not reversibly',
  'faq-cost': '€250–5,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — concern → recommended rows (anchors must exist in data).
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'Hollow temples or flattened cheeks',
    paths: [
      { id: 'use-folds-volume', title: 'Volume with a biostimulator', why: '97% of temples improved against none untreated; cheek wrinkles 72% against 26% at a year' },
      { id: 'prod-plla', title: 'Poly-L-lactic acid', why: 'the best-trialled biostimulator — slow, diffuse, two years' },
      { id: 'faq-replace-filler', title: 'Or filler?', why: 'HA where shape and reversibility matter' },
    ],
  },
  {
    concern: 'A softening jawline and chin',
    paths: [
      { id: 'prod-caha', title: 'Calcium hydroxylapatite', why: 'contour with immediate effect, a jawline consensus protocol and three-year safety data' },
      { id: 'use-laxity', title: 'The "tightening" claim', why: 'hyperdiluted use has guidelines, not randomised trials' },
      { id: 'safety-vascular', title: 'Not dissolvable', why: 'why the injector matters more with CaHA than with HA' },
    ],
  },
  {
    concern: 'Crepey neck or chest',
    paths: [
      { id: 'use-neck-decolletage', title: 'Neck and décolletage', why: 'the first randomised trial of diluted CaHA on the chest: 73.5% responders' },
      { id: 'safety-nodules', title: 'Nodules', why: 'the neck is where superficial PLLA caused them' },
    ],
  },
  {
    concern: 'Dull, dehydrated skin — I want "glow"',
    paths: [
      { id: 'use-skin-quality', title: 'Skin quality, measured', why: 'firmness, hydration and pores on instruments for about six months; one sham-controlled trial found nothing' },
      { id: 'prod-ha-boosters', title: 'HA boosters and Profhilo', why: 'the safest product in the guide — 0.034% adverse events in a million patients' },
      { id: 'prod-pn', title: 'Polynucleotides', why: 'the fashionable alternative, graded honestly' },
    ],
  },
  {
    concern: 'Veiny, bony hands',
    paths: [
      { id: 'use-hands', title: 'Hands', why: '75% improved at three months in a randomised blinded trial, holding to twelve' },
      { id: 'prod-caha', title: 'Calcium hydroxylapatite', why: 'the only filler licensed for hands in the US' },
    ],
  },
  {
    concern: 'Thinning hair',
    paths: [
      { id: 'use-hair', title: 'PRP for pattern hair loss', why: 'about 26–28 extra hairs per cm² in meta-analyses; add it to minoxidil, do not replace it' },
      { id: 'prod-prp', title: 'What is in the syringe', why: 'platelet dose varies more than twofold between kits' },
    ],
  },
  {
    concern: 'Acne scars',
    paths: [
      { id: 'use-acne-scars', title: 'Microneedling with PRP', why: 'three times the odds of a large improvement over microneedling alone' },
    ],
  },
  {
    concern: 'Tired under-eyes',
    paths: [
      { id: 'use-under-eye', title: 'PRP, PRF and polynucleotides under the eye', why: 'nothing has beaten placebo; sort hollow from pigment from crepe first' },
      { id: 'faq-under-eye', title: 'Which, if any', why: 'PRP is cheaper and yours; polynucleotides equalled an HA filler' },
    ],
  },
  {
    concern: 'I was offered exosomes or a "stem-cell" treatment',
    paths: [
      { id: 'prod-exosomes', title: 'Exosomes', why: 'no authorised product anywhere; trials of 3–60 people; the vial is unverified' },
      { id: 'prod-stem-cells', title: '"Stem-cell" injections', why: 'three women blinded at one clinic; walk away' },
      { id: 'safety-biologics', title: 'Ask for the licence number', why: 'there is none — that ends the conversation' },
    ],
  },
];

// The injectables compared, as cards.
const productRows = [
  {
    id: 'prod-plla',
    brand: 'Poly-L-lactic acid (Sculptra)',
    evidence: 'strong' as Evidence,
    blurb: 'Randomised against human collagen with 25-month follow-up; cheek wrinkles 72% vs 26% and temples 97% vs 0% against no treatment. Diffuse volume over months, two years of result, nodules if placed badly. CE and FDA.',
    knownFor: 'Temples, cheeks, body; the reference',
  },
  {
    id: 'prod-caha',
    brand: 'Calcium hydroxylapatite (Radiesse)',
    evidence: 'strong' as Evidence,
    blurb: 'Immediate contour plus stimulation; three-year follow-up without nodules; a randomised hand trial; non-inferior to Restylane in 2025. The diluted "tightening" use is off-label and largely untrialled. Not dissolvable.',
    knownFor: 'Jawline, chin, hands',
  },
  {
    id: 'prod-pcl',
    brand: 'Polycaprolactone (Ellansé)',
    evidence: 'moderate' as Evidence,
    blurb: 'The longest-lasting microsphere: 89% vs 24% at twelve months in its randomised trial, safety to 30 months, and a 2025 comparison beating PLLA. Fewer trials, CE only, hardest to undo.',
    knownFor: 'Longevity; experienced hands',
  },
  {
    id: 'prod-ha-boosters',
    brand: 'HA boosters (Profhilo, Skinboosters, Revive, Volite)',
    evidence: 'moderate' as Evidence,
    blurb: 'Instrument-measured hydration and firmness for about six months in small, manufacturer-run studies; one sham-controlled trial negative; 0.034% adverse events across a million Profhilo patients.',
    knownFor: 'Glow and hydration; safest',
  },
  {
    id: 'prod-pn',
    brand: 'Polynucleotides (Rejuran, Plinest, Nucleofill)',
    evidence: 'emerging' as Evidence,
    blurb: 'Salmon-DNA fragments as CE-marked devices; nine studies of 219 patients; equalled an HA filler rather than beating it in the phase 3 trial; no placebo-controlled trial. The 2026 boom, on a 2014 evidence base.',
    knownFor: 'Under-eyes and crepe; fashionable',
  },
  {
    id: 'prod-prp',
    brand: 'PRP and PRF (your own blood)',
    evidence: 'moderate' as Evidence,
    blurb: 'Meta-analyses for hair (+26–28 hairs/cm²) and acne scars (OR 2.97 with microneedling); thicker, firmer facial skin in most studies, fewer wrinkles in 40%. Unstandardised kits; the risk is hygiene. PRF: same uses, thinner file.',
    knownFor: 'Hair, scars, texture; cheapest',
  },
  {
    id: 'prod-nanofat',
    brand: 'Nanofat (your own fat, emulsified)',
    evidence: 'emerging' as Evidence,
    blurb: 'Liposuctioned fat processed to its stromal cells and injected for skin quality — a surgeon\'s series showing improvement at six months, reviews asking for controlled data. Surgery, not a facial.',
    knownFor: 'An adjunct to fat grafting or a lift',
  },
  {
    id: 'prod-exosomes',
    brand: 'Exosomes',
    evidence: 'limited' as Evidence,
    blurb: 'No authorised product anywhere, an FDA safety notification, trials of 3–60 people, and retail vials unlike the laboratory exosomes those trials used. One split-face study matched PRP. Topical-only legality. Skip.',
    knownFor: 'The unverified add-on',
  },
  {
    id: 'prod-stem-cells',
    brand: '"Stem-cell" injections',
    evidence: 'limited' as Evidence,
    blurb: 'Unapproved biologics with documented catastrophes — three women blinded at one clinic — and no cosmetic-benefit trial. In the EU a cell therapy needs central authorisation that none of these has.',
    knownFor: 'Walk away',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="regenerative-aesthetics" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-14 md:py-20 grid lg:grid-cols-[1fr_auto] gap-10 items-center">
        <div>
          <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
            Biostimulators, PRP to Sculptra.
          </h1>
          <p class="mt-6 max-w-2xl text-lg md:text-xl text-ink/75 leading-relaxed">
            Collagen stimulators, boosters, polynucleotides, your own blood and fat, and the biologics with no
            licence &mdash; every regenerative injectable graded on its own trials, what each can do, how long it
            lasts, and which of them the law actually allows.
          </p>
          <p class="meta">
            Updated <time datetime={guide.updated}>{formatDate(guide.updated)}</time> · ~{readingMinutes} min full read · {allSections().length} sections
          </p>
        </div>
        <MediaPlaceholder kind="image" ratio="4/5" label="Hero — vials on a tray" class="w-full lg:w-72" />
      </div>
    </header>

    <!-- ════════════ TOP-FOLD SUMMARY + INFO DRAWERS ════════════ -->
    <section id="takeaways" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-10">
      <div>
        <p class="eyebrow">The case in five lines</p>
        <h2 class="text-3xl mt-2">If you read nothing else</h2>
        <ol class="mt-5 space-y-3 text-[15px] leading-relaxed text-ink/85 max-w-3xl">
          {keyTakeaways.map((k, i) => (
            <li class="flex gap-3">
              <span class="font-display text-accent w-6 shrink-0">{i + 1}.</span>
              <span>{k}</span>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <MediaPlaceholder kind="video" ratio="16/9" label="Explainer · 2 min" />
      </div>

      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          <div class="mt-6 grid">
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Regenerative injectables — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'uses' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="A PLLA session: reconstitution, fanning, massage" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Biopsy pair: microspheres at month 4 and the collagen around them at month 9" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'uses'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">Where the trials, the duration and the safety margins line up best.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'prod-plla',
                    kind: 'Best evidence',
                    title: 'PLLA for temples and cheeks',
                    blurb: 'The one biostimulator with randomised, controlled, two-year data: temples 97% improved against none untreated, cheek wrinkles 72% against 26% at a year, folds better than collagen through month 25. Slow, diffuse, and worth the three-month wait.',
                  },
                  {
                    id: 'use-hands',
                    kind: 'Most under-rated',
                    title: 'CaHA for the hands',
                    blurb: 'Three-quarters of hands a grade better at three months in a blinded randomised trial, holding through twelve, with no loss of hand function — the body indication with a licence behind it, for the part of you that gives away your age first.',
                  },
                  {
                    id: 'prod-ha-boosters',
                    kind: 'Safest for glow',
                    title: 'An HA booster, eyes open',
                    blurb: 'Measurable hydration and firmness for about six months, 371 adverse events across a projected million Profhilo patients, and no foreign body that outstays its welcome. Photograph it in the same light before and after, because the sham-controlled trial saw nothing.',
                  },
                  {
                    id: 'use-acne-scars',
                    kind: 'PRP where it earns its keep',
                    title: 'Microneedling with PRP for scars',
                    blurb: 'Fourteen studies and 472 patients: three times the odds of a more-than-50% scar improvement over microneedling alone, from your own blood, with no extra severe side effects. The science behind the "vampire facial", without the trademark.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PRODUCTS / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ CONCERN MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">Match an injectable to your concern</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open your main concern to see where the evidence points &mdash; each link jumps to the graded section.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p) => (
                    <a href={`#${p.id}`} class="block p-3 bg-bone/50 border border-ink/5 hover:border-accent/40 transition">
                      <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                      <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE INJECTABLES COMPARED ════════════ -->
        <section id="compare" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The product landscape</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">The injectables compared</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">Nine things sold as regenerative, from the microspheres with two-year randomised data to the biologics with no licence. Each card is graded on its own evidence, not on the class&rsquo;s claims.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-3">
            {productRows.map((r) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class={`text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 ${evidencePillClass(r.evidence)}`}>{r.evidence}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.brand}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
                <p class="mt-3 text-xs font-medium text-ink/85">Known for: {r.knownFor}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="font-display text-3xl">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed randomised trials, systematic reviews, meta-analyses, biopsy studies,
            post-marketing safety reports or regulator notices, linked inline within each section. Primary sources:
            PubMed/PMC, Dermatologic Surgery, the Aesthetic Surgery Journal, Aesthetic Plastic Surgery, JAAD, the
            Journal of Drugs in Dermatology, the Journal of Cosmetic Dermatology, the New England Journal of Medicine,
            CDC MMWR and the US FDA.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Every injectable here is a medical procedure &mdash; consult a
          registered clinician, disclose your full medical history, and defer treatment during pregnancy or
          breastfeeding. Product names are examples, not endorsements; regulatory status varies by country and is
          stated as of September 2026. Prices are indicative private rates, not quotes.
        </p>
    </div>

  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
