---
/**
 * The regenerative-aesthetics guide (/regenerative-aesthetics) — collagen-guide
 * layout: evidence strength as the primary visual signal, one interactive
 * block (concern matcher).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { guideMeta, formatDate } from '../data/guides';
import {
  keyTakeaways,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/regenerative-aesthetics';

const locale = DEFAULT_LOCALE;
const guide = guideMeta('regenerative-aesthetics');
const title = 'PRP, exosomes & regenerative aesthetics | DeAging Europe';
const description =
  'PRP, PRF, exosomes, polynucleotides and "stem-cell" treatments graded by evidence and by regulation — what works, what\'s fashionable, and what to walk away from.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const evidencePillClass = (e?: Evidence) =>
  e === 'strong'
    ? 'tier-pill tier-strong'
    : e === 'moderate'
    ? 'tier-pill tier-moderate'
    : e === 'emerging'
    ? 'tier-pill tier-emerging'
    : 'tier-pill tier-none';

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-hair': 'Modestly',
  'faq-vampire': 'For scars, yes',
  'faq-exosomes-legal': 'Topical only',
  'faq-pn-vs-prp': 'Neither proven',
  'faq-prf-upgrade': 'No',
  'faq-variance': 'Kit lottery',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — concern → recommended rows.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'Thinning hair',
    paths: [{ id: 'prp-hair', title: 'PRP for pattern hair loss', why: 'the best-evidenced use — three monthly sessions, kept up with minoxidil' }],
  },
  {
    concern: 'Acne scars',
    paths: [{ id: 'prp-scars', title: 'Microneedling + PRP', why: 'the combination triples the odds of a big improvement' }],
  },
  {
    concern: 'Dull, tired-looking skin',
    paths: [
      { id: 'prp-face', title: 'PRP facial', why: 'glow and texture over 2–3 sessions — honest expectations required' },
      { id: 'frontier-nctf', title: 'Mesotherapy cocktails', why: 'pleasant hydration; the trial couldn\'t separate cocktail from needling' },
    ],
  },
  {
    concern: 'Dark circles / under-eyes',
    paths: [
      { id: 'prp-eyes', title: 'PRP under-eye', why: 'best signal for pigment-type circles — no placebo-controlled proof' },
      { id: 'frontier-pn', title: 'Polynucleotides', why: 'the fashionable option, graded honestly' },
    ],
  },
  {
    concern: 'I was offered exosomes',
    paths: [{ id: 'frontier-exosomes', title: 'Exosomes', why: 'no approved product anywhere — read this before paying the add-on' }],
  },
  {
    concern: 'I was offered a "stem-cell" treatment',
    paths: [{ id: 'frontier-stem-cells', title: '"Stem-cell" injections', why: 'documented catastrophic harms and no cosmetic-benefit trials — walk away' }],
  },
];

// Modality comparison cards.
const modalityRows = [
  {
    id: 'prp-hair',
    name: 'PRP',
    evidence: 'moderate' as Evidence,
    blurb: 'Your own platelets — the real evidence base: hair density, scar-combo, facial glow.',
    price: '€250–600/session',
  },
  {
    id: 'prf',
    name: 'PRF / i-PRF',
    evidence: 'emerging' as Evidence,
    blurb: 'Slower-release variant with fewer, smaller studies — no shown superiority over PRP.',
    price: '€300–650/session',
  },
  {
    id: 'frontier-pn',
    name: 'Polynucleotides',
    evidence: 'emerging' as Evidence,
    blurb: 'Salmon-DNA boosters riding a trend — small industry-adjacent trials, device-route regulation.',
    price: '€350–1,000/session',
  },
  {
    id: 'frontier-exosomes',
    name: 'Exosomes',
    evidence: 'limited' as Evidence,
    blurb: 'Zero approved products, FDA warning on record, topical-only legality. Skip.',
    price: '€200–600 add-on',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="regenerative-aesthetics" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-14 md:py-20 grid lg:grid-cols-[1fr_auto] gap-10 items-center">
        <div>
          <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
            Regenerative, regulated.
          </h1>
          <p class="mt-6 max-w-2xl text-lg md:text-xl text-ink/75 leading-relaxed">
            PRP, PRF, exosomes and polynucleotides &mdash; graded by what trials show and what
            regulators allow.
          </p>
          <p class="meta">
            Updated <time datetime={guide.updated}>{formatDate(guide.updated)}</time> · ~{readingMinutes} min full read · {allSections().length} sections
          </p>
        </div>
        <MediaPlaceholder kind="image" ratio="4/5" label="Hero — centrifuge still" class="w-full lg:w-72" />
      </div>
    </header>

    <!-- ════════════ TOP-FOLD SUMMARY + INFO DRAWERS ════════════ -->
    <section id="takeaways" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-10">
      <div>
        <p class="eyebrow">The case in five lines</p>
        <h2 class="text-3xl mt-2">If you read nothing else</h2>
        <ol class="mt-5 space-y-3 text-[15px] leading-relaxed text-ink/85 max-w-3xl">
          {keyTakeaways.map((k, i) => (
            <li class="flex gap-3">
              <span class="font-display text-accent w-6 shrink-0">{i + 1}.</span>
              <span>{k}</span>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <MediaPlaceholder kind="video" ratio="16/9" label="Explainer · 2 min" />
      </div>

      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          <div class="mt-6 grid">
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Regenerative aesthetics — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'prp' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="From blood draw to injection" />
                <MediaPlaceholder kind="image" ratio="16/9" label="PRP kit comparison" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'prp'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">Where the platelets actually earn their fee.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'prp-scars',
                    kind: 'Best combo',
                    title: 'Microneedling + PRP',
                    blurb: 'For acne scars — the one facial use with meta-analytic muscle.',
                  },
                  {
                    id: 'prp-hair',
                    kind: 'For hair',
                    title: 'PRP + minoxidil',
                    blurb: 'Three monthly sessions on top of the licensed drugs beats either alone.',
                  },
                  {
                    id: 'prp-face',
                    kind: 'The glow',
                    title: 'A PRP facial course',
                    blurb: 'Texture and radiance from your own biology — expectations calibrated.',
                  },
                  {
                    id: 'frontier-pn',
                    kind: 'The trend, graded',
                    title: 'Polynucleotides',
                    blurb: 'If you must try the fashion — read the evidence tier before the price list.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / MODALITIES / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ CONCERN MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a treatment to your concern</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open your situation to see where the evidence points — each link jumps to the graded section.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p) => (
                    <a href={`#${p.id}`} class="block p-3 bg-bone/50 border border-ink/5 hover:border-accent/40 transition">
                      <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                      <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ MODALITY COMPARISON ════════════ -->
        <section id="compare" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The menu</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Modalities compared</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">Four injectable philosophies, one evidence scale.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {modalityRows.map((r) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class={`text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 ${evidencePillClass(r.evidence)}`}>{r.evidence}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.name}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
                <p class="mt-3 text-xs font-medium text-ink/85">{r.price}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References & further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, meta-analyses, or regulatory notices, linked
            inline within each section. Primary sources: PubMed/PMC, FDA safety notifications,
            NEJM, dermatology journals.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. These are medical procedures — verify your
          provider's registration, and defer treatment during pregnancy or breastfeeding.
        </p>
    </div>

  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
