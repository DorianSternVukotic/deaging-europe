---
/**
 * The lip-lines guide (/lip-lines) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video, the
 * three drivers as cards, evidence strength as the primary visual signal, one
 * interactive block (situation matcher) and a month-by-month action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { guideMeta, formatDate } from '../data/guides';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/lip-lines';

const locale = DEFAULT_LOCALE;
const guide = guideMeta('lip-lines');
const title = 'Lip lines (barcode / smoker’s lines) — every treatment graded by evidence | DeAging Europe';
const description =
  'Lip lines are a pursing muscle, thin sun-exposed skin and a deflating lip at once. The pucker test that sorts them, toxin, filler, lasers, dermabrasion and the phenol peel graded by trial evidence, and the mouth’s own risks in numbers.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-remove': 'Resurfacing, yes',
  'faq-smokers': 'Muscle, sun, deflation',
  'faq-straws': 'Vape yes; straw no',
  'faq-filler-lines': 'Border, not lines',
  'faq-toxin-speech': 'Briefly, mildly',
  'faq-laser-or-peel': 'Phenol deepest',
  'faq-timeline': 'Weeks to 6 months',
  'faq-prevent': 'SPF, no smoke, retinoid',
  'faq-cost-ladder': '€20 / month to €2,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'Fine vertical lines only when I purse my lips',
    paths: [
      { id: 'type-dynamic', title: 'Dynamic lip lines', why: 'the muscle alone — the stage where prevention still works' },
      { id: 'inj-toxin', title: 'Toxin micro-doses', why: 'four to six units soften the purse for three months' },
      { id: 'home-spf-quit', title: 'Sunscreen to the lip, no smoking', why: 'the only prevention with evidence' },
    ],
  },
  {
    concern: 'Lines at rest that my lipstick bleeds into',
    paths: [
      { id: 'type-static', title: 'Etched lines', why: 'the dermis has lost its floor — only resurfacing removes them' },
      { id: 'clinic-co2-full', title: 'Full-field CO₂ or erbium', why: '87% less wrinkle depth at two years' },
      { id: 'clinic-phenol', title: 'Or a phenol–croton oil peel', why: 'the deepest, longest result — fair skin, two weeks' },
      { id: 'inj-ha-perioral', title: 'Border filler underneath', why: 'support first, so the resurfaced skin has something to sit on' },
    ],
  },
  {
    concern: 'My lips have thinned and the border has blurred',
    paths: [
      { id: 'type-deflation', title: 'The deflated lip', why: 'volume and support, not the muscle' },
      { id: 'inj-ha-perioral', title: 'Hyaluronic acid on the border and in the body', why: 'two-thirds improved in the pivotal trial' },
      { id: 'surg-lip-lift', title: 'A lip lift for a long philtrum', why: 'the surgical answer to length, not lines' },
    ],
  },
  {
    concern: 'Deep smoker’s lines after decades of smoking',
    paths: [
      { id: 'smoking-vaping', title: 'What smoking did', why: 'the purse plus the smoke — and why quitting is the treatment' },
      { id: 'clinic-phenol', title: 'The phenol–croton oil peel', why: 'where the 639-patient series says lasers fall short' },
      { id: 'clinic-co2-full', title: 'Or full-field CO₂ for smokers’ lines', why: 'the 2024 series and the two-year data' },
    ],
  },
  {
    concern: 'Darker skin, and I am afraid of lightening or dark marks',
    paths: [
      { id: 'safety-resurfacing-lip', title: 'What resurfacing does in darker skin', why: 'permanent lightening from phenol and full CO₂, darkening from any injury' },
      { id: 'clinic-nafl', title: 'Non-ablative or fractional lasers', why: 'softening with far less pigment risk' },
      { id: 'inj-ha-perioral', title: 'Border support and toxin', why: 'the injectables carry no pigment risk at all' },
    ],
  },
  {
    concern: "I'm in my thirties and want to prevent them",
    paths: [
      { id: 'faq-prevent', title: 'Prevention in the thirties', why: 'the strip of skin everyone forgets' },
      { id: 'home-spf-quit', title: 'Sunscreen to the lip, an SPF balm, no smoking', why: 'the only prevention with trials' },
      { id: 'home-retinoid', title: 'A retinoid above the lip', why: 'eight randomised trials in the meta-analysis' },
    ],
  },
  {
    concern: 'Lines at the corners pulling my mouth down',
    paths: [
      { id: 'type-marionette-corners', title: 'Marionette lines are a different problem', why: 'descent and a downward-pulling muscle' },
      { id: 'inj-combo', title: 'Toxin plus filler', why: 'the combination beat filler alone for melomental folds' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: pucker, stretch, profile — and photograph',
    when: 'Before any consultation',
    blurb: 'Dynamic, etched or deflated; teeth and dentures checked; a photograph at rest and puckered in the same light.',
  },
  {
    id: 'home-spf-quit',
    step: 'Day 1 onward: sunscreen to the lip, no smoking, a retinoid ramp',
    when: 'Whatever else you do',
    blurb: 'Face sunscreen carried down to the vermilion, an SPF balm, no cigarette or vape, a retinoid above the lip two nights a week.',
  },
  {
    id: 'inj-ha-perioral',
    step: 'Month 1: toxin micro-doses and border support',
    when: 'Reviewed at two weeks',
    blurb: 'Four to six units along the upper lip, and a soft gel on the border and in the body — never in the lines.',
  },
  {
    id: 'clinic-co2-full',
    step: 'Months 3–6: resurface what stays',
    when: 'Fair skin, two weeks off, antivirals',
    blurb: 'Full-field CO₂, dermabrasion or a phenol peel for the etched lines; fractional in darker skin. Judged at three months.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="lip-lines" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Lip lines (barcode &middot; smoker's lines)</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Lip lines, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          The hardest lines on the face: a pursing muscle, the thinnest sun-exposed skin after the eyelids, and a lip
          that deflates &mdash; three problems in one strip. Below, the pucker test that sorts them, every treatment
          from toxin to the phenol peel graded by the trials behind it, and the mouth's own risks in numbers.
        </p>
        <p class="meta">
          Updated <time datetime={guide.updated}>{formatDate(guide.updated)}</time> · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Lip lines — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'inj' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="Toxin in fractions, filler on the border — where each goes" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Dynamic, etched and deflated — the three lips in profile" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'home-spf-quit',
                    kind: 'The base',
                    title: 'Sunscreen to the lip, no smoking',
                    blurb: 'The only prevention with a randomised trial, on the strip of skin everyone forgets — and the habit with the twin photographs.',
                  },
                  {
                    id: 'inj-toxin',
                    kind: 'For dynamic lines',
                    title: 'Toxin micro-doses',
                    blurb: 'Four to six units along the upper lip: softer lines and a slight eversion for three months, with a three-year controlled study behind it.',
                  },
                  {
                    id: 'inj-ha-perioral',
                    kind: 'For the deflated lip',
                    title: 'Hyaluronic acid on the border',
                    blurb: 'A 225-person randomised trial: perioral lines improved in two-thirds at a year. Border and body — never the grooves.',
                  },
                  {
                    id: 'clinic-phenol',
                    kind: 'For etched lines',
                    title: 'The phenol–croton oil peel',
                    blurb: 'A 639-patient series and the longest results of any non-surgical treatment — two raw weeks, fair skin, very few hands.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your lips</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. The purse first, the support second, the line itself last.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, pivotal-trial reports or clinical series, linked inline within
            each section. Primary sources: PubMed/PMC, Dermatologic Surgery, the Journal of the American Academy of
            Dermatology, the British Journal of Plastic Surgery, Aesthetic Surgery Journal, the Journal of Cosmetic
            Dermatology and Lasers in Surgery and Medicine.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. The mouth carries the labial artery, the herpes virus and the
          muscle you speak with &mdash; toxin is measured in single units here, filler stays off the lines, and
          resurfacing needs antiviral cover and a clear conversation about permanent lightening before it starts.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
