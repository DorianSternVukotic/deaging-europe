---
/**
 * The crow's-feet guide (/crows-feet) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video, the
 * three drivers as cards, evidence strength as the primary visual signal, one
 * interactive block (situation matcher) and a month-by-month action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/crows-feet';

const locale = DEFAULT_LOCALE;
const title = "Crow's feet — every treatment graded by evidence | DeAging Europe";
const description =
  "Crow's feet are dynamic, static or crepe, and the smile test tells you which. Toxin, lasers, fillers, retinoids and the needle-free options graded by trial evidence, the risks near the eye in numbers, and a plan by type.";

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-toxin-age': 'When lines start to stay',
  'faq-frozen': 'Not with a light dose',
  'faq-forever': 'No',
  'faq-static-lines': 'Add the skin work',
  'faq-lower-lid': 'Sparingly, or not',
  'faq-eye-cream': 'A retinoid, on the bone',
  'faq-units-cost': '6–15 units a side',
  'faq-timeline': 'Days to 3 months',
  'faq-natural-alternatives': 'For the fold, no',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'Lines only when I smile or squint',
    paths: [
      { id: 'type-dynamic', title: 'Dynamic crow’s feet', why: 'the muscle is the whole cause' },
      { id: 'inj-toxin', title: 'Botulinum toxin', why: 'about half reach a two-grade improvement at a month; four months a dose' },
      { id: 'home-spf-sunglasses', title: 'Sunglasses and sunscreen', why: 'to keep them dynamic for longer' },
    ],
  },
  {
    concern: 'Lines that stay when my face is still',
    paths: [
      { id: 'type-static', title: 'Static crow’s feet', why: 'the muscle plus an etched floor' },
      { id: 'inj-toxin', title: 'Toxin first', why: 'stops the fold so the floor can be rebuilt' },
      { id: 'clinic-ablative', title: 'Then a fractional laser', why: 'the tool that rebuilds the floor of the line' },
      { id: 'inj-toxin-filler-combo', title: 'Or a microdroplet gel along the line', why: 'prolonged toxin’s result in a randomised split-face trial' },
    ],
  },
  {
    concern: 'Crinkly, crepey skin at the corners rather than distinct lines',
    paths: [
      { id: 'type-crepe', title: 'Crepe', why: 'skin quality, not muscle — and where toxin can make it worse' },
      { id: 'home-retinoid', title: 'A retinoid and sunscreen', why: 'thickens the epidermis and rebuilds collagen over months' },
      { id: 'clinic-nafl', title: 'A non-ablative fractional laser', why: 'remodels the dermis with two days of redness' },
    ],
  },
  {
    concern: 'The outer brow has dropped and the lines bunch under it',
    paths: [
      { id: 'type-brow-hooding', title: 'A brow problem in a crow’s-foot costume', why: 'treat the brow, then the lines' },
      { id: 'inj-toxin-brow', title: 'A toxin lateral brow lift', why: 'a few millimetres, unpredictably, as part of the session' },
      { id: 'clinic-ultherapy-brow', title: 'Microfocused ultrasound, or a surgical lift', why: 'half a millimetre to 1.7 mm measured; surgery for more' },
    ],
  },
  {
    concern: 'Lines running under my eye onto the cheek',
    paths: [
      { id: 'type-lower', title: 'The lower extension', why: 'over the muscle that holds the lid and next to the one that lifts the smile' },
      { id: 'safety-toxin-eye', title: 'Why toxin is risky here', why: 'a weak smile, a slack lid, a puffy eye' },
      { id: 'home-retinoid', title: 'Skin work first', why: 'a retinoid, sunscreen, and a gentle laser' },
    ],
  },
  {
    concern: "I'm in my late twenties and want to prevent them",
    paths: [
      { id: 'why-sort', title: 'The window', why: 'dynamic lines stay dynamic if the skin is protected' },
      { id: 'home-spf-sunglasses', title: 'Sunglasses and sunscreen from today', why: 'the only prevention with a randomised trial' },
      { id: 'faq-toxin-age', title: 'When toxin becomes reasonable', why: 'when a smile line starts to linger at rest — not before' },
    ],
  },
  {
    concern: 'I want to avoid needles',
    paths: [
      { id: 'home-retinoid', title: 'A retinoid at the outer eye', why: 'the strongest needle-free evidence for fine lines' },
      { id: 'home-led', title: 'A home LED mask', why: 'a sham-controlled trial for crow’s feet specifically' },
      { id: 'clinic-nafl', title: 'A non-ablative laser', why: 'beat focused ultrasound in a randomised trial' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the smile test, and a photograph at rest and smiling',
    when: 'Before any consultation',
    blurb: 'Dynamic, static, crepe or brow — thirty seconds in a mirror decides the tier and the two-week review is judged against the photo.',
  },
  {
    id: 'home-spf-sunglasses',
    step: 'Day 1 onward: sunglasses, sunscreen to the rim, a retinoid ramp',
    when: 'Whatever else you do',
    blurb: 'The only prevention with a randomised trial, and the skin every other treatment works on.',
  },
  {
    id: 'inj-toxin',
    step: 'Month 1: toxin for what moves',
    when: 'Reviewed at two weeks',
    blurb: '6–15 units a side, a centimetre outside the bony rim, from someone who mapped your smile first. Repeat every three to four months.',
  },
  {
    id: 'clinic-ablative',
    step: 'Months 3–6: rebuild what stays',
    when: 'Static lines and crepe only',
    blurb: 'A fractional laser after the toxin has settled, or a microdroplet gel along the line; judged at three months.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="crows-feet" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Crow's feet</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Crow's feet, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          The first wrinkle most faces get, and the best-treated one &mdash; because a muscle makes it and a toxin
          stops the muscle. Below, the smile test that sorts dynamic lines from static ones from crepe, every
          treatment graded by the trials behind it, and the risks near the eye in numbers.
        </p>
        <p class="meta">
          Updated 6 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Crow's feet — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'inj' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="The smile test, and where the three points go" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Dynamic, static and crepe — the three crow’s feet, side by side" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per type — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'home-spf-sunglasses',
                    kind: 'The base',
                    title: 'Sunglasses and sunscreen to the rim',
                    blurb: 'The only prevention with a randomised trial, on the thinnest and most sun-exposed skin of the face. The squint is the second mechanism.',
                  },
                  {
                    id: 'inj-toxin',
                    kind: 'For dynamic lines',
                    title: 'Botulinum toxin',
                    blurb: 'Licensed on phase 3 trials: 55% responders at a month against 3% on placebo, a median of four months, every newer toxin repeating it.',
                  },
                  {
                    id: 'clinic-ablative',
                    kind: 'For etched lines',
                    title: 'A fractional laser',
                    blurb: 'Randomised split-face trials around the eye; the tool that rebuilds the floor of a static line once the toxin has stopped the fold.',
                  },
                  {
                    id: 'home-retinoid',
                    kind: 'For crepe',
                    title: 'A retinoid at the outer eye',
                    blurb: 'Eight randomised trials in the meta-analysis; a third less periorbital lining in 12 weeks in the eye-cream study. Months, not weeks.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your crow's feet</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. The muscle first, the skin second, the brow when it is the problem.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, pivotal-trial reports or regulatory documents, linked
            inline within each section. Primary sources: PubMed/PMC, Dermatologic Surgery, the Journal of
            Cosmetic Dermatology, the Journal of the American Academy of Dermatology, Aesthetic Plastic
            Surgery, the FDA label and StatPearls.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Toxin, filler and lasers near the eye carry risks to the
          smile, the lid and, rarely, sight in the wrong hands &mdash; choose clinicians who treat eyes every
          week, insist on a licensed product, and read the safety drawers before the treatment rows.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
