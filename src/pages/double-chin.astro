---
/**
 * The double-chin guide (/double-chin) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video,
 * the three drivers as cards, evidence strength as the primary visual
 * signal, one interactive block (situation matcher) and a month-by-month
 * action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/double-chin';

const locale = DEFAULT_LOCALE;
const title = 'Double chin (submental fullness) — every treatment graded by evidence | DeAging Europe';
const description =
  'A double chin is four things: fat above the neck muscle, fat below it, a neck that has loosened, and a short chin or low hyoid. The pinch, recline, clench and profile tests that sort them, deoxycholic acid, fat freezing, liposuction, chin support, devices and the neck lift graded by trial evidence, and the crooked-smile and fat-that-grows risks in numbers.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-diet': 'The fat, not the rest',
  'faq-kybella-vs-coolmini': 'Injection has the trials',
  'faq-permanent': 'For the fat, yes',
  'faq-ozempic': 'It changed type',
  'faq-exercises': 'No',
  'faq-chin': 'Often',
  'faq-devices-before-surgery': 'Only for the fat type',
  'faq-timeline': '6 weeks to a year',
  'faq-cost-ladder': 'Free to €18,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'A soft pad I can pinch under my chin, and my neck skin is firm',
    paths: [
      { id: 'type-fat', title: 'Fat above the muscle', why: 'the one double chin with placebo-controlled treatments' },
      { id: 'inj-deoxycholic', title: 'Deoxycholic acid', why: '66–70% improved against 19–22% on placebo, held at three years' },
      { id: 'clinic-cryolipolysis', title: 'Or cryolipolysis', why: 'gentler, millimetres per cycle, a 1-in-455 risk of the fat growing' },
      { id: 'clinic-liposuction', title: 'Or one morning of liposuction', why: 'all 132 patients improved in the reference series — with firm skin' },
    ],
  },
  {
    concern: 'Loose, crepey skin under my chin that hangs when I look down',
    paths: [
      { id: 'type-skin', title: 'The loose neck', why: 'slack, not fat — fat removal makes it worse' },
      { id: 'clinic-hifu', title: 'Focused ultrasound for mild slack', why: 'cleared to lift under the chin; millimetres' },
      { id: 'clinic-renuvion', title: 'Subdermal plasma for moderate slack', why: '82.5% improved at six months in the clearance trial' },
      { id: 'clinic-neck-lift', title: 'A neck lift for more', why: 'the only treatment that redrapes the skin' },
    ],
  },
  {
    concern: 'Vertical cords in my neck when I clench',
    paths: [
      { id: 'type-muscle', title: 'The platysma', why: 'slack muscle, not fat' },
      { id: 'inj-platysma-toxin', title: 'Toxin for the bands', why: 'phase 3 trials and a 2024 licence, three months at a time' },
      { id: 'clinic-neck-lift', title: 'A platysmaplasty for good', why: 'the sling rebuilt under the chin' },
    ],
  },
  {
    concern: 'My chin is small and my whole family has this',
    paths: [
      { id: 'type-structure', title: 'The family chin', why: 'bone sets the angle at any weight' },
      { id: 'inj-chin-filler', title: 'Chin filler first', why: 'retrusion corrected in 56% against 28% untreated — and you see the profile' },
      { id: 'clinic-chin-implant', title: 'An implant or genioplasty for life', why: 'usually with liposuction, because the two together sharpen the angle most' },
    ],
  },
  {
    concern: 'I lost weight, or I am on a GLP-1 medicine, and it got worse',
    paths: [
      { id: 'type-weight', title: 'The GLP-1 neck', why: 'the fat left faster than the skin could follow' },
      { id: 'faq-ozempic', title: 'Why it changed type', why: 'fat treatments no longer help' },
      { id: 'clinic-hifu', title: 'A device for mild slack', why: 'if the skin is young enough to retract' },
      { id: 'clinic-neck-lift', title: 'A surgeon before anyone injects', why: 'the simpler operation is the one done first' },
    ],
  },
  {
    concern: 'Deep fullness that will not pinch and does not move',
    paths: [
      { id: 'type-fat', title: 'Fat below the muscle', why: 'nothing injected or applied reaches it' },
      { id: 'workup', title: 'The four tests, then a surgeon', why: 'the glands and the deep fat are surgical findings' },
      { id: 'clinic-neck-lift', title: 'The deep neck lift', why: 'subplatysmal fat removed in 49% of techniques, glands in 70%' },
    ],
  },
  {
    concern: 'I want something non-surgical and permanent',
    paths: [
      { id: 'inj-deoxycholic', title: 'Deoxycholic acid', why: 'the fat cells do not come back — 82% still responding at three years' },
      { id: 'clinic-cryolipolysis', title: 'Cryolipolysis', why: 'permanent for the cells it kills, modest per cycle' },
      { id: 'safety-cryo', title: 'Read the fat-that-grows row first', why: '1 in 455, and only liposuction fixes it' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: pinch, recline, clench, profile — and photograph with the head level',
    when: 'Before any consultation',
    blurb: 'Fat above or below the muscle, slack, cords or bone; weight trajectory and any weight-loss medicine noted; the profile the trials graded.',
  },
  {
    id: 'home-weight',
    step: 'Day 1 onward: the weight, the skin, and no unlicensed injections',
    when: 'Whatever else you do',
    blurb: 'Weight lost slowly if the pad is fat; sunscreen and a retinoid on the neck; nothing sold as a "fat dissolver" that is not the licensed molecule.',
  },
  {
    id: 'inj-deoxycholic',
    step: 'Months 1–4: the right tool for the type',
    when: 'Judged at 6–8 weeks per step',
    blurb: 'Deoxycholic acid or cold for a pad in a firm neck; chin filler for the short chin; one device course for mild slack — never fat removal in a loose neck.',
  },
  {
    id: 'clinic-neck-lift',
    step: 'Months 6–12: judge it, or see the surgeon you should have seen first',
    when: 'Before more syringes',
    blurb: 'Fat treatments are judged at three months; the loose, deep or corded neck belongs to a neck lift, and the fewer treatments before it, the simpler it is.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="double-chin" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Double chin (submental fullness)</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Double chin, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          Four things, not one: fat above the neck muscle, fat below it, a neck that has loosened, and a chin that is
          short or a hyoid that sits low. Below, the pinch, recline, clench and profile tests that sort them, every
          treatment from the licensed injection to the deep neck lift graded by the trials behind it, and the
          crooked-smile and fat-that-grows risks in numbers.
        </p>
        <p class="meta">
          Updated 7 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Double chin — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'inj' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="Above the muscle, below it, the skin and the chin — where each treatment reaches" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Fat, slack, cords and the family chin — four profiles with the head level" />
              </div>
            )}

            <div class="chart mt-8">
              <div class="chart-cols" aria-hidden="true"><span>Evidence · 0–4</span><span>Treatment</span><span></span></div>
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'inj-deoxycholic',
                    kind: 'For the pinchable pad',
                    title: 'Deoxycholic acid injections',
                    blurb: 'Two placebo-controlled phase 3 trials of 1,022 people: 66–70% improved against 19–22% on placebo, most within 2–4 sessions, held at three years.',
                  },
                  {
                    id: 'inj-chin-filler',
                    kind: 'For the family chin',
                    title: 'Chin filler',
                    blurb: 'Lengthens the line from chin to throat: retrusion corrected in 56% against 28% untreated in a 192-person randomised trial — and shows you the profile before an implant.',
                  },
                  {
                    id: 'clinic-hifu',
                    kind: 'For mild slack',
                    title: 'Focused ultrasound',
                    blurb: 'Cleared to lift under the chin; a neck study measured the lift on profile photographs and meta-analyses find modest, consistent tightening. Millimetres, no downtime.',
                  },
                  {
                    id: 'clinic-neck-lift',
                    kind: 'For the real thing',
                    title: 'A neck lift',
                    blurb: 'The only treatment that reaches all four problems: 82–99% satisfied across 57 studies in 8,648 patients, with the nerve and haematoma rates printed beside it.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your neck</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. The four tests first, the right tool for the type, and the surgeon before the fourth syringe rather than after it.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, phase 3 trials, meta-analyses, regulator documents or clinical
            series, linked inline within each section. Primary sources: PubMed/PMC, Dermatologic Surgery, the Journal
            of the American Academy of Dermatology, Aesthetic Surgery Journal, Annals of Plastic Surgery, Plastic and
            Reconstructive Surgery, Lasers in Surgery and Medicine, the EMA and the FDA.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. The nerve to the lower lip and the structures of the throat sit
          under this skin &mdash; the licensed injection belongs to a trained clinician working inside a marked grid,
          the fat-freezing cup carries a rare permanent complication, and the neck that reclines away, will not
          pinch or cords when you clench deserves a surgeon's opinion before anyone injects it.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
