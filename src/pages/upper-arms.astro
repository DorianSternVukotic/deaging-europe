---
/**
 * The upper-arms guide (/upper-arms) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video,
 * the three drivers as cards, evidence strength as the primary visual
 * signal, one interactive block (situation matcher) and a month-by-month
 * action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { guideMeta, formatDate } from '../data/guides';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/upper-arms';

const locale = DEFAULT_LOCALE;
const guide = guideMeta('upper-arms');
const title = 'Loose upper-arm skin — every treatment graded by evidence | DeAging Europe';
const description =
  'A hanging upper arm is skin that has lost its recoil, fat that is too much or has left, and a triceps that fills but never shrinks the sleeve. The ruler-and-pinch self-check that sorts them, and resistance training, retinoids, collagen stimulators, ultrasound, cryolipolysis, energy-assisted liposuction and the arm lift graded by trial evidence — with the honest percentages, the scar, and the weight-stable clock.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-exercise': 'Fills the arm; never shrinks the skin',
  'faq-creams': 'One trial, modest, crepe only',
  'faq-best-nonsurgical': 'Depends on the grid',
  'faq-scar': 'Inner arm; poor in one in ten',
  'faq-glp1': 'After the loss, not during',
  'faq-percent': 'A third of a tattooed grid',
  'faq-timeline': 'Three months to eighteen',
  'faq-cost-ladder': 'Free to €9,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'My arms are big and firm, not hanging',
    paths: [
      { id: 'type-fat', title: 'The full arm', why: 'a thick fold that springs back is fat under skin with recoil' },
      { id: 'home-resistance-training', title: 'Training and protein first', why: 'a fuller triceps changes the shape before anything is removed' },
      { id: 'dev-cryolipolysis', title: 'Cryolipolysis', why: 'fat layer 15% thinner after one cycle in the arm pilot' },
      { id: 'surg-liposuction', title: 'Liposuction alone', why: 'the surgeons\' whole treatment for stage 1 and 2a' },
    ],
  },
  {
    concern: 'The skin hangs when I lift my arm and there is little fat in it',
    paths: [
      { id: 'type-skin', title: 'The deflated arm', why: 'a thin fold that stays where it is pinched — stage 4' },
      { id: 'workup', title: 'Measure the hang at 90°', why: 'under 5 cm, 5–10, or over 10 decides the row' },
      { id: 'surg-rfal', title: 'Energy-assisted liposuction for 5–10 cm', why: 'a third of the surface and half the hang, no scar' },
      { id: 'surg-brachioplasty', title: 'The arm lift for over 10 cm', why: 'the only treatment that removes skin — with the scar' },
    ],
  },
  {
    concern: 'I have lost a lot of weight, or I am on a GLP-1 drug',
    paths: [
      { id: 'type-mixed', title: 'The mixed arm after weight loss', why: 'the commonest arm in a clinic — sequence matters most' },
      { id: 'home-weight', title: 'Stable weight for six to twelve months', why: 'the arm you treat should be the arm you keep' },
      { id: 'safety-timing-weight', title: 'The surgeon\'s checklist and the anaesthetist', why: 'the drug slows the stomach; nutrition and smoking count' },
      { id: 'surg-rfal', title: 'Then energy, or excision', why: '120 patients across every class, satisfaction 35% to 87%' },
    ],
  },
  {
    concern: 'Crepey, thin skin with a small hang — I am in my fifties',
    paths: [
      { id: 'type-crepe', title: 'The crepey arm', why: 'the arm the gentle trials recruited; a scar is the wrong trade' },
      { id: 'home-retinoid', title: 'A retinoid on the inner arm', why: 'the trial with biopsies was done on this exact skin' },
      { id: 'dev-ultrasound', title: 'Ultrasound tightening', why: 'both devices improved laxity and crepiness at 90 days in the arm trial' },
      { id: 'inj-caha', title: 'Hyperdilute calcium hydroxylapatite', why: '77% considerably improved in the 30-patient series' },
    ],
  },
  {
    concern: 'I refuse a scar',
    paths: [
      { id: 'surg-rfal', title: 'Energy-assisted liposuction', why: 'the one non-excisional method with a ruler on its result' },
      { id: 'dev-ultrasound', title: 'Ultrasound for the mild hang', why: 'no wound, a grade on a scale' },
      { id: 'faq-percent', title: 'What the percentages mean', why: 'a third of a tattooed grid, not a third of the hang you see' },
    ],
  },
  {
    concern: 'My arms have gone soft and I have lost strength',
    paths: [
      { id: 'type-muscle', title: 'The soft arm', why: 'the envelope has not changed; the filling has' },
      { id: 'home-resistance-training', title: 'Resistance training with protein', why: '0.70 kg of muscle in twelve weeks in older women' },
      { id: 'dev-hifem', title: 'Electromagnetic stimulation', why: 'triceps 24% thicker on MRI in the maker\'s study, for those who will not train' },
    ],
  },
  {
    concern: 'Darker skin, or I scar thickly',
    paths: [
      { id: 'safety-scar-nerves', title: 'The scar', why: 'a keloid anywhere is a reason to stop at the energy rows' },
      { id: 'dev-ultrasound', title: 'Ultrasound', why: 'no surface wound, no pigment risk' },
      { id: 'inj-caha', title: 'A collagen stimulator', why: 'no light, no incision' },
      { id: 'home-retinoid', title: 'The retinoid and the acids', why: 'body-skin trials, no scar' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the hang, the pinch, the flex and the scale',
    when: 'Before anything',
    blurb: 'Arm out at 90° and a ruler from the groove to the fold; the pinch for thickness and recoil; the triceps squeezed; the weight trend and any GLP-1 dose written down; both arms photographed front and back, held out.',
  },
  {
    id: 'home-resistance-training',
    step: 'Day 1 onward: the filling and the crepe',
    when: 'Whatever else you do',
    blurb: 'Presses, extensions and rows two or three times a week with protein at 1.2 g per kilo and creatine; a retinoid on the inner arm built up over two months; sunscreen on the outer arm; a lactic or urea lotion; weight held stable.',
  },
  {
    id: 'dev-ultrasound',
    step: 'Months 2–6: the device or the stimulator for your cell of the grid',
    when: 'Judged at 90 days to six months',
    blurb: 'Ultrasound or a calcium hydroxylapatite course for the crepey arm with a small hang; cryolipolysis for the full arm whose skin recoils; electromagnetic stimulation for the soft arm that will not train; nothing on a weight still falling.',
  },
  {
    id: 'surg-rfal',
    step: 'Month 6 onward: energy under the skin, or the scar',
    when: 'After six to twelve stable months',
    blurb: 'Energy-assisted liposuction for a 5–10 cm hang without a scar, judged at six months to a year; the arm lift for a hang over 10 cm, with a surgeon whose year-old scars you have seen and a postero-medial line; everything compared against the 90° photograph.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="upper-arms" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Loose upper-arm skin</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Loose upper arms, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          A hanging upper arm is three things in different proportions &mdash; skin that has lost its recoil, fat that
          is too much or has left, and a triceps that fills the sleeve but never shortens it. Below, the ruler-and-pinch
          self-check that sorts them, every treatment from training to the arm lift graded by the trials behind it, the
          honest percentages the devices actually measured, and the scar and the clock that decide the rest.
        </p>
        <p class="meta">
          Updated <time datetime={guide.updated}>{formatDate(guide.updated)}</time> · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Loose upper arms — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'surg' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="The grid: the hang at 90° in centimetres, the pinch, and which row each cell gets" />
                <MediaPlaceholder kind="image" ratio="16/9" label="The same arm held out before, and a year after energy-assisted liposuction — the tattooed grid a third smaller" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic' || g.id === 'surg'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'home-resistance-training',
                    kind: 'The base',
                    title: 'Training with protein',
                    blurb: 'Twelve weeks of band training added 0.70 kg of muscle in 56 older women; protein at 1.2 g per kilo and creatine add to it. Fills the envelope so a mild hang reads as shape — and keeps the muscle on the way down a GLP-1.',
                  },
                  {
                    id: 'surg-rfal',
                    kind: 'For the moderate hang',
                    title: 'Energy-assisted liposuction',
                    blurb: 'A third of the inner-arm surface and half the hang at one year on a tattooed grid; 120 consecutive patients treated without conversion to an arm lift, satisfaction 35% to 87%. No scar, a local anaesthetic.',
                  },
                  {
                    id: 'surg-brachioplasty',
                    kind: 'For the severe hang',
                    title: 'The arm lift',
                    blurb: 'The only treatment that removes skin: satisfaction 4.3 of 5 and 94% who would repeat it in the weight-loss series, with a scar rated 3.9 that is poor in one in ten and takes 12–18 months to fade.',
                  },
                  {
                    id: 'dev-ultrasound',
                    kind: 'For the crepey arm',
                    title: 'Ultrasound tightening',
                    blurb: 'Both devices improved laxity and crepiness at 90 days in the blinded split-body arm trial; 93% of arms rated improved in the 46-person clearance study. No wound, a grade on a scale, one or two sessions.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your arms</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Measure the arm, fill it and treat the crepe, hold the weight, and buy the rung that matches the cell of the grid.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, randomised trials, meta-analyses, clinical series, registered
            trial results or reference texts, linked inline within each section. Primary sources: PubMed/PMC, Plastic
            and Reconstructive Surgery, the Aesthetic Surgery Journal, Aesthetic Plastic Surgery, Dermatologic Surgery,
            Archives of Dermatology, the New England Journal of Medicine, the Journal of Drugs in Dermatology,
            Scientific Reports, ClinicalTrials.gov, the ASPS statistics and StatPearls.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Liposuction or cryolipolysis of an arm whose skin does not recoil
          from a pinch makes the hang longer; no procedure is worth having while weight is still falling; and anyone
          taking a GLP-1 drug tells the anaesthetist before any operation.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
