---
/**
 * The fine-lines & wrinkles guide (/wrinkles) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video, the
 * three drivers as cards, evidence strength as the primary visual signal, one
 * interactive block (situation matcher) and a month-by-month action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/wrinkles';

const locale = DEFAULT_LOCALE;
const title = 'Fine lines & wrinkles — every treatment graded by evidence | DeAging Europe';
const description =
  'Fine lines, expression lines, deep folds and lip lines are different problems. What causes each, every treatment from sunscreen to a deep peel graded by trial evidence, and a plan by wrinkle type.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-retinol-vs-tretinoin': 'Tretinoin, if you can',
  'faq-when-start': 'SPF now; retinoid late 20s',
  'faq-timeline': 'Hours to 12 weeks',
  'faq-botox-forever': 'No',
  'faq-lines-vs-folds': 'Folds need filler',
  'faq-eye-cream': 'No',
  'faq-lip-lines': 'Resurfacing + toxin',
  'faq-collagen-drinks': 'Modestly',
  'faq-pillow': 'Plausible, cheap',
  'faq-cost-ladder': '€20 / month to €5,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'Fine lines and crepey texture on the cheeks or under the eyes',
    paths: [
      { id: 'home-tretinoin', title: 'Tretinoin (or a stated-strength retinol)', why: 'the one cream that rebuilds the upper dermis — decades of trials' },
      { id: 'home-spf', title: 'Daily sunscreen', why: '24% less measured aging over 4.5 years in the only prevention trial' },
      { id: 'clinic-nafl', title: 'Non-ablative fractional laser', why: 'texture and fine lines with a day or two of redness' },
    ],
  },
  {
    concern: 'Lines that appear only when I frown, squint or raise my brows',
    paths: [
      { id: 'inj-toxin', title: 'Botulinum toxin', why: 'dynamic lines are its home territory — 77–89% responders at a month' },
      { id: 'home-tretinoin', title: 'Plus the retinoid base', why: 'so the skin between doses keeps improving' },
    ],
  },
  {
    concern: 'Lines that stay even when my face is still (etched forehead, crow’s feet)',
    paths: [
      { id: 'inj-toxin', title: 'Toxin first', why: 'stops the folding so the dermis can recover' },
      { id: 'clinic-ablative', title: 'Then resurfacing', why: 'an ablative fractional laser rebuilds the floor of an etched line' },
      { id: 'inj-ha-lines', title: 'A thin filler for the deepest grooves', why: 'in the ones that resist both' },
    ],
  },
  {
    concern: 'Deep folds from nose to mouth or mouth to chin',
    paths: [
      { id: 'type-folds', title: 'Read this first', why: 'these are volume and descent, not wrinkles — and why cream fails' },
      { id: 'inj-ha-folds', title: 'Hyaluronic-acid filler', why: '~80% still responding at a year; reversible' },
      { id: 'inj-plla', title: 'Or a collagen stimulator', why: 'slower, subtler, up to 25 months' },
    ],
  },
  {
    concern: 'Vertical lip lines',
    paths: [
      { id: 'type-perioral', title: 'Why they are the hardest lines', why: 'thin skin, a pursing muscle, sun and lost volume' },
      { id: 'clinic-ablative', title: 'Fractional ablative laser', why: 'rebuilds the dermis where creams cannot reach' },
      { id: 'clinic-peel-deep', title: 'Or a phenol–croton oil peel', why: 'the most powerful single treatment for this zone, in fair skin' },
      { id: 'inj-ha-lines', title: 'Plus a little toxin and thin filler', why: 'for the pursing and the deepest grooves' },
    ],
  },
  {
    concern: 'Creases from sleeping, or lines on my chest',
    paths: [
      { id: 'type-sleep', title: 'Sleep wrinkles', why: 'mechanical, plausible, and thinly evidenced' },
      { id: 'home-silicone', title: 'Silicone patches and back-sleeping', why: 'cheap experiments; hours of effect' },
      { id: 'home-spf', title: 'Sunscreen to the chest', why: 'where the real damage is' },
    ],
  },
  {
    concern: "I'm in my twenties and want to prevent all of it",
    paths: [
      { id: 'why-early', title: 'Prevention in numbers', why: 'the only randomised prevention evidence costs €20 a month' },
      { id: 'home-retinol', title: 'A retinoid from the late twenties', why: 'the dermatologist consensus, and the trials behind it' },
      { id: 'inj-preventive', title: '"Baby Botox" — read before buying', why: 'one pair of twins is the evidence' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: read your face and photograph it',
    when: 'Before buying anything',
    blurb: 'The stretch test sorts surface lines from etched ones from folds; same-light photos are the only honest judge.',
  },
  {
    id: 'safety-retinoids',
    step: 'Weeks 1–8: the retinoid ramp',
    when: 'Sunscreen from day one',
    blurb: 'Two or three nights a week, buffered; dryness peaks at week three and passes. Most people quit here — don’t.',
  },
  {
    id: 'faq-timeline',
    step: 'Months 3–6: first change',
    when: 'Compare photos, not mirrors',
    blurb: 'Fine lines soften and texture evens; toxin, if you added it, has peaked and faded once by now.',
  },
  {
    id: 'faq-cost-ladder',
    step: 'Month 6–12: add the next rung',
    when: 'Decide with a dermatologist',
    blurb: 'Toxin for what still moves, filler for what has folded, resurfacing for what is etched — never skipping the base.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="wrinkles" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Fine lines &amp; wrinkles</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Wrinkles, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          Fine lines, expression lines, deep folds and lip lines are four different problems, and the tool that
          fixes one does little for the others. Below, what causes each, every treatment graded by the trials
          behind it, and a plan by wrinkle type.
        </p>
        <p class="meta">
          Updated 6 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Wrinkles — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'inj' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="Toxin, filler, laser — what each one actually does" />
                <MediaPlaceholder kind="image" ratio="16/9" label="The four wrinkle types, mapped on a face" />
              </div>
            )}

            <div class="chart mt-8">
              <div class="chart-cols" aria-hidden="true"><span>Evidence · 0–4</span><span>Treatment</span><span></span></div>
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per wrinkle type — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'home-tretinoin',
                    kind: 'The base',
                    title: 'Tretinoin + daily SPF',
                    blurb: 'The only prevention with randomised trials, and the one cream that changes the dermis. €20–50 a month.',
                  },
                  {
                    id: 'inj-toxin',
                    kind: 'For expression lines',
                    title: 'Botulinum toxin',
                    blurb: 'The most-studied cosmetic treatment there is: 77–89% responders at a month, three to four months a dose.',
                  },
                  {
                    id: 'inj-ha-folds',
                    kind: 'For folds',
                    title: 'Hyaluronic-acid filler',
                    blurb: 'Regulator-grade trials, ~80% responding at a year, and reversible on demand. Treat the cheek, not just the line.',
                  },
                  {
                    id: 'clinic-ablative',
                    kind: 'For etched lines',
                    title: 'Fractional ablative laser',
                    blurb: 'Rebuilds the dermis under crow’s feet and lip lines; results last years, with a week of downtime.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your lines</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. The base comes first, whatever else you add.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, pivotal-trial reports or regulatory documents, linked
            inline within each section. Primary sources: PubMed/PMC, the Annals of Internal Medicine, the
            Journal of the American Academy of Dermatology, the British Journal of Dermatology, Dermatologic
            Surgery, Plastic and Reconstructive Surgery, JAMA Dermatology and FDA documents.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Retinoids are avoided in pregnancy; injectables and
          resurfacing carry rare but serious risks that depend on who performs them &mdash; see the safety
          drawers and choose a licensed clinician who examines your face before quoting a treatment.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
