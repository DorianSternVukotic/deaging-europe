---
// Rendered by Astro for any 404 (unknown route, or a page returning a 404
// Response — see the dynamic pages). Wix falls back to its own generic
// "Page wasn't found" screen without this.
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
---
<BaseLayout
  title="Page not found | DeAging Europe"
  description="This page doesn't exist or has moved."
  locale={DEFAULT_LOCALE}
>
  <section class="max-w-[1440px] mx-auto px-5 md:px-14 py-24 md:py-32">
    <p class="eyebrow">404</p>
    <h1 class="font-display text-5xl md:text-7xl mt-6 max-w-3xl leading-[1.05]">This page doesn't exist.</h1>
    <p class="mt-8 text-xl text-ink/75 max-w-2xl leading-relaxed">
      It may have moved while the site is being expanded. Start from the home page or go straight to the collagen guide.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/" class="btn">Home</a>
      <a href="/collagen" class="btn btn--outline">Collagen guide</a>
    </div>
  </section>
</BaseLayout>
