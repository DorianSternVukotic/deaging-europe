---
/**
 * Anti-aging in your 30s (/anti-aging-30s) — decade guide in the collagen-guide
 * layout: evidence strength as the primary visual signal, one interactive
 * block (decade-plan builder).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  keyTakeaways,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/anti-aging-30s';

const locale = DEFAULT_LOCALE;
const title = 'Anti-aging in your 30s — the evidence guide | DeAging Europe';
const description =
  'What actually changes at 30–39, the prevention core with trial-grade proof, and the "prejuvenation" treatments sold on a single case report — every option graded.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const evidencePillClass = (e?: Evidence) =>
  e === 'strong'
    ? 'tier-pill tier-strong'
    : e === 'moderate'
    ? 'tier-pill tier-moderate'
    : e === 'emerging'
    ? 'tier-pill tier-emerging'
    : 'tier-pill tier-none';

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-retinoid-when': 'First fine lines',
  'faq-preventive-botox': 'One twin case',
  'faq-eye-cream': 'No',
  'faq-sun-damage': 'Partly',
  'faq-early-filler': 'No',
  'faq-melasma': 'Usually, in a year',
  'faq-smoking': '~2.5 yrs/decade',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Budget-tier comparison cards.
const tierRows = [
  {
    id: 'routine-and-budget',
    tier: 'Foundation',
    price: '≈ €200–450 / yr',
    evidence: 'strong' as Evidence,
    blurb: 'Daily SPF, a retinoid at night, plain cleanser and moisturizer, one dermatology visit — the whole trial-grade core.',
  },
  {
    id: 'routine-and-budget',
    tier: 'Foundation + targeted',
    price: '≈ €900–2,000 / yr',
    evidence: 'moderate' as Evidence,
    blurb: 'Add vitamin C, niacinamide or azelaic acid, and toxin two or three times a year for lines that stay at rest.',
  },
  {
    id: 'routine-and-budget',
    tier: 'Full evidence-based',
    price: '≈ €2,500–5,000 / yr',
    evidence: 'moderate' as Evidence,
    blurb: 'Add a supervised melasma protocol if needed, one targeted laser course for real sun spots, and a strength coach.',
  },
  {
    id: 'what-not-to-do',
    tier: 'Not at any budget',
    price: 'Save it',
    evidence: 'limited' as Evidence,
    blurb: 'Preventive filler, baby Botox on unlined skin, energy devices without laxity, collagen drinks, eye creams as a category.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="anti-aging-30s" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-14 md:py-20 grid lg:grid-cols-[1fr_auto] gap-10 items-center">
        <div>
          <p class="eyebrow mb-4">By decade · 30–39</p>
          <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
            Your 30s, evidence first.
          </h1>
          <p class="mt-6 max-w-2xl text-lg md:text-xl text-ink/75 leading-relaxed">
            The prevention decade: two cheap habits with trial-grade proof, and a "prejuvenation"
            industry running on one case report.
          </p>
          <p class="meta">
            Updated 3 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
          </p>
        </div>
        <MediaPlaceholder kind="image" ratio="4/5" label="Hero portrait — 30s" class="w-full lg:w-72" />
      </div>
    </header>


    <!-- ════════════ TOP-FOLD SUMMARY + INFO DRAWERS ════════════ -->
    <section id="takeaways" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-10">
      <div>
        <p class="eyebrow">The case in five lines</p>
        <h2 class="text-3xl mt-2">If you read nothing else</h2>
        <ol class="mt-5 space-y-3 text-[15px] leading-relaxed text-ink/85 max-w-3xl">
          {keyTakeaways.map((k, i) => (
            <li class="flex gap-3">
              <span class="font-display text-accent w-6 shrink-0">{i + 1}.</span>
              <span>{k}</span>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <MediaPlaceholder kind="video" ratio="16/9" label="Explainer · 2 min" />
      </div>

      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          <div class="mt-6 grid">
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Your 30s — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'clinic' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="Dynamic vs static lines, explained" />
                <MediaPlaceholder kind="image" ratio="16/9" label="The twin study, visualized" />
              </div>
            )}

            <div class="chart mt-8">
              <div class="chart-cols" aria-hidden="true"><span>Evidence · 0–4</span><span>Treatment</span><span></span></div>
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">The four moves that compound most between 30 and 40.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'daily-spf',
                    kind: 'The proof',
                    title: 'Sunscreen, every morning',
                    blurb: 'The only anti-aging RCT in your age band: no detectable aging over 4.5 years.',
                  },
                  {
                    id: 'daily-tretinoin',
                    kind: 'The engine',
                    title: 'A nightly retinoid',
                    blurb: 'Eight RCTs from age 29 — start at the first fine line, not a birthday.',
                  },
                  {
                    id: 'health-smoking',
                    kind: 'The multiplier',
                    title: 'Don\'t smoke, mind the sun',
                    blurb: 'Twin-controlled: ~2.5 perceived years per decade of smoking.',
                  },
                  {
                    id: 'health-strength',
                    kind: 'The investment',
                    title: 'Strength training',
                    blurb: 'Bank peak bone now; the one exercise that thickened the dermis in a trial.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + PLAN BUILDER / TIERS / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ BUILD-YOUR-30s-PLAN ════════════ -->
        <section id="routine" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Build your 30s plan</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Pick one option per row. Your plan appears below. Saved to your browser only.</p>

          <div class="mt-8 space-y-6" id="routine-builder">
            {[
              { key: 'am', label: 'Morning', evidence: 'strong', opts: ['SPF 30–50, reapplied outdoors', 'Vitamin C + SPF', 'Tinted iron-oxide SPF (melasma-prone)'] },
              { key: 'pm', label: 'Night', evidence: 'strong', opts: ['Tretinoin 0.025–0.05%', 'Adapalene 0.1% (breakout-prone)', 'Retinol 0.3–1%', 'Not yet — nothing to treat'] },
              { key: 'support', label: 'Support', evidence: 'moderate', opts: ['Niacinamide 4–5%', 'Azelaic acid 15–20%', 'Neither'] },
              { key: 'clinic', label: 'In-office', evidence: 'strong', opts: ['Toxin for lines at rest', 'Melasma protocol (TXA / azelaic)', 'One laser course for real spots', 'Nothing this year'] },
              { key: 'body', label: 'The body', evidence: 'strong', opts: ['Strength 2–3×/wk', 'Strength + cardio', 'Quit smoking first'] },
              { key: 'skip', label: 'Deliberately skipping', evidence: 'limited', opts: ['Preventive filler', 'Baby Botox', 'Collagen drinks', 'All of the above'] },
            ].map((row) => (
              <div class="routine-row" data-key={row.key}>
                <div class="flex items-center justify-between gap-3 mb-2 flex-wrap">
                  <p class="font-display text-lg">{row.label}</p>
                  <span class={`text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 ${evidencePillClass(row.evidence as Evidence)}`}>{row.evidence}</span>
                </div>
                <div class="flex flex-wrap gap-2">
                  {row.opts.map((opt) => (
                    <button type="button" data-opt={opt} class="routine-opt text-sm px-3 py-1.5 border border-ink/25 hover:border-accent transition">{opt}</button>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div id="routine-summary" class="mt-10 pt-6 border-t border-ink">
            <p class="eyebrow">Your plan</p>
            <p id="routine-empty" class="mt-3 text-ink/60 italic">Pick at least one option above to see your plan.</p>
            <ul id="routine-list" class="mt-3 space-y-2 hidden text-[15px]"></ul>
            <p class="mt-4 text-xs text-ink/50">Stop retinoids when trying to conceive. Review once a year.</p>
          </div>
        </section>

        <!-- ════════════ BUDGET TIERS ════════════ -->
        <section id="compare" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">By budget</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">What each tier buys — and what it doesn't</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">Indicative Western-European figures; the evidence lives almost entirely in the cheapest tier.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {tierRows.map((r) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class={`text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 ${evidencePillClass(r.evidence)}`}>{r.evidence}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.tier}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
                <p class="mt-3 text-xs font-medium text-ink/85">{r.price}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References & further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, meta-analyses, or trial reports, linked inline
            within each section. Primary sources: Annals of Internal Medicine, PubMed/PMC, JAAD,
            BMJ, Plastic and Reconstructive Surgery, British Journal of Dermatology.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Talk to a clinician before prescription
          treatments — and stop retinoids, tranexamic acid and most procedures when planning a
          pregnancy.
        </p>
    </div>

  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    .routine-opt.active {
      background: var(--color-accent);
      color: var(--color-bone);
      border-color: var(--color-accent);
    }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();

      const builder = document.getElementById('routine-builder');
      const list = document.getElementById('routine-list');
      const empty = document.getElementById('routine-empty');
      const selected = {};
      builder?.querySelectorAll('.routine-opt').forEach((btn) => {
        btn.addEventListener('click', () => {
          const row = btn.closest('.routine-row');
          const key = row.getAttribute('data-key');
          row.querySelectorAll('.routine-opt').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          selected[key] = { label: row.querySelector('p').textContent, choice: btn.getAttribute('data-opt') };
          renderRoutine();
        });
      });
      function renderRoutine() {
        const items = Object.values(selected);
        if (!items.length) {
          empty.classList.remove('hidden');
          list.classList.add('hidden');
          return;
        }
        empty.classList.add('hidden');
        list.classList.remove('hidden');
        list.innerHTML = items
          .map((i) => `<li class="flex justify-between gap-3 border-b border-ink/5 py-2 last:border-0"><span class="text-ink/60 text-sm">${i.label}</span><span class="font-medium">${i.choice}</span></li>`)
          .join('');
      }
    })();
  </script>
</BaseLayout>
