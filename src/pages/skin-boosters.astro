---
/**
 * The skin boosters guide (/skin-boosters) — in-clinic layout: evidence
 * strength as the primary visual signal, all content in the DOM, one
 * interactive block (concern matcher), and the boosters compared as cards.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  keyTakeaways,
  groups,
  focusLabels,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/skin-boosters';

const locale = DEFAULT_LOCALE;
const title = 'Skin boosters — Profhilo, Skinboosters, Volite and the rest, graded | DeAging Europe';
const description =
  'Profhilo, Restylane Skinboosters, Juvéderm Volite / Skinvive, Belotero Revive, NCTF 135HA, amino-acid HA, plain HA mesotherapy and polynucleotide boosters graded on their own trials — what a booster can do for hydration, glow, fine lines, hands, neck and eyes, how long it lasts, what it costs in Europe, and what the saline-controlled trials say about "collagen remodelling".';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const evidencePillClass = (e?: Evidence) =>
  e === 'strong'
    ? 'bg-sage/15 text-sage'
    : e === 'moderate'
    ? 'bg-gold/15 text-gold'
    : e === 'emerging'
    ? 'bg-rose/15 text-rose'
    : 'bg-ink/10 text-ink/60';

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

// Bottom-line answer shown in the collapsed FAQ card.
const faqAnswer: Record<string, string> = {
  'faq-which': 'Volite for the trial; plain HA for value',
  'faq-how-long': '3–6 months; hands a year',
  'faq-sessions': '1–3, then 6-monthly',
  'faq-collagen': 'Hydration yes; remodelling no',
  'faq-age': 'When it bothers you',
  'faq-botox': 'Yes',
  'faq-under-eye': 'Crepe a little; hollows no',
  'faq-cost': '€700–2,000 a year',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — concern → recommended rows (anchors must exist in data).
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'Dull, dry, tired-looking skin',
    paths: [
      { id: 'use-hydration-glow', title: 'Hydration and glow', why: 'the core claim, with the class\'s best trials behind it — and one sham-controlled negative' },
      { id: 'prod-volite', title: 'Volite / Skinvive', why: 'the booster with the randomised, evaluator-blind trial; one session' },
      { id: 'prod-plain-ha', title: 'Plain HA mesotherapy', why: 'the best-controlled evidence at the lowest price' },
    ],
  },
  {
    concern: 'Fine lines and crepe on the cheeks',
    paths: [
      { id: 'use-fine-lines', title: 'Fine lines', why: '58% responders against 5% untreated; crepe softens, etched lines do not' },
      { id: 'faq-collagen', title: 'The remodelling question', why: 'the dermis thickened on the saline side too' },
    ],
  },
  {
    concern: 'Crepey, veiny hands',
    paths: [
      { id: 'use-hands', title: 'Hands', why: 'HA beat saline with improvement sustained a year; 87–96% still improved at 15 months' },
      { id: 'prod-skinboosters', title: 'Restylane Skinboosters', why: 'the product behind both hand trials' },
    ],
  },
  {
    concern: 'Neck lines and a crepey chest',
    paths: [
      { id: 'use-neck-chest', title: 'Neck and décolletage', why: 'open-label only, and the site of the persistent nodules on record' },
      { id: 'safety-nodules-reactions', title: 'Nodules and reactions', why: 'why the neck needs an experienced injector' },
    ],
  },
  {
    concern: 'Thin skin under my eyes or around my mouth',
    paths: [
      { id: 'use-eyes-mouth', title: 'Eyes and mouth', why: 'crepe improves modestly; the perioral placebo trial was sobering' },
      { id: 'faq-under-eye', title: 'Hollow, pigment or crepe?', why: 'only crepe is a booster question' },
    ],
  },
  {
    concern: 'Enlarged pores',
    paths: [
      { id: 'use-pores', title: 'Pores', why: 'pore volume fell in a split-face trial, product against product' },
      { id: 'prod-belotero-revive', title: 'Belotero Revive', why: 'the glycerol version cut pore volume 24% more than the plain one' },
    ],
  },
  {
    concern: 'I already have Botox — is a booster worth adding?',
    paths: [
      { id: 'use-combinations', title: 'Combinations', why: 'three randomised trials found toxin plus a booster beat toxin alone' },
      { id: 'faq-botox', title: 'Same day?', why: 'yes, including premixed in one syringe in the 2026 trial' },
    ],
  },
  {
    concern: 'I was offered Profhilo',
    paths: [
      { id: 'prod-profhilo', title: 'Profhilo', why: 'equal to Belotero Revive head to head; dermal thickness no better than saline in its blinded trial' },
      { id: 'safety-nodules-reactions', title: 'Its safety record', why: '0.034% adverse events across a projected million patients' },
    ],
  },
  {
    concern: 'Loose skin on my arms or abdomen',
    paths: [
      { id: 'use-body', title: 'Body boosters', why: 'a single-arm twelve-month study; bruising in nearly everyone' },
      { id: 'prod-untrialled', title: 'What has no trial', why: 'ask for the study before paying for the vial' },
    ],
  },
];

// The boosters compared, as cards.
const productRows = [
  {
    id: 'prod-volite',
    brand: 'Juvéderm Volite / Skinvive',
    evidence: 'moderate' as Evidence,
    blurb: 'Lightly cross-linked Vycross HA; the only booster with a randomised, evaluator-blind trial (58% responders vs 4.5% untreated, six months) and a 2023 US approval. One session; smoothness fades by month six, hydration holds to nine.',
    knownFor: 'The trial; one session',
  },
  {
    id: 'prod-skinboosters',
    brand: 'Restylane Skinboosters',
    evidence: 'moderate' as Evidence,
    blurb: 'Stabilised HA microdroplets, registered in Europe for skin quality; saline-controlled hand data to a year, a 15-month hand trial, a split-face face trial — and the 14-patient sham-controlled cheek trial that found nothing. Three sessions, then six-monthly.',
    knownFor: 'Hands; the longest record',
  },
  {
    id: 'prod-belotero-revive',
    brand: 'Belotero Revive',
    evidence: 'moderate' as Evidence,
    blurb: 'HA with glycerol; firmness to 24 weeks and hydration to 36 in its pivotal study, a randomised pore trial, and a split-face comparison that found it equal to Profhilo. Three sessions a month apart.',
    knownFor: 'Pores; equal to Profhilo',
  },
  {
    id: 'prod-plain-ha',
    brand: 'Plain HA mesotherapy (Redensity I, Viscoderm, Glytone)',
    evidence: 'moderate' as Evidence,
    blurb: 'Non-cross-linked HA in three monthly sessions; beat saline on elasticity and blinded radiance in 55 women and on hand dermal density to ten months. Shortest-lived, cheapest, best-controlled.',
    knownFor: 'Value; the saline trials',
  },
  {
    id: 'prod-amino-acid',
    brand: 'Amino-acid HA (Sunekos, Jalupro)',
    evidence: 'moderate' as Evidence,
    blurb: 'HA with glycine, proline, leucine and lysine; an 11-study meta-analysis and a 439-person randomised trial (97.6% vs 4% untreated, three months). The European brand names have no controlled trials of their own in PubMed.',
    knownFor: 'The class evidence, not the brand\'s',
  },
  {
    id: 'prod-profhilo',
    brand: 'Profhilo',
    evidence: 'emerging' as Evidence,
    blurb: 'Hybrid HA complexes, two sessions; laboratory collagen data, open-label results to six months, equal to Belotero Revive head to head, and a triple-blind saline trial in which dermal thickness "did not exceed the placebo effect". The safest injectable on record.',
    knownFor: 'Marketing; safety; the placebo trial',
  },
  {
    id: 'prod-nctf',
    brand: 'NCTF 135HA (Fillmed)',
    evidence: 'emerging' as Evidence,
    blurb: 'Non-cross-linked HA plus fifty vitamins and amino acids; one manufacturer-funded randomised trial against a face cream, and a 2026 split-face trial premixed with toxin. The cream is not a sham.',
    knownFor: 'The toxin combination',
  },
  {
    id: 'prod-polynucleotides',
    brand: 'Polynucleotides (Rejuran, Plinest, Nucleofill)',
    evidence: 'emerging' as Evidence,
    blurb: 'Salmon-DNA fragments injected like a booster; nine small studies, a phase 3 trial that equalled an HA filler, no placebo-controlled trial. Graded in full in the biostimulator guide.',
    knownFor: 'The non-HA alternative',
  },
  {
    id: 'prod-untrialled',
    brand: 'The rest: Hydro Deluxe, clinic cocktails, PRP and exosome "boosters"',
    evidence: 'limited' as Evidence,
    blurb: 'Sold as boosters, without a controlled trial under the name. Some borrow the class\'s evidence, some another class\'s, some none. Ask for the study.',
    knownFor: 'You are the trial',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="skin-boosters" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO ════════════ -->
    <header class="relative border-b border-ink/10 overflow-hidden">
      <div class="max-w-6xl mx-auto px-6 py-14 md:py-20 grid lg:grid-cols-[1fr_auto] gap-10 items-center">
        <div>
          <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
            Skin boosters, Profhilo to Skinvive<span class="text-rose">.</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg md:text-xl text-ink/75 leading-relaxed">
            Hyaluronic acid for hydration and glow rather than volume &mdash; every booster graded on its own
            trials, what it does for the face, hands, neck and eyes, how long it lasts, what it costs, and what
            the saline-controlled trials say about &ldquo;remodelling&rdquo;.
          </p>
          <p class="mt-3 text-xs text-ink/50">
            Updated 13 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
          </p>
        </div>
        <MediaPlaceholder kind="image" ratio="4/5" label="Hero — microdroplets on a cheek" tone="rose" class="w-full lg:w-72" />
      </div>
      <div class="absolute -right-32 -top-32 w-96 h-96 bg-rose/10 rounded-full blur-3xl pointer-events-none"></div>
    </header>

    <!-- ════════════ TOP-FOLD SUMMARY + INFO DRAWERS ════════════ -->
    <section id="takeaways" class="scroll-mt-32 max-w-6xl mx-auto px-6 py-12 space-y-10">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-sage">The case in five lines</p>
        <h2 class="font-display text-3xl mt-2">If you read nothing else</h2>
        <ol class="mt-5 space-y-3 text-[15px] leading-relaxed text-ink/85 max-w-3xl">
          {keyTakeaways.map((k, i) => (
            <li class="flex gap-3">
              <span class="font-display text-rose w-6 shrink-0">{i + 1}.</span>
              <span>{k}</span>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <MediaPlaceholder kind="video" ratio="16/9" label="Explainer · 2 min" tone="sage" />
      </div>

      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="font-display text-3xl md:text-4xl">{g.title}</h2>
          <div class="mt-6 grid gap-2">
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section class="bg-white border-y border-ink/5">
      <div class="max-w-6xl mx-auto px-6 py-12">

        <div class="mb-10 pt-4">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">The full breakdown</p>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Skin boosters — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="text-xs uppercase tracking-[0.3em] text-sage">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="font-display text-3xl md:text-4xl mt-2">{g.title}</h2>
            {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}

            {g.id === 'uses' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="A booster session: microdroplets by cannula, needle and stamp" tone="rose" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Corneometer and cutometer readings over six months, treated against untreated" tone="bone" />
              </div>
            )}

            <div class="card-grid mt-8 divide-y divide-ink/[0.07] border-y border-ink/[0.07]">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    variant="bar"
                    tag={s.focus && s.focus !== 'general' ? focusLabels[s.focus] : undefined}
                    mediaTone={g.id === 'uses' ? 'rose' : undefined}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="mb-16 scroll-mt-32">
              <p class="text-xs uppercase tracking-[0.3em] text-sage">Editor's choice</p>
              <h2 class="font-display text-3xl md:text-4xl mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">Where the trials, the duration and the price line up best.</p>

              <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
                {[
                  {
                    id: 'prod-volite',
                    kind: 'Best trial',
                    title: 'Volite / Skinvive',
                    blurb: 'The one booster whose result was measured by evaluators who could not see which arm you were in: 58% smoother cheeks against 4.5% untreated, holding six months, in one session. The 2023 US approval rests on it.',
                    tone: 'rose' as const,
                  },
                  {
                    id: 'use-hands',
                    kind: 'Most durable',
                    title: 'The hands',
                    blurb: 'Where boosters beat saline and last: hydration, elasticity and roughness better than placebo at three months and sustained a year; 87–96% of hands still improved at fifteen months in a 100-person trial.',
                    tone: 'sage' as const,
                  },
                  {
                    id: 'prod-plain-ha',
                    kind: 'Best value',
                    title: 'Plain HA mesotherapy',
                    blurb: 'Non-cross-linked HA at a fraction of the branded price, with the best-designed trials in the category behind it: elasticity and blinded radiance better than saline in 55 women. Three monthly sessions; repeat when the glow goes.',
                    tone: 'bone' as const,
                  },
                  {
                    id: 'use-combinations',
                    kind: 'Best with Botox',
                    title: 'The toxin combination',
                    blurb: 'Three randomised trials in which toxin plus a booster outperformed toxin alone — on a full face, at the crow\'s feet, and premixed in one syringe with hydration rising only on the combination side.',
                    tone: 'gold' as const,
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card group flex flex-col bg-white rounded-2xl border border-ink/10 overflow-hidden hover:border-rose hover:shadow-md transition"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} tone={pick.tone} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="text-[10px] uppercase tracking-widest font-semibold text-sage">{pick.kind}</p>
                      <h3 class="font-display text-lg leading-tight mt-1 group-hover:text-rose transition">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="mt-4 inline-flex items-center gap-1 text-xs uppercase tracking-widest font-semibold text-rose group-hover:gap-2 transition-all">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PRODUCTS / REFERENCES ════════════ -->
    <div class="max-w-6xl mx-auto px-6 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="text-xs uppercase tracking-[0.3em] text-sage">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="font-display text-3xl md:text-4xl mt-2">{g.title}</h2>
            {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}
            <div class="mt-8 grid gap-2">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ CONCERN MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 bg-gradient-to-br from-rose/10 via-bone to-sage/5 rounded-2xl p-6 md:p-10 border border-ink/5">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">Interactive</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">Match a booster to your concern</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open your main concern to see where the evidence points &mdash; each link jumps to the graded section.</p>

          <div class="mt-8 grid gap-2">
            {matcher.map((m) => (
              <details class="matcher-item group rounded-2xl border border-ink/10 bg-white px-4 py-3 transition hover:border-rose/40 open:border-rose/40">
                <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
                  <h3 class="font-display text-xl leading-tight group-hover:text-rose group-open:text-rose transition">{m.concern}</h3>
                  <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-rose bg-rose/10 group-open:bg-rose group-open:text-white transition" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="mt-3 pt-3 border-t border-ink/10 space-y-2">
                  {m.paths.map((p) => (
                    <a href={`#${p.id}`} class="block p-3 rounded-xl bg-bone/50 border border-ink/5 hover:border-rose/40 transition">
                      <span class="font-medium text-ink/90">{p.title}</span>
                      <span class="text-ink/60"> — {p.why}</span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE BOOSTERS COMPARED ════════════ -->
        <section id="compare" class="scroll-mt-32 mb-16 bg-white rounded-2xl border border-ink/5 p-6 md:p-8 overflow-hidden">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">The product landscape</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">The boosters compared</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">Nine things sold as skin boosters, from the product with a randomised, evaluator-blind trial to the shelf products with none. Each card is graded on its own evidence, not on the class&rsquo;s claims.</p>

          <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {productRows.map((r) => (
              <a href={`#${r.id}`} class="block p-5 bg-bone/40 rounded-xl border border-ink/5 hover:border-rose/40 hover:shadow-md transition group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class={`text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 rounded-full ${evidencePillClass(r.evidence)}`}>{r.evidence}</span>
                </div>
                <h3 class="font-display text-lg leading-tight group-hover:text-rose">{r.brand}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
                <p class="mt-3 text-xs font-medium text-ink/85">Known for: {r.knownFor}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 bg-white rounded-2xl p-8 border border-ink/5">
          <h2 class="font-display text-3xl">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed randomised trials, systematic reviews, meta-analyses, biopsy and
            instrument studies, post-marketing safety reports or trial registrations, linked inline within each
            section. Primary sources: PubMed/PMC, Dermatologic Surgery, the Journal of Cosmetic Dermatology,
            Aesthetic Plastic Surgery, the Aesthetic Surgery Journal, Plastic and Reconstructive Surgery, Archives of
            Dermatological Research, Clinical, Cosmetic and Investigational Dermatology and ClinicalTrials.gov.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Every injectable here is a medical procedure &mdash; consult a
          registered clinician, disclose your full medical history, and defer treatment during pregnancy or
          breastfeeding. Product names are examples, not endorsements; regulatory status varies by country and is
          stated as of September 2026. Prices are indicative private rates, not quotes.
        </p>
    </div>

  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-rose);
      outline-offset: -2px;
      border-radius: 1rem;
    }

    .card[open] > summary { background: rgba(184,130,109,0.04); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
