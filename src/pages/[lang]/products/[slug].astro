---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductHero from '../../../components/ProductHero.astro';
import ProductActives from '../../../components/ProductActives.astro';
import ProductFacts from '../../../components/ProductFacts.astro';
import ProductStudies from '../../../components/ProductStudies.astro';
import ProductHowTo from '../../../components/ProductHowTo.astro';
import ProductVariants from '../../../components/ProductVariants.astro';
import ProductQuotes from '../../../components/ProductQuotes.astro';
import ProductFaq from '../../../components/ProductFaq.astro';
import ProductStickyBar from '../../../components/ProductStickyBar.astro';
import InfoSection from '../../../components/InfoSection.astro';
import { t, localePath, isLocale } from '../../../i18n/utils';
import { DEFAULT_LOCALE } from '../../../i18n/ui';

// Rendered on demand (Wix hosting): the URL must name a real non-default locale
// and a product that exists in that locale — otherwise 404 (→ src/pages/404.astro).
const { lang, slug } = Astro.params;
if (!isLocale(lang) || lang === DEFAULT_LOCALE) return new Response(null, { status: 404 });
const locale = lang;
const [product] = await getCollection('products', ({ data }) => data.locale === locale && data.slug === slug);
if (!product) return new Response(null, { status: 404 });
const d = product.data;

// Guides are English-only, so ingredient links always point at the English guide.
const guidePath = localePath(DEFAULT_LOCALE, 'collagen');
const cta = d.shopName ? `${t(locale, 'product.buyAt')} ${d.shopName}` : t(locale, 'product.buy');
const symbol = d.currency === 'EUR' ? '€' : `${d.currency} `;
const stickyPriceLine = [
  d.servings ? `${d.servings} ${t(locale, 'product.servings')}` : null,
  d.price && d.servings ? `${symbol}${(Number(d.price) / d.servings).toFixed(2)} ${t(locale, 'product.perServing')}` : null,
].filter(Boolean).join(' · ');

const prices = d.variants.map((v) => Number(v.price));
const offers =
  prices.length > 0
    ? {
        '@type': 'AggregateOffer',
        priceCurrency: d.currency,
        lowPrice: Math.min(...prices).toFixed(2),
        highPrice: Math.max(...prices).toFixed(2),
        offerCount: prices.length,
        availability: 'https://schema.org/InStock',
        url: d.buyUrl,
      }
    : d.price
    ? { '@type': 'Offer', price: d.price, priceCurrency: d.currency, availability: 'https://schema.org/InStock', url: d.buyUrl }
    : undefined;

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.title,
  brand: { '@type': 'Brand', name: d.brand },
  description: d.tagline,
  image: d.gallery.length > 0 ? d.gallery.map((g) => g.src) : d.image,
  ...(offers && { offers }),
};
---
<BaseLayout
  title={d.seoTitle ?? `${d.title} by ${d.brand} | DeAging Europe`}
  description={d.seoDescription ?? d.tagline}
  locale={locale}
  path={`products/${d.slug}`}
  type="product"
  image={d.image}
  jsonLd={productJsonLd}
>
  <ProductHero
    locale={locale}
    brand={d.brand}
    origin={d.origin}
    title={d.title}
    whatItIs={d.whatItIs}
    gallery={d.gallery}
    actives={d.actives}
    variants={d.variants}
    price={d.price}
    currency={d.currency}
    servings={d.servings}
    priceNote={d.priceNote}
    subscription={d.subscription}
    buyUrl={d.buyUrl}
    shopName={d.shopName}
    badges={d.badges}
  />

  <p class="max-w-6xl mx-auto px-6 py-3 text-xs text-ink/50 italic">
    {d.affiliateDisclosure ?? t(locale, 'product.affiliate')}
  </p>

  <ProductActives locale={locale} actives={d.actives} guidePath={guidePath} />
  <ProductFacts locale={locale} facts={d.facts} caveats={d.caveats} />
  <ProductStudies locale={locale} studies={d.studies} guideHref={guidePath} />
  <ProductHowTo locale={locale} howTo={d.howTo} />
  <ProductVariants locale={locale} variants={d.variants} currency={d.currency} subscription={d.subscription} priceNote={d.priceNote} />
  {d.info.length > 0 && <InfoSection blocks={d.info} />}
  <ProductQuotes locale={locale} quotes={d.quotes} note={d.quotesNote} />
  <ProductFaq locale={locale} faq={d.faq} />

  <ProductStickyBar price={d.price} currency={d.currency} buyUrl={d.buyUrl} cta={cta} title={d.title} priceLine={stickyPriceLine} variants={d.variants} />
</BaseLayout>
