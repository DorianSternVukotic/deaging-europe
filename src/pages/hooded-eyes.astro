---
/**
 * The hooded-eyes guide (/hooded-eyes) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video,
 * the three drivers as cards, evidence strength as the primary visual
 * signal, one interactive block (situation matcher) and a month-by-month
 * action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/hooded-eyes';

const locale = DEFAULT_LOCALE;
const title = 'Hooded eyelids and drooping brows — every treatment graded by evidence | DeAging Europe';
const description =
  '"Hooded" is one word for three problems — surplus eyelid skin, a brow that has descended, and a lid margin that has slipped over the eye — and each has a different fix. The finger-and-photograph self-check that sorts them, and eye drops, the toxin brow lift, ultrasound, radiofrequency, filler, blepharoplasty, ptosis repair, browpexy and the brow lift graded by trial evidence, with the millimetres each actually moves and the droop that needs a doctor today.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-finger-test': 'Lift the brow with a finger',
  'faq-botox-hooded': 'Forehead yes; depressors no',
  'faq-drops': 'About a millimetre, for the day',
  'faq-surgery-lasts': 'A decade; the brow comes back',
  'faq-forehead-lines': 'Often — the forehead relaxes',
  'faq-medical': 'The visual-field test decides',
  'faq-nonsurgical-best': 'Drops, toxin, ultrasound — by type',
  'faq-scar': 'In the crease; none inside',
  'faq-cost-ladder': 'Free to €8,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'My lids are heavy and the skin sits on my lashes',
    paths: [
      { id: 'type-lid', title: 'Surplus lid skin', why: 'the fold stays when a finger holds the brow; the margin under it is normal' },
      { id: 'workup', title: 'The finger and the photograph', why: 'most faces over 55 have two types at once' },
      { id: 'surg-blepharoplasty', title: 'Upper blepharoplasty', why: '12 randomised trials, 348-patient quality-of-life gains, a decade of result' },
      { id: 'dev-rf-eyelids', title: 'Radiofrequency, if you will not operate', why: 'up to a quarter of the fold in most of 72 patients' },
    ],
  },
  {
    concern: 'My brows have dropped and my forehead is always raised',
    paths: [
      { id: 'type-brow', title: 'The fallen brow', why: 'hooding that vanishes under a fingertip was never the lid' },
      { id: 'inj-toxin-brow-lift', title: 'Toxin in the depressors — never the forehead', why: 'a few millimetres at the tail for three to four months' },
      { id: 'dev-mfu-brow', title: 'Ultrasound', why: 'about two millimetres in 86–88% in two blinded studies' },
      { id: 'surg-browpexy', title: 'Browpexy with the lids, or a brow lift', why: '2–3 mm held at two years; 3–4 mm from the endoscope' },
    ],
  },
  {
    concern: 'One eye looks sleepy — the lid covers part of the pupil',
    paths: [
      { id: 'type-ptosis', title: 'A slipped lid margin', why: 'under 2.5 mm from the reflection to the lid edge on a flash photograph' },
      { id: 'safety-red-flags', title: 'First, the red flags', why: 'sudden, variable, double vision or an odd pupil is a doctor today' },
      { id: 'inj-drops-oxymetazoline', title: 'The eyelid-lifting drop', why: '1.16 mm against 0.50 on placebo — and a test of the operation' },
      { id: 'surg-ptosis-repair', title: 'Müller\'s-muscle or levator repair', why: 'margin from 1.5 to 3.2 mm in the randomised trial' },
    ],
  },
  {
    concern: 'My upper lids look hollow and sunken',
    paths: [
      { id: 'type-hollow', title: 'The sunken lid', why: 'skin folding into an empty space — the type removal worsens' },
      { id: 'inj-filler-hollow', title: 'Hyaluronic gel or fat under the brow', why: '357 patients improved a grade or more; fat held at six months on ultrasound' },
      { id: 'safety-devices-filler', title: 'Why this zone needs a specialist', why: 'the arteries above the lid connect to the eye' },
    ],
  },
  {
    concern: 'I do not want surgery',
    paths: [
      { id: 'faq-nonsurgical-best', title: 'What non-surgical can honestly do', why: 'a millimetre of margin, a few of brow, a quarter of a fold' },
      { id: 'inj-drops-oxymetazoline', title: 'The drop, if the margin is the problem', why: 'two randomised trials' },
      { id: 'inj-toxin-brow-lift', title: 'The toxin brow lift, if the brow is', why: 'measured in 22 patients and a randomised trial' },
      { id: 'dev-mfu-brow', title: 'Ultrasound, for about two millimetres', why: 'blinded and measured; no wound' },
    ],
  },
  {
    concern: 'My eyelid dropped after Botox',
    paths: [
      { id: 'type-toxin', title: 'The heavy lid after toxin', why: '2% on the label, more in a face whose forehead was load-bearing' },
      { id: 'safety-toxin', title: 'Tell the injector today', why: 'alpha-agonist drops lift the lid 1–3 mm while it wears off' },
      { id: 'inj-drops-oxymetazoline', title: 'Oxymetazoline drops', why: 'the rescue with trials behind it' },
    ],
  },
  {
    concern: 'It came on suddenly, or I see double',
    paths: [
      { id: 'safety-red-flags', title: 'Not cosmetic until a doctor says so', why: 'third nerve, Horner\'s, myasthenia, stroke — the same day' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the finger, the flash photograph, the relaxed forehead and the old picture',
    when: 'Before anything',
    blurb: 'Where the brows sit at rest; whether a fingertip on the outer brow removes the hooding; reflection-to-margin measured on a flash photograph with the brow held; the hollow checked from the side; anything sudden or variable sent to a doctor today.',
  },
  {
    id: 'home-brow-grooming',
    step: 'Day 1 onward: the optical lift, and the forehead left alone',
    when: 'Whatever else you do',
    blurb: 'The brow drawn with its arch at the outer third; no frontalis toxin without the eyelid test; a trial of the eyelid drop if the margin is the problem, which also tells you whether the tendon operation would work.',
  },
  {
    id: 'inj-toxin-brow-lift',
    step: 'Months 1–3: the millimetres without an incision',
    when: 'Judged at two weeks (toxin) to 90 days (devices)',
    blurb: 'Toxin in the brow depressors for the outer-brow hood; ultrasound for about two millimetres of brow; radiofrequency for a mild fold; filler under the brow for the hollow lid — each on the photograph, none on the promise.',
  },
  {
    id: 'surg-blepharoplasty',
    step: 'Month 3 onward: the oculoplastic consultation, and the operation for your type',
    when: 'Once the type is certain',
    blurb: 'Upper blepharoplasty for the fold; a browpexy in the same sitting if the finger test says brow; Müller\'s-muscle or levator repair if the margin sits low; an endoscopic brow lift only for the brow at the lashes — by a surgeon who measures margins and tests the drop.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="hooded-eyes" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Hooded eyelids &amp; drooping brows</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Hooded eyes, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          &ldquo;Hooded&rdquo; is one word for three problems &mdash; surplus eyelid skin, a brow that has come down,
          and a lid margin that has slipped over the eye &mdash; and each has a different fix. Below, the finger-and-photograph
          self-check that sorts them, every treatment from eye drops to the brow lift graded by the trials behind it,
          the millimetres each one actually moves, and the droop that needs a doctor today rather than a clinic.
        </p>
        <p class="meta">
          Updated 8 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Hooded eyes — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'surg' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="The finger test and the flash photograph — sorting lid, brow and margin in two minutes" />
                <MediaPlaceholder kind="image" ratio="16/9" label="The same eye at rest, with the brow lifted by a finger, and a year after the operation the test chose" />
              </div>
            )}

            <div class="chart mt-8">
              <div class="chart-cols" aria-hidden="true"><span>Evidence · 0–4</span><span>Treatment</span><span></span></div>
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic' || g.id === 'surg'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'surg-blepharoplasty',
                    kind: 'For the fold',
                    title: 'Upper blepharoplasty',
                    blurb: 'Twelve randomised trials, a 348-patient quality-of-life trial, halved forehead-muscle activity and fewer headaches; the sight-threatening bleed in 149 of 269,433 operations. The most performed cosmetic operation in the world, for good reason.',
                  },
                  {
                    id: 'inj-drops-oxymetazoline',
                    kind: 'For the slipped margin',
                    title: 'Oxymetazoline eye drops',
                    blurb: 'Two phase 3 trials in 304 people: the lid up 1.16 mm against 0.50 on placebo within minutes, for the day, with the visual-field endpoint met. The first drug for ptosis, and a test of whether surgery would work.',
                  },
                  {
                    id: 'inj-toxin-brow-lift',
                    kind: 'For the outer-brow hood',
                    title: 'The toxin brow lift',
                    blurb: 'Outer brow up 4.83 mm from the canthus in 22 patients, 0.6–2.1 mm in a randomised trial with 97% satisfied — depressors only, never the forehead, every three to four months.',
                  },
                  {
                    id: 'surg-browpexy',
                    kind: 'For the brow, with the lids',
                    title: 'Browpexy',
                    blurb: 'A stitch through the blepharoplasty incision that held the brow 2–3 mm higher at two years while blepharoplasty alone let it fall — the brow problem fixed in the same sitting as the fold.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your eyes</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Sort the type with a finger and a photograph, take the millimetres the non-surgical rungs honestly offer, and buy the operation that matches the type from a surgeon who measures.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, randomised trials, meta-analyses, clinical series, regulatory
            documents or reference texts, linked inline within each section. Primary sources: PubMed/PMC, Plastic
            and Reconstructive Surgery, the Aesthetic Surgery Journal, the American Journal of Ophthalmology,
            Ophthalmic Plastic and Reconstructive Surgery, Clinical Ophthalmology, the Journal of the American Academy
            of Dermatology, Lasers in Surgery and Medicine, Age and Ageing, StatPearls, the FDA label and the ISAPS and
            ASPS procedure statistics.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. A lid that drooped suddenly, that varies through the day, or that
          comes with double vision, an unequal pupil or weakness is a nerve or muscle problem until a doctor says
          otherwise; severe pain or a bulging eye in the hours after eyelid surgery is an emergency; and no device
          or filler goes near the eye except from someone who treats eyes every week.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
