---
/**
 * The sun-damage guide (/sun-damage) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video,
 * the three drivers as cards, evidence strength as the primary visual
 * signal, one interactive block (situation matcher) and a month-by-month
 * action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/sun-damage';

const locale = DEFAULT_LOCALE;
const title = 'Sun damage (photoaging) — every treatment graded by evidence | DeAging Europe';
const description =
  'Sun damage is four problems on one patch of skin — leathery texture, brown spots, red vessels and precancerous patches — sitting on a cancer field. The self-checks that sort them, sunscreen to retinoids to light, lasers, fluorouracil and photodynamic therapy graded by trial evidence, and the cancer numbers stated plainly.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-reverse': 'Partly, in layers',
  'faq-spf': 'Either, applied properly',
  'faq-indoors': 'By glass and in cars, yes',
  'faq-vitamin-d': 'A little; take the tablet',
  'faq-ak': 'A precancer; get it seen',
  'faq-tan': 'No; SPF 3 at best',
  'faq-darker-skin': 'Pigment, not burns',
  'faq-timeline': '12 weeks to a year',
  'faq-cost-ladder': '€15 / month to €3,500',
  'faq-prevent': 'Ordinary days',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'Leathery, coarsely wrinkled, sallow skin',
    paths: [
      { id: 'type-textural', title: 'The elastotic type', why: 'the dermis has swapped elastin for solar debris' },
      { id: 'home-retinoid', title: 'A prescription retinoid', why: 'the one cream licensed for photodamage — collagen restored on biopsy' },
      { id: 'clinic-ablative', title: 'Ablative resurfacing', why: 'rebuilds the surface, once the field is checked' },
      { id: 'clinic-nafl', title: 'Or non-ablative fractional', why: 'softer, safer in darker skin, three sessions' },
    ],
  },
  {
    concern: 'Brown spots and blotchy colour on my face, chest or hands',
    paths: [
      { id: 'type-pigment', title: 'Pigment', why: 'melanocytes the sun switched on' },
      { id: 'home-sunscreen', title: 'Sunscreen first', why: 'pigmentation improved 40–52% in a year on its own' },
      { id: 'clinic-ipl', title: 'Intense pulsed light', why: 'pigmentation improved in 59–71% in the blinded trial' },
      { id: 'clinic-qs-laser', title: 'Or a Q-switched laser per spot', why: 'after a dermatoscope has looked' },
    ],
  },
  {
    concern: 'A red, veiny, mottled neck and chest',
    paths: [
      { id: 'type-vascular', title: 'Poikiloderma of Civatte', why: 'a lifetime of open collars' },
      { id: 'clinic-chest-hands', title: 'Intense pulsed light at neck settings', why: 'more than 80% clearance in a 175-patient series' },
      { id: 'home-shade-clothing', title: 'A collar and a brim afterward', why: 'the neck lost 96% of its dose under a three-inch brim' },
    ],
  },
  {
    concern: 'Rough, scaly patches that flake and come back',
    paths: [
      { id: 'type-precancer', title: 'Actinic keratoses', why: 'a precancerous field, felt before it is seen' },
      { id: 'rx-skin-check', title: 'A dermatologist first', why: 'the carcinoma at the keratosis, two years in' },
      { id: 'rx-5fu', title: 'Fluorouracil for the field', why: 'carcinomas needing surgery down 75% in the year after' },
      { id: 'rx-pdt', title: 'Or photodynamic therapy', why: 'the field cleared with less downtime, and the skin smoothed' },
    ],
  },
  {
    concern: "I've already had a skin cancer",
    paths: [
      { id: 'rx-skin-check', title: 'The yearly look', why: 'the precondition for everything cosmetic' },
      { id: 'home-sunscreen', title: 'Daily sunscreen, generously', why: 'the trial that cut carcinomas and melanomas' },
      { id: 'home-nicotinamide', title: 'Nicotinamide', why: 'new skin cancers down 23% in the phase 3 trial' },
      { id: 'rx-5fu', title: 'A fluorouracil course', why: 'the veterans’ trial population was exactly you' },
    ],
  },
  {
    concern: 'Darker skin, and patches that keep getting darker',
    paths: [
      { id: 'type-skin-of-color', title: 'Visible-light pigmentation', why: 'ordinary sunscreen does not prevent it' },
      { id: 'home-sunscreen', title: 'Tinted iron-oxide sunscreen', why: 'the only formulation that blocked visible light in the studies' },
      { id: 'faq-darker-skin', title: 'What applies and what does not', why: 'gentler devices, the same retinoids, palms and soles checked' },
    ],
  },
  {
    concern: "I'm 25 and want to avoid all of this",
    paths: [
      { id: 'dose-habits', title: 'Where the dose comes from', why: 'Tuesdays, side windows and sunbeds' },
      { id: 'home-sunscreen', title: 'Sunscreen every morning', why: 'the habit with cancer trials' },
      { id: 'home-shade-clothing', title: 'A brim, shade and a window film', why: 'the half of photoprotection people forget' },
      { id: 'home-vitamin-d', title: 'Vitamin D from a bottle', why: 'removes the only medical argument for sun' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the arm test, the fingertip test, the photograph — and the skin check',
    when: 'Before any treatment',
    blurb: 'Texture, pigment, vessels or rough patches; a daylight photograph of face, neck, chest and hands; a dermatologist’s look for anyone with a field, a sunbed past or a previous cancer.',
  },
  {
    id: 'home-sunscreen',
    step: 'Day 1 onward: stop the dose, start the repair',
    when: 'Whatever else you do',
    blurb: 'Broad-spectrum SPF 30+ every morning to the face, neck, ears, chest and hands; a brim; vitamin D from a bottle; a retinoid two nights a week, building to nightly.',
  },
  {
    id: 'rx-5fu',
    step: 'Months 1–3: treat the field, then pick the machine by the sign',
    when: 'Field first',
    blurb: 'Fluorouracil or photodynamic therapy for keratoses; then intense pulsed light for colour, or resurfacing for texture — never on skin that has not been looked at.',
  },
  {
    id: 'rx-skin-check',
    step: 'Every year: the look, the sunscreen audit, the maintenance',
    when: 'For life',
    blurb: 'A yearly skin check for anyone with a field; a light session for colour that has crept back; the retinoid and the sunscreen that keep it from creeping.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="sun-damage" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Sun damage (photoaging)</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Sun damage, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          Four problems on one patch of skin &mdash; leathery texture, brown spots, red vessels and precancerous
          patches &mdash; sitting on a cancer field. Below, the self-checks that sort them, every treatment from
          sunscreen to retinoids to light, lasers and the field therapies graded by the trials behind it, and the
          cancer numbers stated plainly.
        </p>
        <p class="meta">
          Updated 7 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Sun damage — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'clinic' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="Light for colour, lasers for texture — what each machine targets and at what depth" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Inner arm against back of hand — the same person, the same decade, one of them in the sun" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'home-sunscreen',
                    kind: 'The base',
                    title: 'Daily broad-spectrum sunscreen',
                    blurb: 'Carcinomas down 39%, invasive melanomas down 73%, measured aging down 24% in the randomised Nambour cohort — and existing damage 40–52% better in a year.',
                  },
                  {
                    id: 'home-retinoid',
                    kind: 'For texture',
                    title: 'A prescription retinoid',
                    blurb: 'The one cream licensed for photodamage: eight randomised tretinoin trials, a 563-patient tazarotene trial, collagen restored on biopsy.',
                  },
                  {
                    id: 'clinic-ipl',
                    kind: 'For colour',
                    title: 'Intense pulsed light',
                    blurb: 'Telangiectasia improved in about 80% and pigmentation in 60–70% of faces in a blinded split-face trial — and wrinkles in none of them.',
                  },
                  {
                    id: 'rx-5fu',
                    kind: 'For the field',
                    title: 'A course of fluorouracil',
                    blurb: 'Two to four weeks of cream cut squamous-cell carcinomas needing surgery by 75% in the year after, in 932 veterans with prior cancers.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your skin</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Stop the dose, check the field, repair the surface, treat colour and texture by the sign, look again every year.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, randomised trials, meta-analyses or clinical series, linked inline
            within each section. Primary sources: PubMed/PMC, The Lancet, the New England Journal of Medicine, the
            Journal of Clinical Oncology, JAMA Dermatology, Archives of Dermatology, the British Journal of
            Dermatology, Dermatologic Surgery and the Journal of Drugs in Dermatology.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Sun-damaged skin is a cancer field: any patch that thickens,
          bleeds, hurts or will not heal, and any spot with an irregular edge, several colours or a recent change,
          needs a dermatologist before it needs a laser &mdash; and every light or laser treatment on this page belongs
          to skin that has been examined first.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
