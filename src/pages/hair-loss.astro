---
/**
 * The hair-loss guide (/hair-loss) — problem-template variant of the
 * collagen-guide layout: a short problem-first intro, evidence strength as the
 * primary visual signal, one interactive block (situation matcher) and a
 * month-by-month action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { guideMeta, formatDate } from '../data/guides';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/hair-loss';

const locale = DEFAULT_LOCALE;
const guide = guideMeta('hair-loss');
const title = 'Hair loss — every treatment graded by evidence | DeAging Europe';
const description =
  'Thinning, shedding, a widening part or receding temples — why it happens, every treatment from minoxidil to transplant graded by trial evidence, and a plan matched to your type of hair loss.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-regrow': 'Partly, if early',
  'faq-timeline': '3–6 months',
  'faq-forever': 'Yes, for pattern loss',
  'faq-minoxidil-women': 'Yes; some fuzz',
  'faq-stress': 'Yes, temporarily',
  'faq-vitamins': 'Only if deficient',
  'faq-hrt': 'Not reliably',
  'faq-camouflage': 'Fibers, SMP, a cut',
  'faq-transplant-permanent': 'The grafts, yes',
  'faq-postpartum': 'Usually wait',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'A widening part or a thinner ponytail (woman, before menopause)',
    paths: [
      { id: 'home-minoxidil', title: '5% minoxidil foam, once a day', why: 'the base — strong evidence in women, twice the regrowth rate of placebo' },
      { id: 'rx-spironolactone', title: 'Add spironolactone', why: 'the workhorse anti-androgen; two in three improve when it is combined with minoxidil' },
      { id: 'clinic-microneedling', title: 'Microneedling on top', why: 'roughly doubles what minoxidil does alone in a dozen trials' },
    ],
  },
  {
    concern: 'Thinning that appeared or accelerated around perimenopause',
    paths: [
      { id: 'menopause', title: 'Read this first', why: 'what estrogen actually does to the follicle, and why HRT is not the fix' },
      { id: 'home-minoxidil', title: '5% minoxidil foam', why: 'first-line at any age' },
      { id: 'rx-oral-minoxidil', title: 'Low-dose oral minoxidil', why: 'if the foam is unworkable — 1 mg matched topical in women' },
      { id: 'safety-red-flags', title: 'Rule out a scarring hairline', why: 'frontal fibrosing alopecia clusters in exactly these years' },
    ],
  },
  {
    concern: 'Receding temples or a thinning crown (man)',
    paths: [
      { id: 'rx-finasteride-men', title: 'Finasteride 1 mg', why: '93% lower odds of further visible loss over five years' },
      { id: 'home-minoxidil', title: 'Plus 5% minoxidil', why: 'the combination beats either alone' },
      { id: 'clinic-transplant', title: 'A transplant once the loss is controlled', why: 'permanent grafts — but only after the medicine has stabilised the rest' },
    ],
  },
  {
    concern: 'Handfuls of hair 2–3 months after illness, birth, surgery, a diet or a GLP-1',
    paths: [
      { id: 'type-shedding', title: 'Telogen effluvium', why: 'the follicles are intact and it resolves in 3–6 months' },
      { id: 'home-iron-vitd', title: 'Test ferritin, thyroid, vitamin D', why: 'the deficiencies that prolong a shed' },
      { id: 'faq-postpartum', title: 'Should I treat at all?', why: 'usually wait — and what to do if it drags past six months' },
    ],
  },
  {
    concern: 'Round bald patches, or eyebrow / beard loss',
    paths: [
      { id: 'type-areata', title: 'Alopecia areata', why: 'autoimmune — minoxidil and finasteride are the wrong tools' },
      { id: 'rx-jak', title: 'JAK inhibitors', why: 'the first drugs with phase 3 evidence, EU-approved for severe disease' },
    ],
  },
  {
    concern: 'A hairline creeping back with itch, redness, shiny skin or thinning eyebrows',
    paths: [
      { id: 'type-scarring', title: 'Scarring alopecia', why: 'hair lost is lost for good — the aim is to stop the fire' },
      { id: 'safety-red-flags', title: 'See a dermatologist within weeks', why: 'a six-month wait costs hair you cannot get back' },
    ],
  },
  {
    concern: 'Thinning at the edges from tight styles, braids or extensions',
    paths: [
      { id: 'type-traction', title: 'Traction alopecia', why: 'fully reversible early, scarred after years — loosen everything now' },
      { id: 'home-minoxidil', title: 'Minoxidil for the recoverable phase', why: 'helps follicles that are still alive' },
    ],
  },
  {
    concern: 'I want coverage now, not in six months',
    paths: [
      { id: 'faq-camouflage', title: 'Fibers, sprays, a blunter cut, a topper, SMP', why: 'instant, invisible, and none interferes with treatment' },
      { id: 'clinic-transplant', title: 'A transplant, if the loss is stable', why: 'the only permanent restoration — twelve months to the final result' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: diagnose and photograph',
    when: 'Before buying anything',
    blurb: 'Pull test, part or crown photo in the same light, and — if you are shedding — ferritin, TSH, vitamin D.',
  },
  {
    id: 'safety-minoxidil',
    step: 'Weeks 2–8: the shed',
    when: 'Minoxidil, oral or topical',
    blurb: 'Old resting hairs leave early. It means the drug is working, not failing — the commonest reason people quit.',
  },
  {
    id: 'faq-timeline',
    step: 'Months 3–6: first change',
    when: 'Compare photos, not mirrors',
    blurb: 'Less shedding first, then fine regrowth at the part; density you can photograph by month six.',
  },
  {
    id: 'faq-forever',
    step: 'Month 12: judge, then maintain',
    when: 'Decide with your dermatologist',
    blurb: 'Keep what works, add the next tier if not. Stopping returns you to baseline within 3–6 months.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="hair-loss" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Hair loss</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Hair loss, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          Thinning hair isn't random &mdash; and it is rarely just one thing. By 50, about 40% of women and half of
          men show pattern hair loss, and most start treating it years late. Below, every treatment is graded by the
          trials behind it, then matched to your type of loss.
        </p>
        <p class="meta">
          Updated <time datetime={guide.updated}>{formatDate(guide.updated)}</time> · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Hair loss — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'rx' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="Minoxidil, finasteride, spironolactone — how each works" />
                <MediaPlaceholder kind="image" ratio="16/9" label="The four types of hair loss, mapped" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">The base, the add-on, and the two prescriptions the evidence actually earns.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'home-minoxidil',
                    kind: 'The base',
                    title: '5% minoxidil, every day',
                    blurb: 'Over the counter, strong evidence in both sexes, and the thing everything else is added to. Foam, once a day, on a dry scalp.',
                  },
                  {
                    id: 'rx-spironolactone',
                    kind: 'For women',
                    title: 'Spironolactone — or oral minoxidil',
                    blurb: 'The anti-androgen that two in three women improve on with minoxidil; oral minoxidil when the foam is unworkable.',
                  },
                  {
                    id: 'rx-finasteride-men',
                    kind: 'For men',
                    title: 'Finasteride (or dutasteride)',
                    blurb: 'The deepest evidence in the field: 93% lower odds of further visible loss over five years. Read the safety drawer first.',
                  },
                  {
                    id: 'clinic-microneedling',
                    kind: 'The upgrade',
                    title: 'Microneedling on top of minoxidil',
                    blurb: 'A dozen randomised trials: needling roughly doubles what minoxidil achieves alone. Cheap at home, better in clinic.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your hair loss</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Most people quit in week four, exactly when the drug starts to work.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, guideline documents or regulatory notices, linked
            inline within each section. Primary sources: PubMed/PMC, the Cochrane Library, the European
            S3 guideline on androgenetic alopecia, JAMA Dermatology, the Journal of the American Academy
            of Dermatology, JEADV, and EMA and FDA documents.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Finasteride, dutasteride and the oral anti-androgens
          must not be used in pregnancy; oral minoxidil needs a prescriber who checks blood pressure;
          and a receding hairline with itch, redness or eyebrow loss should be seen by a dermatologist
          within weeks, not months.
        </p>
    </div>

  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
