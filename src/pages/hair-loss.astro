---
/**
 * The hair-loss guide (/hair-loss) — problem-template variant of the
 * collagen-guide layout: a short problem-first intro, evidence strength as the
 * primary visual signal, one interactive block (situation matcher) and a
 * month-by-month action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  keyTakeaways,
  groups,
  focusLabels,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/hair-loss';

const locale = DEFAULT_LOCALE;
const title = 'Hair loss — every treatment graded by evidence | DeAging Europe';
const description =
  'Thinning, shedding, a widening part or receding temples — why it happens, every treatment from minoxidil to transplant graded by trial evidence, and a plan matched to your type of hair loss.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-regrow': 'Partly, if early',
  'faq-timeline': '3–6 months',
  'faq-forever': 'Yes, for pattern loss',
  'faq-minoxidil-women': 'Yes; some fuzz',
  'faq-stress': 'Yes, temporarily',
  'faq-vitamins': 'Only if deficient',
  'faq-hrt': 'Not reliably',
  'faq-camouflage': 'Fibers, SMP, a cut',
  'faq-transplant-permanent': 'The grafts, yes',
  'faq-postpartum': 'Usually wait',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Short intro — the three drivers, Nutrafol-style but clinical.
const drivers = [
  {
    id: 'three-drivers',
    kind: 'Hormones',
    title: 'DHT, and the estrogen that used to buffer it',
    blurb: 'Genetically sensitive follicles shrink under DHT. In women the signal gets louder when estrogen falls — which is why thinning so often starts at 45–55.',
  },
  {
    id: 'why-early',
    kind: 'Time',
    title: 'A growth phase that keeps getting shorter',
    blurb: 'Pattern loss is progressive by definition. Treatments stop it far more reliably than they rebuild it, so the value of starting is the hair you keep.',
  },
  {
    id: 'type-shedding',
    kind: 'Shocks',
    title: 'Birth, fever, surgery, crash diets, GLP-1s, grief',
    blurb: 'A shock pushes follicles into rest all at once; two to three months later they shed together. Alarming — and self-limiting.',
  },
];

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'A widening part or a thinner ponytail (woman, before menopause)',
    paths: [
      { id: 'home-minoxidil', title: '5% minoxidil foam, once a day', why: 'the base — strong evidence in women, twice the regrowth rate of placebo' },
      { id: 'rx-spironolactone', title: 'Add spironolactone', why: 'the workhorse anti-androgen; two in three improve when it is combined with minoxidil' },
      { id: 'clinic-microneedling', title: 'Microneedling on top', why: 'roughly doubles what minoxidil does alone in a dozen trials' },
    ],
  },
  {
    concern: 'Thinning that appeared or accelerated around perimenopause',
    paths: [
      { id: 'menopause', title: 'Read this first', why: 'what estrogen actually does to the follicle, and why HRT is not the fix' },
      { id: 'home-minoxidil', title: '5% minoxidil foam', why: 'first-line at any age' },
      { id: 'rx-oral-minoxidil', title: 'Low-dose oral minoxidil', why: 'if the foam is unworkable — 1 mg matched topical in women' },
      { id: 'safety-red-flags', title: 'Rule out a scarring hairline', why: 'frontal fibrosing alopecia clusters in exactly these years' },
    ],
  },
  {
    concern: 'Receding temples or a thinning crown (man)',
    paths: [
      { id: 'rx-finasteride-men', title: 'Finasteride 1 mg', why: '93% lower odds of further visible loss over five years' },
      { id: 'home-minoxidil', title: 'Plus 5% minoxidil', why: 'the combination beats either alone' },
      { id: 'clinic-transplant', title: 'A transplant once the loss is controlled', why: 'permanent grafts — but only after the medicine has stabilised the rest' },
    ],
  },
  {
    concern: 'Handfuls of hair 2–3 months after illness, birth, surgery, a diet or a GLP-1',
    paths: [
      { id: 'type-shedding', title: 'Telogen effluvium', why: 'the follicles are intact and it resolves in 3–6 months' },
      { id: 'home-iron-vitd', title: 'Test ferritin, thyroid, vitamin D', why: 'the deficiencies that prolong a shed' },
      { id: 'faq-postpartum', title: 'Should I treat at all?', why: 'usually wait — and what to do if it drags past six months' },
    ],
  },
  {
    concern: 'Round bald patches, or eyebrow / beard loss',
    paths: [
      { id: 'type-areata', title: 'Alopecia areata', why: 'autoimmune — minoxidil and finasteride are the wrong tools' },
      { id: 'rx-jak', title: 'JAK inhibitors', why: 'the first drugs with phase 3 evidence, EU-approved for severe disease' },
    ],
  },
  {
    concern: 'A hairline creeping back with itch, redness, shiny skin or thinning eyebrows',
    paths: [
      { id: 'type-scarring', title: 'Scarring alopecia', why: 'hair lost is lost for good — the aim is to stop the fire' },
      { id: 'safety-red-flags', title: 'See a dermatologist within weeks', why: 'a six-month wait costs hair you cannot get back' },
    ],
  },
  {
    concern: 'Thinning at the edges from tight styles, braids or extensions',
    paths: [
      { id: 'type-traction', title: 'Traction alopecia', why: 'fully reversible early, scarred after years — loosen everything now' },
      { id: 'home-minoxidil', title: 'Minoxidil for the recoverable phase', why: 'helps follicles that are still alive' },
    ],
  },
  {
    concern: 'I want coverage now, not in six months',
    paths: [
      { id: 'faq-camouflage', title: 'Fibers, sprays, a blunter cut, a topper, SMP', why: 'instant, invisible, and none interferes with treatment' },
      { id: 'clinic-transplant', title: 'A transplant, if the loss is stable', why: 'the only permanent restoration — twelve months to the final result' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: diagnose and photograph',
    when: 'Before buying anything',
    blurb: 'Pull test, part or crown photo in the same light, and — if you are shedding — ferritin, TSH, vitamin D.',
  },
  {
    id: 'safety-minoxidil',
    step: 'Weeks 2–8: the shed',
    when: 'Minoxidil, oral or topical',
    blurb: 'Old resting hairs leave early. It means the drug is working, not failing — the commonest reason people quit.',
  },
  {
    id: 'faq-timeline',
    step: 'Months 3–6: first change',
    when: 'Compare photos, not mirrors',
    blurb: 'Less shedding first, then fine regrowth at the part; density you can photograph by month six.',
  },
  {
    id: 'faq-forever',
    step: 'Month 12: judge, then maintain',
    when: 'Decide with your dermatologist',
    blurb: 'Keep what works, add the next tier if not. Stopping returns you to baseline within 3–6 months.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="hair-loss" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO + THE SHORT VERSION (one opening block) ════════════ -->
    <header class="relative border-b border-ink/10 overflow-hidden">
      <div class="max-w-6xl mx-auto px-6 pt-14 md:pt-20 pb-12">
        <p class="text-xs uppercase tracking-[0.3em] text-sage mb-4">Problem · Hair loss</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Hair loss, honestly<span class="text-rose">.</span>
        </h1>
        <p class="mt-3 text-xs text-ink/50">
          Updated 5 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-14">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">The short version</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2 max-w-3xl leading-tight">Thinning hair isn't random &mdash; and it is rarely just one thing.</h2>
          <p class="mt-4 max-w-3xl text-lg text-ink/75 leading-relaxed">
            By 50, about 40% of women and half of men show pattern hair loss, and most start treating it years late.
            Three drivers explain almost every case &mdash; each with a different fix. Below, every treatment is graded
            by the trials behind it, then matched to your type of loss.
          </p>
          <div class="mt-8 grid md:grid-cols-3 gap-4">
            {drivers.map((d) => (
              <a href={`#${d.id}`} class="group block p-5 bg-white rounded-2xl border border-ink/10 hover:border-rose/40 hover:shadow-md transition">
                <p class="text-[10px] uppercase tracking-widest font-semibold text-sage">{d.kind}</p>
                <h3 class="font-display text-xl leading-tight mt-1 group-hover:text-rose transition">{d.title}</h3>
                <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
      <div class="absolute -right-32 -top-32 w-96 h-96 bg-rose/10 rounded-full blur-3xl pointer-events-none"></div>
    </header>

    <!-- ════════════ TOP-FOLD SUMMARY + INFO DRAWERS ════════════ -->
    <section id="takeaways" class="scroll-mt-32 max-w-6xl mx-auto px-6 py-12 space-y-10">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-sage">The case in five lines</p>
        <h2 class="font-display text-3xl mt-2">If you read nothing else</h2>
        <ol class="mt-5 space-y-3 text-[15px] leading-relaxed text-ink/85 max-w-3xl">
          {keyTakeaways.map((k, i) => (
            <li class="flex gap-3">
              <span class="font-display text-rose w-6 shrink-0">{i + 1}.</span>
              <span>{k}</span>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <MediaPlaceholder kind="video" ratio="16/9" label="Explainer · 2 min" tone="sage" />
      </div>

      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="font-display text-3xl md:text-4xl">{g.title}</h2>
          <div class="mt-6 grid gap-2">
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section class="bg-white border-y border-ink/5">
      <div class="max-w-6xl mx-auto px-6 py-12">

        <div class="mb-10 pt-4">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">The full breakdown</p>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Hair loss — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="text-xs uppercase tracking-[0.3em] text-sage">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="font-display text-3xl md:text-4xl mt-2">{g.title}</h2>
            {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}

            {g.id === 'rx' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="Minoxidil, finasteride, spironolactone — how each works" tone="rose" />
                <MediaPlaceholder kind="image" ratio="16/9" label="The four types of hair loss, mapped" tone="bone" />
              </div>
            )}

            <div class="card-grid mt-8 divide-y divide-ink/[0.07] border-y border-ink/[0.07]">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    variant="bar"
                    tag={s.focus && s.focus !== 'general' ? focusLabels[s.focus] : undefined}
                    mediaTone={g.id === 'clinic' ? 'rose' : undefined}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="mb-16 scroll-mt-32">
              <p class="text-xs uppercase tracking-[0.3em] text-sage">Editor's choice</p>
              <h2 class="font-display text-3xl md:text-4xl mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">The base, the add-on, and the two prescriptions the evidence actually earns.</p>

              <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
                {[
                  {
                    id: 'home-minoxidil',
                    kind: 'The base',
                    title: '5% minoxidil, every day',
                    blurb: 'Over the counter, strong evidence in both sexes, and the thing everything else is added to. Foam, once a day, on a dry scalp.',
                    tone: 'sage' as const,
                  },
                  {
                    id: 'rx-spironolactone',
                    kind: 'For women',
                    title: 'Spironolactone — or oral minoxidil',
                    blurb: 'The anti-androgen that two in three women improve on with minoxidil; oral minoxidil when the foam is unworkable.',
                    tone: 'rose' as const,
                  },
                  {
                    id: 'rx-finasteride-men',
                    kind: 'For men',
                    title: 'Finasteride (or dutasteride)',
                    blurb: 'The deepest evidence in the field: 93% lower odds of further visible loss over five years. Read the safety drawer first.',
                    tone: 'gold' as const,
                  },
                  {
                    id: 'clinic-microneedling',
                    kind: 'The upgrade',
                    title: 'Microneedling on top of minoxidil',
                    blurb: 'A dozen randomised trials: needling roughly doubles what minoxidil achieves alone. Cheap at home, better in clinic.',
                    tone: 'bone' as const,
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card group flex flex-col bg-white rounded-2xl border border-ink/10 overflow-hidden hover:border-rose hover:shadow-md transition"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} tone={pick.tone} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="text-[10px] uppercase tracking-widest font-semibold text-sage">{pick.kind}</p>
                      <h3 class="font-display text-lg leading-tight mt-1 group-hover:text-rose transition">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="mt-4 inline-flex items-center gap-1 text-xs uppercase tracking-widest font-semibold text-rose group-hover:gap-2 transition-all">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-6xl mx-auto px-6 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="text-xs uppercase tracking-[0.3em] text-sage">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="font-display text-3xl md:text-4xl mt-2">{g.title}</h2>
            {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}
            <div class="mt-8 grid gap-2">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 bg-gradient-to-br from-rose/10 via-bone to-sage/5 rounded-2xl p-6 md:p-10 border border-ink/5">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">Interactive</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">Match a plan to your hair loss</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid gap-2">
            {matcher.map((m) => (
              <details class="matcher-item group rounded-2xl border border-ink/10 bg-white px-4 py-3 transition hover:border-rose/40 open:border-rose/40">
                <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
                  <h3 class="font-display text-xl leading-tight group-hover:text-rose group-open:text-rose transition">{m.concern}</h3>
                  <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-rose bg-rose/10 group-open:bg-rose group-open:text-white transition" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="mt-3 pt-3 border-t border-ink/10 space-y-2">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="flex gap-3 p-3 rounded-xl bg-bone/50 border border-ink/5 hover:border-rose/40 transition">
                      <span class="font-display text-rose w-5 shrink-0">{i + 1}.</span>
                      <span>
                        <span class="font-medium text-ink/90">{p.title}</span>
                        <span class="text-ink/60"> — {p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 bg-white rounded-2xl border border-ink/5 p-6 md:p-8 overflow-hidden">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">The action plan</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Most people quit in week four, exactly when the drug starts to work.</p>

          <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="block p-5 bg-bone/40 rounded-xl border border-ink/5 hover:border-rose/40 hover:shadow-md transition group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display text-2xl text-rose leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 rounded-full bg-sage/15 text-sage">{r.when}</span>
                </div>
                <h3 class="font-display text-lg leading-tight group-hover:text-rose">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 bg-white rounded-2xl p-8 border border-ink/5">
          <h2 class="font-display text-3xl">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, guideline documents or regulatory notices, linked
            inline within each section. Primary sources: PubMed/PMC, the Cochrane Library, the European
            S3 guideline on androgenetic alopecia, JAMA Dermatology, the Journal of the American Academy
            of Dermatology, JEADV, and EMA and FDA documents.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Finasteride, dutasteride and the oral anti-androgens
          must not be used in pregnancy; oral minoxidil needs a prescriber who checks blood pressure;
          and a receding hairline with itch, redness or eyebrow loss should be seen by a dermatologist
          within weeks, not months.
        </p>
    </div>

    <!-- ════════════ CLINICIAN CTA ════════════ -->
    <div class="sticky bottom-4 z-30 max-w-6xl mx-auto px-6 pointer-events-none">
      <div class="ml-auto max-w-md p-4 bg-ink text-bone rounded-2xl shadow-2xl flex items-center justify-between gap-3 pointer-events-auto hidden md:flex">
        <p class="text-sm">Want personalized advice? <span class="text-bone/70">Speak with a clinician.</span></p>
        <a href="#" class="text-xs px-3 py-1.5 rounded-full bg-rose text-bone font-medium hover:bg-rose/90 transition whitespace-nowrap">Book a call</a>
      </div>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-rose);
      outline-offset: -2px;
      border-radius: 1rem;
    }

    .card[open] > summary { background: rgba(184,130,109,0.04); }

    .prose-anti :global(p) { margin-block: 0.85em; line-height: 1.7; }
    .prose-anti :global(p:first-child) { margin-top: 0; }
    .prose-anti :global(a) {
      color: var(--color-rose);
      text-decoration: underline;
      text-decoration-color: rgba(184,130,109,0.4);
      text-underline-offset: 2px;
    }
    .prose-anti :global(h4) { font-size: 1.125rem; margin-top: 1.5em; margin-bottom: 0.5em; font-family: var(--font-display); }
    .prose-anti :global(ul), .prose-anti :global(ol) { margin-block: 0.85em; padding-left: 1.5em; }
    .prose-anti :global(ul) { list-style: disc; }
    .prose-anti :global(ol) { list-style: decimal; }
    .prose-anti :global(li) { margin-block: 0.35em; line-height: 1.65; }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
