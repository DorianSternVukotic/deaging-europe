---
/**
 * The marionette-lines guide (/marionette-lines) — problem-template variant
 * of the collagen-guide layout: title, description, a full-width explainer
 * video, the three drivers as cards, evidence strength as the primary visual
 * signal, one interactive block (situation matcher) and a month-by-month
 * action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/marionette-lines';

const locale = DEFAULT_LOCALE;
const title = 'Marionette lines (downturned mouth corners) — every treatment graded by evidence | DeAging Europe';
const description =
  'A marionette line is a trench between a muscle that pulls the corner down and a ligament that pins the skin to the jaw, with the jowl heaping into it and the chin shrinking underneath. The "e" test that sorts them, toxin, filler, chin support, threads, devices and surgery graded by trial evidence, and the lopsided smile in numbers.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-sad': 'Corners below horizontal',
  'faq-botox-or-filler': 'Both, toxin first',
  'faq-how-long': '51% at six months',
  'faq-chin': 'If the chin is receded',
  'faq-facelift': 'Improves; can recur',
  'faq-threads': 'Rarely',
  'faq-corner-lift': 'Yes, with a scar',
  'faq-prevent': 'Partly',
  'faq-timeline': 'A week to a year',
  'faq-cost-ladder': '€150 / round to €20,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'My mouth corners turn down and I look sad or angry at rest',
    paths: [
      { id: 'type-muscle', title: 'The sad mouth', why: 'the depressor anguli oris has won — the "e" test confirms it' },
      { id: 'inj-dao-toxin', title: 'Toxin in the depressor', why: 'the one injectable that lifts the angle, for 6–9 months' },
      { id: 'inj-combo', title: 'Then filler, two weeks later', why: 'the combination outlasted filler alone in the split-face trial' },
    ],
  },
  {
    concern: 'A trench from the corner to the chin with a jowl leaning into it',
    paths: [
      { id: 'type-descent', title: 'Descent', why: 'jowl fat heaping against the mandibular ligament' },
      { id: 'inj-chin-prejowl', title: 'Prejowl and chin support', why: 'fills the notch the jowl falls into' },
      { id: 'inj-ha-line', title: 'A little in the trench', why: 'softens the shadow — leave a line' },
      { id: 'clinic-facelift', title: 'Surgery, if it is really the jowl', why: 'the only treatment that moves tissue — with the line as a bonus' },
    ],
  },
  {
    concern: 'My chin is small or receded and the lines run into a notch at the jaw',
    paths: [
      { id: 'type-volume', title: 'Bone and volume', why: 'the shelf the line rests on has shrunk' },
      { id: 'inj-chin-prejowl', title: 'Chin and prejowl filler first', why: 'two randomised trials, with the marionette line as a measured outcome' },
      { id: 'clinic-dental', title: 'Check the teeth and the bite', why: 'lost lower teeth resorb the jaw underneath' },
    ],
  },
  {
    concern: 'A fine line in thin skin, no sagging and level corners',
    paths: [
      { id: 'type-skin', title: 'The fine line', why: 'the skin has lost recoil — deep volume is wasted here' },
      { id: 'home-retinoid', title: 'A retinoid and sunscreen', why: 'the wrinkle toolkit, for the skin type only' },
      { id: 'inj-ha-line', title: 'A soft gel threaded along the crease', why: 'superficial and sparing, by cannula' },
    ],
  },
  {
    concern: 'I want the corner itself lifted',
    paths: [
      { id: 'commissure-groove', title: 'The corner and its groove', why: 'the modiolus has dropped — a different target from the line' },
      { id: 'inj-dao-toxin', title: 'Toxin first', why: 'shows you what a lifted corner looks like on your face' },
      { id: 'clinic-commissure-lift', title: 'The commissure lift', why: 'from −3° to +3.5° in the 51-patient series — permanent, with a scar' },
    ],
  },
  {
    concern: 'I lost weight and the lines deepened',
    paths: [
      { id: 'home-weight', title: 'What weight loss did', why: 'deep fat under the muscle leaves with body fat' },
      { id: 'inj-chin-prejowl', title: 'Chin and prejowl support', why: 'put the volume back where it came from' },
      { id: 'inj-caha', title: 'Or diluted calcium hydroxylapatite', why: 'severe lines fell from 41% to 11% of patients in the series' },
    ],
  },
  {
    concern: 'I am nervous about toxin near my mouth',
    paths: [
      { id: 'safety-dao-toxin', title: 'The lopsided smile', why: 'what goes wrong, and the dose and point that avoid it' },
      { id: 'inj-ha-line', title: 'Support and the trench without toxin', why: 'filler carries no smile risk — and no lift' },
      { id: 'clinic-hifu', title: 'Or a device, for mild descent', why: 'modest tightening, nothing near the muscle' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the "e" test, the recline test, the profile — and photograph',
    when: 'Before any consultation',
    blurb: 'Muscle, descent, bone or skin; smile symmetry checked before any toxin; a photograph from the front and three-quarters in one light.',
  },
  {
    id: 'home-spf-quit',
    step: 'Day 1 onward: the skin base and the two habits',
    when: 'Whatever else you do',
    blurb: 'Sunscreen, no smoking, a retinoid along the line; lose weight slowly; keep the lower teeth and the bite.',
  },
  {
    id: 'inj-dao-toxin',
    step: 'Month 1: the muscle, then the support, then the trench',
    when: 'Toxin at week 0, gel at week 2',
    blurb: 'Two to three units a side in the depressor; two weeks later, chin and prejowl support and a little gel in the trench, stopping while a line remains.',
  },
  {
    id: 'clinic-facelift',
    step: 'Months 6–24: maintain, trade up, or reposition',
    when: 'Once you know how your line behaves',
    blurb: 'Toxin every 4–6 months and gel on the photograph; calcium hydroxylapatite or PLLA for longer rounds; a commissure lift for the corner or a facelift with chin work for a real jowl.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="marionette-lines" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Marionette lines (downturned mouth corners)</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Marionette lines, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          A trench between a muscle that pulls the corner down and a ligament that pins the skin to the jaw, with the
          jowl heaping into it and the chin shrinking underneath. Below, the "e" test that sorts them, every treatment
          from a few units of toxin to a facelift graded by the trials behind it, and the lopsided smile in numbers.
        </p>
        <p class="meta">
          Updated 7 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Marionette lines — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'inj' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="The muscle, the support, the trench — where each needle goes" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Sad mouth, sliding jowl, receded chin — the three lines from the front" />
              </div>
            )}

            <div class="chart mt-8">
              <div class="chart-cols" aria-hidden="true"><span>Evidence · 0–4</span><span>Treatment</span><span></span></div>
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'inj-dao-toxin',
                    kind: 'For the corner',
                    title: 'Toxin in the depressor anguli oris',
                    blurb: 'The one injectable that lifts the angle on photographs — a double-blind randomised trial, a 962-patient review, and a consensus dose of 5.6 units in total.',
                  },
                  {
                    id: 'inj-chin-prejowl',
                    kind: 'Support first',
                    title: 'Chin and prejowl filler',
                    blurb: 'Two randomised controlled trials with the marionette line as a measured outcome: prejowl depth 4.6 mm better than untreated, satisfaction up 33 points.',
                  },
                  {
                    id: 'inj-ha-line',
                    kind: 'For the trench',
                    title: 'Hyaluronic acid in the line',
                    blurb: 'Seventy per cent a grade better at a month and half at six in the marionette-specific study. Fills the shadow; leaves the corner where it is.',
                  },
                  {
                    id: 'clinic-facelift',
                    kind: 'For true descent',
                    title: 'An extended deep-plane facelift — for the jowls',
                    blurb: 'Beat the standard deep-plane lift for marionette lines in a 70-patient cohort; one series saw the lines recur within a year. For the jowl and neck, with the line as a bonus.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your mouth</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. The muscle first, the support second, the trench third, the knife last and only for the right reasons.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, randomised trials, consensus statements or clinical series, linked
            inline within each section. Primary sources: PubMed/PMC, Plastic and Reconstructive Surgery, Aesthetic
            Surgery Journal, Dermatologic Surgery, Aesthetic Plastic Surgery, the Journal of Dermatological Treatment
            and the Journal of Cosmetic Dermatology.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. The depressor anguli oris sits a few millimetres from the muscle
          that moves your lower lip, and the facial artery crosses the jaw beneath this line &mdash; toxin here is a
          matter of single units and exact placement, and filler belongs to a trained injector with hyaluronidase in
          the room.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
