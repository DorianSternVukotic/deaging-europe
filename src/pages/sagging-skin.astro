---
/**
 * The sagging-skin guide (/sagging-skin) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video,
 * the three drivers as cards, evidence strength as the primary visual
 * signal, one interactive block (situation matcher) and a month-by-month
 * action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  drivers,
  groups,
  focusLabels,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/sagging-skin';

const locale = DEFAULT_LOCALE;
const title = 'Sagging skin (skin laxity) — every treatment graded by evidence | DeAging Europe';
const description =
  'Sagging is two problems: skin that has lost its recoil, and a frame of fat and bone that has shrunk beneath it. The pinch and recline tests that sort them, sunscreen to hormone therapy to every tightening device and the facelift graded by trial evidence, and what "lift" really means in millimetres.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-cream': 'Quality yes, lift no',
  'faq-collagen': 'A little, consistently',
  'faq-hrt': 'Measurably — for menopause',
  'faq-weight-loss': 'Partly, if young',
  'faq-which-device': 'By type; all millimetres',
  'faq-threads': 'Not for laxity',
  'faq-facelift-or-device': 'The laxity class decides',
  'faq-age': 'Never too late for skin',
  'faq-timeline': 'Months, everywhere',
  'faq-cost-ladder': '€20 / month to €20,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'Thin, crepey skin that pinches slowly — no real folds or jowls',
    paths: [
      { id: 'type-skin', title: 'True laxity', why: 'the dermis has lost its recoil — skin work, not volume' },
      { id: 'home-retinoid', title: 'A retinoid and sunscreen', why: 'the only things that rebuild and keep recoil' },
      { id: 'inj-caha-hyperdilute', title: 'A collagen stimulator', why: 'the most objectively measured of the boosters' },
      { id: 'clinic-rf-mono', title: 'Monopolar radiofrequency', why: 'the gentlest device for thin skin' },
    ],
  },
  {
    concern: 'Everything looks deflated — temples, cheeks, jaw',
    paths: [
      { id: 'type-structure', title: 'The shrunken frame', why: 'the envelope is hanging off less' },
      { id: 'inj-volume', title: 'Deep volume', why: '79% still rated cheeks improved at two years' },
      { id: 'inj-plla', title: 'Or poly-L-lactic acid', why: 'support and dermal substance at once, slowly' },
    ],
  },
  {
    concern: 'My skin changed fast around menopause',
    paths: [
      { id: 'type-hormones', title: 'Estrogen withdrawal', why: 'collagen tracks years since menopause' },
      { id: 'inj-hrt', title: 'Hormone therapy, if you are a candidate', why: 'a meta-analysis of 15 studies — decided at a menopause clinic' },
      { id: 'home-collagen', title: 'Collagen peptides', why: 'their best small trial is in menopausal women' },
    ],
  },
  {
    concern: 'I lost a lot of weight, or I am on a GLP-1 medicine',
    paths: [
      { id: 'type-weight', title: 'The loose envelope', why: 'skin that fitted a larger face' },
      { id: 'home-weight', title: 'Slow the loss, budget for volume', why: 'younger skin retracts; older skin does not' },
      { id: 'inj-caha-hyperdilute', title: 'Diluted calcium hydroxylapatite', why: 'a series reports preserved volume during GLP-1 loss' },
      { id: 'clinic-facelift', title: 'Surgery for what will not retract', why: 'the only treatment that removes skin' },
    ],
  },
  {
    concern: 'Jowls and a loose neck that soften when I lie down',
    paths: [
      { id: 'type-structure', title: 'Descent', why: 'the recline test says structure, not skin' },
      { id: 'clinic-hifu', title: 'Focused ultrasound for mild descent', why: '70% clinically significant at three months in the randomised trial' },
      { id: 'clinic-facelift', title: 'A lift for more than mild', why: '94% satisfied after deep plane in 2,896 patients' },
    ],
  },
  {
    concern: 'I want tightening without surgery — which device?',
    paths: [
      { id: 'faq-which-device', title: 'The honest comparison', why: 'depth, evidence and predictability' },
      { id: 'clinic-hifu', title: 'Focused ultrasound', why: 'the most evidence, the most variable result' },
      { id: 'clinic-rf-mono', title: 'Monopolar radiofrequency', why: 'the gentlest, for thin skin' },
      { id: 'clinic-rf-microneedling', title: 'Radiofrequency microneedling', why: 'texture first, tightening second' },
    ],
  },
  {
    concern: 'Loose skin on my neck, arms or stomach',
    paths: [
      { id: 'type-body', title: 'Body laxity', why: 'the same physics with fewer tools' },
      { id: 'clinic-renuvion', title: 'Subdermal helium plasma', why: 'cleared for the neck on a prospective trial' },
      { id: 'inj-caha-hyperdilute', title: 'Diluted calcium hydroxylapatite', why: 'cutometer data on arms and abdomen' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the pinch, the recline, the photograph — and the history',
    when: 'Before any consultation',
    blurb: 'Laxity or descent; your class on the laxity scale; menopause, weight trajectory, sun, smoke and sleep written down before anyone sells a machine.',
  },
  {
    id: 'home-spf',
    step: 'Day 1 onward: keep the recoil you have',
    when: 'Whatever else you do',
    blurb: 'Sunscreen, no cigarettes, a retinoid, sleep, less sugar, slow weight loss; a three-month trial of collagen peptides if the skin is thin.',
  },
  {
    id: 'inj-hrt',
    step: 'Months 1–3: the hormone conversation, the frame, one device',
    when: 'Judged at three months',
    blurb: 'A menopause clinic if the change came with menopause; deep volume or a biostimulator for a deflated frame; one dermal device course for mild laxity.',
  },
  {
    id: 'clinic-facelift',
    step: 'Months 6–12: judge the device, or book the surgeon',
    when: 'Once collagen has had its six months',
    blurb: 'Devices are read at six months; class 6 and above, a descended lower face or a post-weight-loss envelope belong to a lift, with resurfacing for the crepe afterward.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="sagging-skin" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative border-b border-ink/10 overflow-hidden">
      <div class="max-w-6xl mx-auto px-6 pt-14 md:pt-20 pb-12">
        <p class="text-xs uppercase tracking-[0.3em] text-sage mb-4">Problem · Sagging skin (skin laxity)</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Sagging skin, honestly<span class="text-rose">.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          Two problems sold as one: skin that has lost its recoil, and a frame of fat and bone that has shrunk beneath
          it. Below, the pinch and recline tests that sort them, every treatment from sunscreen to hormone therapy to
          the tightening devices and the facelift graded by the trials behind it, and what "lift" really means in
          millimetres.
        </p>
        <p class="mt-3 text-xs text-ink/50">
          Updated 7 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" tone="sage" />
        </div>
      </div>
      <div class="absolute -right-32 -top-32 w-96 h-96 bg-rose/10 rounded-full blur-3xl pointer-events-none"></div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-6xl mx-auto px-6 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="font-display text-3xl md:text-4xl">{g.title}</h2>
          {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}
          {g.id === 'basics' && (
            <div class="mt-6 grid md:grid-cols-3 gap-4">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="group block p-5 bg-white rounded-2xl border border-ink/10 hover:border-rose/40 hover:shadow-md transition">
                  <p class="text-[10px] uppercase tracking-widest font-semibold text-sage">{d.kind}</p>
                  <h3 class="font-display text-xl leading-tight mt-1 group-hover:text-rose transition">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid gap-2' : 'mt-6 grid gap-2'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section class="bg-white border-y border-ink/5">
      <div class="max-w-6xl mx-auto px-6 py-12">

        <div class="mb-10 pt-4">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">The full breakdown</p>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Sagging skin — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="text-xs uppercase tracking-[0.3em] text-sage">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="font-display text-3xl md:text-4xl mt-2">{g.title}</h2>
            {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}

            {g.id === 'clinic' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="What each device heats, at what depth — and what a millimetre of lift looks like" tone="rose" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Laxity classes 2, 5 and 8 — the same face, three rungs of the ladder" tone="bone" />
              </div>
            )}

            <div class="card-grid mt-8 divide-y divide-ink/[0.07] border-y border-ink/[0.07]">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    variant="bar"
                    tag={s.focus && s.focus !== 'general' ? focusLabels[s.focus] : undefined}
                    mediaTone={g.id === 'clinic' ? 'rose' : undefined}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="mb-16 scroll-mt-32">
              <p class="text-xs uppercase tracking-[0.3em] text-sage">Editor's choice</p>
              <h2 class="font-display text-3xl md:text-4xl mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
                {[
                  {
                    id: 'home-spf',
                    kind: 'The base',
                    title: 'Sunscreen, a retinoid, no cigarettes',
                    blurb: 'The habits with evidence on the mechanism itself — a randomised prevention trial, biopsies of smokers’ elastic fibres, eight retinoid trials.',
                    tone: 'sage' as const,
                  },
                  {
                    id: 'inj-hrt',
                    kind: 'For menopausal skin',
                    title: 'Hormone therapy, where indicated',
                    blurb: 'A meta-analysis of 15 studies in 1,589 women: elasticity, thickness and collagen all up — decided at a menopause clinic, not an aesthetic one.',
                    tone: 'rose' as const,
                  },
                  {
                    id: 'clinic-hifu',
                    kind: 'For mild laxity',
                    title: 'Focused ultrasound',
                    blurb: 'The most controlled evidence of any device: 70% clinically significant tightening at three months in a randomised trial — and a fifth in a retrospective series.',
                    tone: 'gold' as const,
                  },
                  {
                    id: 'clinic-facelift',
                    kind: 'For real sagging',
                    title: 'A facelift or neck lift',
                    blurb: 'The only treatment that removes skin: 94% satisfied after deep plane in a 2,896-patient meta-analysis, with the complication rates printed beside it.',
                    tone: 'bone' as const,
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card group flex flex-col bg-white rounded-2xl border border-ink/10 overflow-hidden hover:border-rose hover:shadow-md transition"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} tone={pick.tone} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="text-[10px] uppercase tracking-widest font-semibold text-sage">{pick.kind}</p>
                      <h3 class="font-display text-lg leading-tight mt-1 group-hover:text-rose transition">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="mt-4 inline-flex items-center gap-1 text-xs uppercase tracking-widest font-semibold text-rose group-hover:gap-2 transition-all">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-6xl mx-auto px-6 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="text-xs uppercase tracking-[0.3em] text-sage">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="font-display text-3xl md:text-4xl mt-2">{g.title}</h2>
            {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}
            <div class="mt-8 grid gap-2">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 bg-gradient-to-br from-rose/10 via-bone to-sage/5 rounded-2xl p-6 md:p-10 border border-ink/5">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">Interactive</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">Match a plan to your skin</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid gap-2">
            {matcher.map((m) => (
              <details class="matcher-item group rounded-2xl border border-ink/10 bg-white px-4 py-3 transition hover:border-rose/40 open:border-rose/40">
                <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
                  <h3 class="font-display text-xl leading-tight group-hover:text-rose group-open:text-rose transition">{m.concern}</h3>
                  <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-rose bg-rose/10 group-open:bg-rose group-open:text-white transition" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="mt-3 pt-3 border-t border-ink/10 space-y-2">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="flex gap-3 p-3 rounded-xl bg-bone/50 border border-ink/5 hover:border-rose/40 transition">
                      <span class="font-display text-rose w-5 shrink-0">{i + 1}.</span>
                      <span>
                        <span class="font-medium text-ink/90">{p.title}</span>
                        <span class="text-ink/60"> — {p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 bg-white rounded-2xl border border-ink/5 p-6 md:p-8 overflow-hidden">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">The action plan</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Keep the recoil, rebuild the dermis, refill the frame, remove what no longer fits.</p>

          <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="block p-5 bg-bone/40 rounded-xl border border-ink/5 hover:border-rose/40 hover:shadow-md transition group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display text-2xl text-rose leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 rounded-full bg-sage/15 text-sage">{r.when}</span>
                </div>
                <h3 class="font-display text-lg leading-tight group-hover:text-rose">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 bg-white rounded-2xl p-8 border border-ink/5">
          <h2 class="font-display text-3xl">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, randomised trials, meta-analyses, regulator communications or
            clinical series, linked inline within each section. Primary sources: PubMed/PMC, Aesthetic Surgery
            Journal, Aesthetic Plastic Surgery, the British Journal of Dermatology, the Journal of Cosmetic
            Dermatology, Skin Research and Technology, Climacteric, the Menopause Society and the FDA.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Hormone therapy is a decision about menopause to be taken with a
          menopause clinician; every energy device works by controlled injury and belongs to an operator who knows
          what to do with a thin face; and no treatment on this page removes skin except an operation.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-rose);
      outline-offset: -2px;
      border-radius: 1rem;
    }

    .card[open] > summary { background: rgba(184,130,109,0.04); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
