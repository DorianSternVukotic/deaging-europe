---
/**
 * The facial-redness guide (/facial-redness) — problem-template variant of
 * the collagen-guide layout: title, description, a full-width explainer
 * video, the three drivers as cards, evidence strength as the primary
 * visual signal, one interactive block (situation matcher) and a
 * month-by-month action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { guideMeta, formatDate } from '../data/guides';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/facial-redness';

const locale = DEFAULT_LOCALE;
const guide = guideMeta('facial-redness');
const title = 'Facial redness, rosacea and broken capillaries — every treatment graded by evidence | DeAging Europe';
const description =
  'A red face is four things sharing one disease — flushing that hardens into fixed redness, capillaries that have opened for good, bumps that are not acne, and a nose that thickens — plus the eyes. The self-check that sorts them, and sunscreen, barrier repair, azelaic acid, ivermectin, metronidazole, doxycycline, isotretinoin, the brimonidine and oxymetazoline redness switches, pulsed-dye laser, IPL, KTP, toxin, paroxetine and the rest graded by 152 randomised trials, with the steroid cream and the rebound gel that make it worse.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-sensitive-or-rosacea': 'Red at rest across the centre = rosacea',
  'faq-cure': 'Controlled, not cured',
  'faq-capillaries-permanent': 'Treated ones, yes; new ones grow',
  'faq-alcohol': 'Raises risk; the nose is not drink',
  'faq-coffee-spice': 'Coffee stays; let it cool',
  'faq-actives': 'Barrier first; azelaic is the acid',
  'faq-acne': 'No blackheads; different routine',
  'faq-rebound': 'Paradoxical erythema — stop',
  'faq-cost-ladder': 'Free to €4,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'I flush and burn, and the redness comes and goes',
    paths: [
      { id: 'type-flush', title: 'Flushing that lasts', why: 'a flush that outlasts its trigger by ten minutes is the disease' },
      { id: 'home-sun-triggers', title: 'Sunscreen and the trigger diary', why: 'sun fires 81%, stress 79%, heat 75% — find your two or three' },
      { id: 'home-barrier', title: 'Repair the barrier', why: 'the stinging is a barrier that the gene study likens to eczema' },
      { id: 'rx-brimonidine', title: 'A switch for the days that matter', why: 'blanks redness for a day in a quarter to a third; rebounds in 10–20%' },
    ],
  },
  {
    concern: 'Fixed redness and visible vessels on my cheeks and nose',
    paths: [
      { id: 'type-vessels', title: 'Broken capillaries', why: 'threads that vanish under a pressed glass — no cream closes them' },
      { id: 'dev-pdl', title: 'The pulsed-dye laser', why: 'the device with the most robust evidence, three to five sessions' },
      { id: 'dev-ipl', title: 'Intense pulsed light', why: 'equal to the laser in the split-face trial; 39% less cheek redness at six months' },
      { id: 'dev-ktp-ndyag', title: 'KTP or Nd:YAG for the individual thread', why: '85% of discrete vessels cleared after three KTP sessions' },
    ],
  },
  {
    concern: 'Bumps and pustules that are not acne',
    paths: [
      { id: 'type-bumps', title: 'Papulopustular rosacea', why: 'no blackheads, a red burning background, onset after thirty' },
      { id: 'rx-ivermectin', title: 'Ivermectin 1% cream', why: 'clear or almost clear in 38–40% against 12–19% in 1,371 people' },
      { id: 'rx-azelaic', title: 'Azelaic acid 15%', why: 'success in 61–62% against 40–48%; beats metronidazole' },
      { id: 'rx-doxycycline', title: 'Doxycycline 40 mg for the flare', why: 'lesions halved in two phase 3 trials, below the antibiotic dose' },
    ],
  },
  {
    concern: 'It started, or got much worse, after a cream',
    paths: [
      { id: 'type-steroid', title: 'Steroid rosacea', why: 'a potent steroid calms for weeks and causes for years' },
      { id: 'safety-steroid', title: 'How to stop it', why: 'gradual withdrawal, a bad fortnight, months of a tetracycline' },
      { id: 'rx-doxycycline', title: 'The tetracycline that carries you through', why: 'the anti-inflammatory dose for the rebound months' },
    ],
  },
  {
    concern: 'My eyes are gritty, dry, red or light-sensitive',
    paths: [
      { id: 'type-ocular', title: 'Ocular rosacea', why: 'a third of patients — lid hygiene, omega-3, doxycycline, an ophthalmologist for pain' },
      { id: 'safety-red-flags', title: 'When the eye is urgent', why: 'pain, blurred vision or daylight that hurts is the cornea' },
    ],
  },
  {
    concern: 'My nose is thickening',
    paths: [
      { id: 'type-phyma', title: 'Rhinophyma', why: 'rosacea, not drink — and a place skin cancer hides' },
      { id: 'rx-isotretinoin', title: 'Low-dose isotretinoin early', why: 'shrinks the glands before the shape changes' },
      { id: 'dev-rhinophyma', title: 'Laser or blade to reshape', why: 'excellent or good in 71–75% with blinded photo grading' },
    ],
  },
  {
    concern: 'I flush with palpitations, diarrhoea, wheeze or sweats',
    paths: [
      { id: 'safety-red-flags', title: 'A doctor and blood tests first', why: 'carcinoid, phaeochromocytoma, mastocytosis and anaphylaxis are excluded by tests, not by creams' },
      { id: 'type-masquerade', title: 'The look-alikes', why: 'lupus, seborrhoeic dermatitis, the menopause and the drugs that flush' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the photograph, the pressed glass, the diary, the tube count and the eye questions',
    when: 'Before anything',
    blurb: 'A weekly photo by the same window; a glass on the cheek to sort vessels from bumps from blush; a fortnight\'s trigger diary; every cream read for a steroid; four eye questions; flushing with company sent to a doctor today; a dermatologist booked to confirm the diagnosis.',
  },
  {
    id: 'home-sun-triggers',
    step: 'Day 1 onward: mineral SPF, a repaired barrier, the two triggers that are yours',
    when: 'Every day, for good',
    blurb: 'Sunscreen the skin tolerates, a non-foaming cleanser, a niacinamide or ceramide moisturiser, no scrubs or fragrance, the coffee cooled and the steroid tube in the bin; green-tinted make-up for the mirror while the rest works.',
  },
  {
    id: 'rx-ivermectin',
    step: 'Months 1–3: the prescriptions with the trials',
    when: 'Judged at 12 weeks on the photograph',
    blurb: 'Ivermectin or azelaic acid daily for the bumps, doxycycline 40 mg for eight to sixteen weeks if they are many, brimonidine patch-tested for the days that matter; isotretinoin only from a dermatologist when these fail.',
  },
  {
    id: 'dev-pdl',
    step: 'Month 3 onward: light for the vessels, and the off-label shelf for the flushing that survives',
    when: 'Once the bumps are quiet and there is no tan',
    blurb: 'Three to five sessions of pulsed-dye laser or IPL for the capillaries and fixed redness, repeated every year or two; paroxetine, a beta-blocker, intradermal toxin or tranexamic acid from a specialist for refractory flushing; the nose reshaped by someone who does it weekly.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="facial-redness" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Facial redness, rosacea &amp; broken capillaries</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Facial redness, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          A red face is four different things sharing one disease &mdash; flushing that hardens into fixed redness,
          capillaries that have opened for good, bumps that are not acne, and a nose that thickens &mdash; and the eyes
          are involved in a third. Below, the self-check that sorts them, every treatment from sunscreen to the laser
          graded by the 152 randomised trials behind them, and the two things that make it worse: the steroid cream
          that caused it and the redness gel that rebounds.
        </p>
        <p class="meta">
          Updated <time datetime={guide.updated}>{formatDate(guide.updated)}</time> · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Facial redness — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'clinic' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="The pressed-glass test, and what a pulsed-dye session actually looks and feels like" />
                <MediaPlaceholder kind="image" ratio="16/9" label="The same cheek before, one week after a purpuric session, and three months after the third" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'dev-pdl',
                    kind: 'For the vessels',
                    title: 'Pulsed-dye laser or IPL',
                    blurb: 'The only rung that removes a capillary: equal to each other in the split-face trial, 39% less cheek redness held at six months, the most robust device evidence at low-to-moderate certainty. Three to five sessions, never on a tan, repeated as the disease grows new ones.',
                  },
                  {
                    id: 'rx-ivermectin',
                    kind: 'For the bumps',
                    title: 'Ivermectin 1% cream',
                    blurb: 'Clear or almost clear in 38–40% against 12–19% on vehicle in 1,371 people; better than metronidazole in 962. High-certainty evidence, once a day, and it kills the mite.',
                  },
                  {
                    id: 'rx-azelaic',
                    kind: 'The all-rounder',
                    title: 'Azelaic acid 15%',
                    blurb: 'Success in 61–62% against 40–48% in 664 people, still improving at week 15 where metronidazole plateaued at week 8; treats the bumps, the background redness and the pigment. Stings for a fortnight, then does not.',
                  },
                  {
                    id: 'rx-brimonidine',
                    kind: 'For the day that matters',
                    title: 'Brimonidine gel',
                    blurb: 'Redness two grades down for the day in a quarter to a third of users against a tenth on vehicle, within 30 minutes — and a rebound worse than baseline in one in five to ten. Patch-test, a pea, an intact barrier, never a daily habit without a plan.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your face</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Sort the features, protect and repair the skin every day, treat the bumps with the creams that have the trials, and spend on light only once the disease is quiet.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, randomised trials, meta-analyses, cohort studies, regulatory labels or
            reference texts, linked inline within each section. Primary sources: PubMed/PMC, the British Journal of
            Dermatology (including the Cochrane-group rosacea reviews and the ROSCO consensus), the Journal of the
            American Academy of Dermatology, JAMA Dermatology, Dermatologic Surgery, the Journal of Investigative
            Dermatology, Clinical Gastroenterology and Hepatology, the FDA and DailyMed prescribing information,
            DermNet, and the National Rosacea Society's surveys.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. Flushing that comes with palpitations, diarrhoea, wheeze, hives or
          drenching sweats, a rash with joint pain or mouth ulcers, and eye pain or blurred vision need a doctor before
          a cosmetic plan; every pill on this page is a prescription with monitoring; and no corticosteroid belongs on a
          rosacea face.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
