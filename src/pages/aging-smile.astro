---
/**
 * The aging-smile guide (/aging-smile) — problem-template variant of the
 * collagen-guide layout: title, description, a full-width explainer video,
 * the three drivers as cards, evidence strength as the primary visual
 * signal, one interactive block (situation matcher) and a month-by-month
 * action plan. Dental and perioral rows are graded side by side.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { guideMeta, formatDate } from '../data/guides';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/aging-smile';

const locale = DEFAULT_LOCALE;
const guide = guideMeta('aging-smile');
const title = 'The aging smile — every treatment graded by evidence | DeAging Europe';
const description =
  'A smile ages in three places: an upper lip that lengthens by 5 mm and hides the teeth, teeth that darken, shorten and lose their gum, and a maxilla and jaw that recede behind them. The ruler-and-phone self-check, and whitening, bonding, veneers, aligners, gum grafts, black-triangle repair, implants, lip filler, the lip lift, toxin, resurfacing and the support fillers graded dental and aesthetic side by side — with the smile-makeover before-and-afters read for what they hide.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-teeth-gone': 'Longer lip, shorter teeth',
  'faq-how-white': 'No whiter than your eyes',
  'faq-bonding-veneers': 'Bonding first',
  'faq-filler-or-lift': 'Measure the philtrum',
  'faq-order': 'Dentist first',
  'faq-men': 'Yes — more so',
  'faq-how-long': 'Years dental; months aesthetic',
  'faq-cost-ladder': '€80 to €30,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'My upper teeth have disappeared when I talk, and my lip looks long and thin',
    paths: [
      { id: 'type-lip', title: 'The long lip', why: 'a philtrum over 18 mm and no tooth show at rest — length and ptosis, not deflation' },
      { id: 'home-wear', title: 'Check the edges first', why: 'a flat, worn incisor hides under the lip as surely as the lip lengthens' },
      { id: 'dental-bonding', title: 'Bonding to lengthen the incisors', why: 'one visit, no enamel removed, 92% at ten years' },
      { id: 'peri-lip-lift', title: 'The subnasal lip lift', why: 'the only treatment that shortens the philtrum; series holding one to five years' },
      { id: 'peri-filler-lips', title: 'Filler only at the border', why: 'half a millilitre for the roll and the show — never a millilitre for the length' },
    ],
  },
  {
    concern: 'My teeth have gone yellow and dull',
    paths: [
      { id: 'home-stain', title: 'The hygienist and a whitening toothpaste', why: 'surface stain first, in a meta-analysis of 21 trials' },
      { id: 'dental-whitening', title: 'Peroxide whitening in dentist-made trays', why: 'every protocol works; holds one to 2.5 years; the cheapest large change' },
      { id: 'safety-whitening', title: 'What it will not change', why: 'fillings, crowns and veneers keep their shade; match the whites of your eyes' },
      { id: 'dental-veneers', title: 'Veneers only if colour, shape and wear all need changing', why: '96% at ten years, irreversibly' },
    ],
  },
  {
    concern: 'My front teeth look short, flat and chipped',
    paths: [
      { id: 'type-teeth', title: 'The worn edge', why: 'erosive wear in 98% of Europeans; the reversed smile line' },
      { id: 'home-wear', title: 'Acid, grinding, a night guard', why: 'the bonding will not survive a grinder' },
      { id: 'dental-bonding', title: 'Composite bonding', why: 'rebuilds the curve of a young edge in a visit' },
      { id: 'dental-veneers', title: 'Veneers if the whole face of the tooth has gone', why: 'lithium disilicate on enamel, on the teeth that show' },
    ],
  },
  {
    concern: 'My gums have receded — the teeth look long and there are dark triangles between them',
    paths: [
      { id: 'dental-recession', title: 'A connective-tissue gum graft', why: 'the most-randomised repair in periodontics — 13 trials in one meta-analysis, 24 in another' },
      { id: 'dental-black-triangles', title: 'The papilla: HA for weeks, a graft for years', why: '45 studies, insufficient for a recommendation, but the options are real' },
      { id: 'dental-aligners', title: 'Aligning the teeth', why: 'one of the four treatments that closes triangles — after the gum is assessed' },
      { id: 'home-stain', title: 'Stop what moved the gum', why: 'smoking doubles the odds; so does the hard brush' },
    ],
  },
  {
    concern: 'The corners of my mouth turn down and I look stern or sad',
    paths: [
      { id: 'type-dynamic', title: 'The tired mouth', why: 'the corner depressor unopposed by a thinner lip, over a receding frame' },
      { id: 'peri-neuromodulator', title: 'A few units of toxin in the corners', why: 'reversible, a hundred euros, and a preview of the surgical result' },
      { id: 'peri-support', title: 'Support at the chin and marionette', why: 'the base the corners rest on; graded in the filler and marionette guides' },
      { id: 'peri-resurfacing', title: 'Resurfacing for the etched lines', why: 'a small edge to the CO2 laser in split-face trials' },
    ],
  },
  {
    concern: 'My lips have thinned and lipstick bleeds into the lines',
    paths: [
      { id: 'home-lip-care', title: 'SPF balm and a retinoid above the lip', why: 'the surface stage, slowed' },
      { id: 'peri-filler-lips', title: 'A border filler with the lines treated', why: '76% success against 12% untreated when lips and lines are done together' },
      { id: 'peri-resurfacing', title: 'Resurfacing for what is etched', why: 'the lines the muscle and the border cannot reach' },
      { id: 'safety-lips', title: 'The overfilled lip', why: 'volume on a long lip lowers the curtain — the "blown-up" look the MRI study warned of' },
    ],
  },
  {
    concern: 'I have lost teeth and my lower face has caved in',
    paths: [
      { id: 'type-frame', title: 'The receding frame', why: 'missing teeth remove lip support; the maxilla recedes behind them' },
      { id: 'dental-implants', title: 'Implants, or a well-made prosthesis', why: '96% at ten years; dentures restore part of the height' },
      { id: 'peri-support', title: 'Then the base under the lip', why: 'HA for the collapse a prosthesis leaves behind' },
      { id: 'faq-order', title: 'In that order', why: 'nothing done to the lip fixes a missing frame' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the ruler, the four expressions, the photographs — and a dentist',
    when: 'Before anything',
    blurb: 'Tooth show at rest measured; philtrum measured; speech, posed smile and a real laugh filmed on a phone; colour against the whites of the eyes, edges, gum line and triangles checked; a hygienist and a periodontal chart booked; photographs at rest, speaking, smiling and in profile, same light, no flash.',
  },
  {
    id: 'home-stain',
    step: 'Month 1: stain off, edges protected, lip surface cared for',
    when: 'Every day, for good',
    blurb: 'A scale and polish; a whitening toothpaste; the cigarettes gone; acidic drinks with meals and through a straw; a night guard if the edges are flat; an SPF balm by day and a retinoid on the white lip by night; a toxin trial of the corners or the gum if either bothers you.',
  },
  {
    id: 'dental-whitening',
    step: 'Months 2–6: the dental frame — whiten, rebuild, cover, align, replace',
    when: 'Teeth before lips',
    blurb: 'Peroxide whitening in dentist-made trays; bonded edges for the worn incisors; a gum graft for the roots on show and the triangles that warrant it; aligners for the crowded lower or drifted upper teeth; implants for the gaps. Veneers only where colour, shape and wear all need changing, on the teeth that show.',
  },
  {
    id: 'peri-lip-lift',
    step: 'Month 6 onward: the lip and its base, on a frame worth revealing',
    when: 'After the dental work',
    blurb: 'Support at the chin, pyriform and marionette where the bone has receded; resurfacing for the etched lines; a border filler for the roll and the vermilion show; and, for the philtrum over 18 mm with no tooth show, the lip lift from a surgeon — the one treatment that shortens the curtain rather than padding it.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="aging-smile" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · The aging smile</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          The aging smile, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          A smile ages in three places at once: an upper lip that lengthens by about five millimetres and thins
          until it curtains the teeth, teeth that darken, shorten and lose their gum, and a maxilla and jaw that
          recede behind them. The youthful signature &mdash; upper teeth on show, lower teeth hidden &mdash;
          reverses. Below, the ruler-and-phone self-check that says which part has aged, and every treatment
          graded on the component it reaches, dental and aesthetic side by side &mdash; from the hygienist and the
          night guard to the gum graft, the lip lift and the filler that most people reach for first and that
          treats none of the three causes.
        </p>
        <p class="meta">
          Updated <time datetime={guide.updated}>{formatDate(guide.updated)}</time> · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">The aging smile — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'dental' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="The four expressions on camera: rest, speech, posed smile and a real laugh at 25 and at 60" />
                <MediaPlaceholder kind="image" ratio="16/9" label="The same mouth in profile: philtrum length, tooth show at rest and the incisal edge, young and aged" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'dental' || g.id === 'perioral'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per component — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'dental-whitening',
                    kind: 'For the colour',
                    title: 'Peroxide whitening, in dentist-made trays',
                    blurb: 'The cheapest large change on the page: every protocol works in the systematic reviews, colour holds one to 2.5 years, the at-home carbamide trays relapse least, and the white diet turned out to be unnecessary. Legally a dentist\'s treatment in the EU above 0.1%; matched to the whites of your eyes, not the television.',
                  },
                  {
                    id: 'dental-bonding',
                    kind: 'For the edge',
                    title: 'Composite bonding on the worn incisors',
                    blurb: 'The 1–2 mm of edge that wear removed and the lip no longer reveals, rebuilt in one visit without drilling: 667 front-tooth build-ups survived 91.7% at ten years and 98.5% functionally at fifteen because a chip is a twenty-minute repair. The treatment to try before any veneer, and often the last one needed.',
                  },
                  {
                    id: 'dental-recession',
                    kind: 'For the gum',
                    title: 'The connective-tissue gum graft',
                    blurb: 'The "long in the tooth" of age is a gum that moved, and it moves back: the coronally advanced flap with a connective-tissue graft is the repair periodontists have randomised most — 13 trials in one meta-analysis, a donor-free matrix matching it in 24 more — and the one most likely to cover the root completely. It rejuvenates the smile and protects the tooth at once.',
                  },
                  {
                    id: 'peri-filler-lips',
                    kind: 'For the lip — conservatively',
                    title: 'A border filler, half a millilitre',
                    blurb: 'Randomised trials behind it — 93% responders at eight weeks against 29% untreated, 76% when the lines are treated with the lip — and one MRI study against the way it is usually used: the aging lip is long, not empty. Restore the roll, the bow and the vermilion show; add no length; and have the teeth done first.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">Match a plan to your smile</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Measure first, clean and protect from day one, rebuild the dental frame over the following months, and only then treat the lip and its base &mdash; because a lifted or filled lip reveals the teeth behind it.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, randomised trials, systematic reviews, meta-analyses, survival
            cohorts or clinic series, linked inline within each section. Primary sources: PubMed/PMC, the American
            Journal of Orthodontics and Dentofacial Orthopedics, the Angle Orthodontist, the Journal of Prosthetic
            Dentistry, the Journal of Dentistry, Clinical Oral Investigations, the Journal of Esthetic and Restorative
            Dentistry, the Journal of Periodontal Research, Plastic and Reconstructive Surgery, Aesthetic Plastic
            Surgery, Dermatologic Surgery, JPRAS, Gerodontology and Oral Radiology.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical or dental advice. Whitening above 0.1% hydrogen peroxide is restricted to
          dental practitioners in the EU; veneers, crowns and lip lifts are irreversible; every injection near the
          mouth is a medical procedure with a vascular risk; and prices are indicative private rates, not quotes.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
