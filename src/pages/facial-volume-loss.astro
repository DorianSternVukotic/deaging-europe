---
/**
 * The facial-volume-loss guide (/facial-volume-loss) — problem-template
 * variant of the collagen-guide layout: title, description, a full-width
 * explainer video, the three drivers as cards, evidence strength as the
 * primary visual signal, one interactive block (situation matcher) and a
 * month-by-month action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  drivers,
  groups,
  focusLabels,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/facial-volume-loss';

const locale = DEFAULT_LOCALE;
const title = 'Hollow temples and cheeks (facial volume loss) — every treatment graded by evidence | DeAging Europe';
const description =
  'The face deflates before it sags: fat pads empty and slide, the skull recedes, and weight and hormones set the pace. The recline test that separates deflation from descent, hyaluronic acid, poly-L-lactic acid, calcium hydroxylapatite and fat grafting graded by trial evidence, and the temple’s arteries and the overfilled face in numbers.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-filler-or-sculptra': 'HA first, then decide',
  'faq-temples-safe': 'In expert hands',
  'faq-how-long': 'A year to permanent',
  'faq-fat-vs-filler': 'Filler first, fat once',
  'faq-ozempic': 'Wait, then refill',
  'faq-hrt': 'Not measurably',
  'faq-pillow-face': 'Recline test; photograph',
  'faq-timeline': 'Two weeks to six months',
  'faq-cost-ladder': 'Free to €22,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'My temples have gone hollow and scalloped',
    paths: [
      { id: 'type-fat-deflation', title: 'Temporal deflation', why: 'the temple’s fat pad thins by a third between youth and middle age' },
      { id: 'inj-ha-temples', title: 'Hyaluronic acid in the temple', why: '80% improved against 14% untreated, reversible' },
      { id: 'inj-plla', title: 'Or poly-L-lactic acid', why: '96.5% of temples improved against 0% of controls' },
      { id: 'safety-temple', title: 'Read the temple safety row first', why: 'arteries to the eye, a vein to the lungs' },
    ],
  },
  {
    concern: 'Flat cheeks and a tired look at every angle',
    paths: [
      { id: 'type-fat-deflation', title: 'The deflated midface', why: 'deep cheek fat has emptied — the same lying down' },
      { id: 'inj-ha-midface', title: 'Hyaluronic acid on the cheekbone and medial cheek', why: '86% improved, 79% still at two years' },
      { id: 'inj-plla', title: 'Or a collagen stimulator', why: 'beat hyaluronic acid 91% to 51% at a year' },
      { id: 'clinic-fat-grafting', title: 'Fat, for one permanent answer', why: '47% pooled retention, your own tissue' },
    ],
  },
  {
    concern: 'Hollows around my eyes and a cheekbone that has lost its shelf',
    paths: [
      { id: 'type-bone', title: 'The retreating skeleton', why: 'the orbit widens and the maxilla recedes on CT' },
      { id: 'inj-ha-midface', title: 'Support on the bone first', why: 'the shelf the soft tissue drapes over' },
      { id: 'inj-caha-cheek', title: 'Or calcium hydroxylapatite for the cheek', why: '92% physician and 80% patient satisfaction at a year' },
    ],
  },
  {
    concern: 'I lost weight, or I am on a GLP-1 medicine, and my face looks gaunt',
    paths: [
      { id: 'type-weight', title: 'The weight-loss face', why: 'facial fat follows body fat, and the temples go first' },
      { id: 'home-weight', title: 'Let the weight settle first', why: 'a face refilled mid-loss is refilled twice' },
      { id: 'inj-glp1-combination', title: 'Stimulator plus hyaluronic acid', why: 'the layered protocol now published for these patients' },
      { id: 'faq-ozempic', title: 'The timing rules', why: 'and the recline test, because the skin may have hung too' },
    ],
  },
  {
    concern: "I'm not sure whether my face is sagging or deflating",
    paths: [
      { id: 'workup', title: 'The recline test', why: 'lie flat with a mirror — the whole diagnosis' },
      { id: 'type-descent-not-volume', title: 'Descent, not deflation', why: 'tissue in the wrong place, not tissue missing' },
      { id: 'safety-overfill', title: 'What happens when descent is filled', why: 'the overfilled face, made one syringe at a time' },
    ],
  },
  {
    concern: 'I had buccal fat removal, or a lot of ultrasound, and now I look hollow',
    paths: [
      { id: 'type-iatrogenic', title: 'The hollow you paid for', why: 'a compartment the aging face would have needed' },
      { id: 'inj-ha-midface', title: 'Hyaluronic acid to rebuild the cheek', why: 'reversible, to find the right amount' },
      { id: 'clinic-fat-grafting', title: 'Fat grafting for the long term', why: 'living tissue where a pad was removed' },
    ],
  },
  {
    concern: 'I want something permanent',
    paths: [
      { id: 'faq-fat-vs-filler', title: 'Fat or filler', why: 'what permanent actually costs' },
      { id: 'clinic-fat-grafting', title: 'Fat grafting', why: 'permanent for the half that survives, follows your weight' },
      { id: 'inj-plla', title: 'Poly-L-lactic acid for two years and more', why: 'the longest non-surgical result, with no eraser' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the recline test and the three-quarter photograph',
    when: 'Before any consultation',
    blurb: 'Deflated or descended; the temple and midface scales graded from your own photographs; weight, medicines and past procedures written down.',
  },
  {
    id: 'home-weight',
    step: 'Day 1 onward: settle the weight, protect the skin',
    when: 'Whatever else you do',
    blurb: 'Hold the weight for a few months before anyone injects; a retinoid and sunscreen over the hollow; the exercise pilot if you will do half an hour a day.',
  },
  {
    id: 'inj-ha-midface',
    step: 'Months 1–3: rebuild the shelves, reversibly',
    when: 'Judged at two weeks per site',
    blurb: 'Hyaluronic gel on the cheekbone and medial cheek, then the temples by an injector who maps the vessels — medial before lateral, millilitres you can name.',
  },
  {
    id: 'inj-plla',
    step: 'Months 6–24: the long game, decided on the photograph',
    when: 'Once you know how much volume your face wants',
    blurb: 'A poly-L-lactic acid course or fat grafting for the globally deflated face; top-ups compared against the photograph, never booked by the calendar.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="facial-volume-loss" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative border-b border-ink/10 overflow-hidden">
      <div class="max-w-6xl mx-auto px-6 pt-14 md:pt-20 pb-12">
        <p class="text-xs uppercase tracking-[0.3em] text-sage mb-4">Problem · Hollow temples &amp; cheeks (facial volume loss)</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Facial volume loss, honestly<span class="text-rose">.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          The face deflates before it sags: fat pads empty and slide, the skull recedes beneath them, and body fat and
          hormones set the pace. Below, the recline test that separates deflation from descent, every treatment from
          a reversible gel to a fat graft graded by the trials behind it, and the temple's arteries and the
          overfilled face in numbers.
        </p>
        <p class="mt-3 text-xs text-ink/50">
          Updated 7 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" tone="sage" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-6xl mx-auto px-6 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="font-display text-3xl md:text-4xl">{g.title}</h2>
          {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}
          {g.id === 'basics' && (
            <div class="mt-6 grid md:grid-cols-3 gap-4">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="group block p-5 bg-white border border-ink/10 hover:border-rose/40 transition">
                  <p class="text-[10px] uppercase tracking-widest font-semibold text-sage">{d.kind}</p>
                  <h3 class="font-display text-xl leading-tight mt-1 group-hover:text-rose transition">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid gap-2' : 'mt-6 grid gap-2'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section class="bg-white border-y border-ink/5">
      <div class="max-w-6xl mx-auto px-6 py-12">

        <div class="mb-10 pt-4">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">The full breakdown</p>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Facial volume loss — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="text-xs uppercase tracking-[0.3em] text-sage">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="font-display text-3xl md:text-4xl mt-2">{g.title}</h2>
            {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}

            {g.id === 'inj' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="The compartments that empty, the planes that are safe — where volume goes and where it must not" tone="rose" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Deflated and descended — the same face lying down and sitting up" tone="bone" />
              </div>
            )}

            <div class="card-grid mt-8 divide-y divide-ink/[0.07] border-y border-ink/[0.07]">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    variant="bar"
                    tag={s.focus && s.focus !== 'general' ? focusLabels[s.focus] : undefined}
                    mediaTone={g.id === 'clinic' ? 'rose' : undefined}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="mb-16 scroll-mt-32">
              <p class="text-xs uppercase tracking-[0.3em] text-sage">Editor's choice</p>
              <h2 class="font-display text-3xl md:text-4xl mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
                {[
                  {
                    id: 'inj-ha-temples',
                    kind: 'For the temples',
                    title: 'Hyaluronic acid, mapped and deep',
                    blurb: 'The first filler licensed for temple hollowing: 80% improved against 14% untreated, 73% still responding at 13 months — reversible, by an injector who knows the vessels.',
                    tone: 'sage' as const,
                  },
                  {
                    id: 'inj-ha-midface',
                    kind: 'For the cheeks',
                    title: 'Hyaluronic acid on the bone',
                    blurb: '86% improved against controls with 79% still rating cheeks improved at two years, and a meta-analysis of five randomised trials in 748 people behind the class.',
                    tone: 'rose' as const,
                  },
                  {
                    id: 'inj-plla',
                    kind: 'For the whole face',
                    title: 'Poly-L-lactic acid',
                    blurb: 'Beat hyaluronic acid 91% to 51% at a year in a 329-person randomised trial and reached 97% in the temples — slow, cumulative, no eraser, nodules in one in ten.',
                    tone: 'gold' as const,
                  },
                  {
                    id: 'clinic-fat-grafting',
                    kind: 'For one permanent answer',
                    title: 'Fat grafting',
                    blurb: 'Your own tissue, 47% pooled retention across 27 studies and better in the still temples and cheeks — an operation, often twice, and the safety row read first.',
                    tone: 'bone' as const,
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card group flex flex-col bg-white border border-ink/10 overflow-hidden hover:border-rose transition"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} tone={pick.tone} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="text-[10px] uppercase tracking-widest font-semibold text-sage">{pick.kind}</p>
                      <h3 class="font-display text-lg leading-tight mt-1 group-hover:text-rose transition">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="mt-4 inline-flex items-center gap-1 text-xs uppercase tracking-widest font-semibold text-rose group-hover:gap-2 transition-all">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-6xl mx-auto px-6 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="text-xs uppercase tracking-[0.3em] text-sage">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="font-display text-3xl md:text-4xl mt-2">{g.title}</h2>
            {g.intro && <p class="mt-3 text-ink/70 max-w-2xl">{g.intro}</p>}
            <div class="mt-8 grid gap-2">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 bg-gradient-to-br from-rose/10 via-bone to-sage/5 p-6 md:p-10 border border-ink/5">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">Interactive</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">Match a plan to your face</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid gap-2">
            {matcher.map((m) => (
              <details class="matcher-item group border border-ink/10 bg-white px-4 py-3 transition hover:border-rose/40 open:border-rose/40">
                <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
                  <h3 class="font-display text-xl leading-tight group-hover:text-rose group-open:text-rose transition">{m.concern}</h3>
                  <span class="shrink-0 w-8 h-8 flex items-center justify-center text-rose bg-rose/10 group-open:bg-rose group-open:text-white transition" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="mt-3 pt-3 border-t border-ink/10 space-y-2">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="flex gap-3 p-3 bg-bone/50 border border-ink/5 hover:border-rose/40 transition">
                      <span class="font-display text-rose w-5 shrink-0">{i + 1}.</span>
                      <span>
                        <span class="font-medium text-ink/90">{p.title}</span>
                        <span class="text-ink/60"> — {p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 bg-white border border-ink/5 p-6 md:p-8 overflow-hidden">
          <p class="text-xs uppercase tracking-[0.3em] text-sage">The action plan</p>
          <h2 class="font-display text-3xl md:text-4xl mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. Diagnose deflation, settle the weight, rebuild the shelves reversibly, and commit to the long game only once the face has told you how much it wants.</p>

          <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="block p-5 bg-bone/40 border border-ink/5 hover:border-rose/40 transition group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display text-2xl text-rose leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-[10px] uppercase tracking-widest font-semibold px-2 py-0.5 bg-sage/15 text-sage">{r.when}</span>
                </div>
                <h3 class="font-display text-lg leading-tight group-hover:text-rose">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 bg-white p-8 border border-ink/5">
          <h2 class="font-display text-3xl">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, randomised trials, meta-analyses, regulator documents or clinical
            series, linked inline within each section. Primary sources: PubMed/PMC, Plastic and Reconstructive
            Surgery, Dermatologic Surgery, the Journal of the American Academy of Dermatology, Aesthetic Surgery
            Journal, Aesthetic Plastic Surgery, the Journal of Cosmetic Dermatology and the FDA.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. The temple carries arteries that connect to the eye and a vein
          that connects to the lungs, hyaluronic gel persists on MRI long after it stops being visible, and a face
          that improves when you lie down is sagging rather than deflated &mdash; the recline test comes before the
          syringe, and the syringe belongs to an injector with hyaluronidase in the room.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-rose);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(184,130,109,0.04); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
