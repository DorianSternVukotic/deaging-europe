---
/**
 * The forehead-lines guide (/forehead-lines) — problem-template variant of
 * the collagen-guide layout: title, description, a full-width explainer
 * video, the three drivers as cards, evidence strength as the primary visual
 * signal, one interactive block (situation matcher) and a month-by-month
 * action plan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import ExpandableDrawer from '../components/ExpandableDrawer.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import {
  drivers,
  groups,
  allSections,
  readingMinutes as guideReadingMinutes,
  type Evidence,
} from '../data/forehead-lines';

const locale = DEFAULT_LOCALE;
const title = 'Forehead lines — every treatment graded by evidence | DeAging Europe';
const description =
  'Forehead lines are folded by the only muscle that lifts your brows — and in many foreheads that muscle is holding heavy lids up. The eyelid test that tells you which forehead you have, toxin, filler, ultrasound, eyelid surgery and the brow lift graded by trial evidence, and the dropped brow in numbers.';

const readingMinutes = guideReadingMinutes();

const evidenceRank: Record<Evidence, number> = { strong: 0, moderate: 1, emerging: 2, limited: 3 };

const orderedSections = (g: (typeof groups)[number]) =>
  g.sections
    .slice()
    .sort((a, b) => evidenceRank[a.evidence ?? 'limited'] - evidenceRank[b.evidence ?? 'limited']);

const faqAnswer: Record<string, string> = {
  'faq-botox-heavy': 'If your forehead is working',
  'faq-static': 'Not on day one',
  'faq-glabella': 'Tug of war',
  'faq-one-side': 'The droopier lid',
  'faq-filler-safe': 'Highest-risk site',
  'faq-brow-lift-or-botox': 'Depends on the lids',
  'faq-how-long': '3–4 months',
  'faq-prevent': 'SPF, glasses, light toxin',
  'faq-timeline': 'A week to six months',
  'faq-cost-ladder': '€20 / month to €8,000',
};

const topInfoIds = new Set(['basics', 'context']);
const infoGroupIds = new Set([...topInfoIds, 'safety', 'faq']);
const topInfoGroups = groups.filter((g) => topInfoIds.has(g.id));
const mainGroups = groups.filter((g) => !topInfoIds.has(g.id));
const evidenceGroups = mainGroups.filter((g) => !infoGroupIds.has(g.id));
const tailInfoGroups = mainGroups.filter((g) => infoGroupIds.has(g.id));
const lastChartGroupId = evidenceGroups[evidenceGroups.length - 1].id;
const partNo = (g: (typeof groups)[number]) => mainGroups.findIndex((x) => x.id === g.id) + 1;

// Interactive matcher — situation → recommended rows, in order.
const matcher: { concern: string; paths: { id: string; title: string; why: string }[] }[] = [
  {
    concern: 'Lines only when I raise my brows',
    paths: [
      { id: 'type-dynamic', title: 'Dynamic lines', why: 'the muscle alone — the stage where toxin works cleanly' },
      { id: 'workup', title: 'The eyelid test first', why: 'a dynamic-looking forehead can still be a working one' },
      { id: 'inj-toxin-frontalis', title: 'Toxin with the frown lines', why: 'two phase 3 trials, light and high' },
      { id: 'home-spf', title: 'Sunscreen and a hat', why: 'keeps the fold from printing' },
    ],
  },
  {
    concern: 'Lines that stay even when my forehead is relaxed',
    paths: [
      { id: 'type-static', title: 'Etched lines', why: 'the fold has printed — toxin stops it, skin work removes it' },
      { id: 'inj-toxin-frontalis', title: 'Toxin across cycles', why: 'etched lines shallow as the folding stops' },
      { id: 'home-retinoid', title: 'A retinoid underneath', why: 'rebuilds the crease the muscle no longer folds' },
      { id: 'inj-ha-static', title: 'A superficial filler for what remains', why: '83% improved at 12 weeks — with the arterial caveat' },
    ],
  },
  {
    concern: 'My lids feel heavy, or I raise my brows to see',
    paths: [
      { id: 'type-compensatory', title: 'The working forehead', why: 'the frontalis is holding your eyes open' },
      { id: 'inj-toxin-glabella-first', title: 'Frown lines only, first', why: 'forehead lines fell from grade 3 to 1 without touching the frontalis' },
      { id: 'clinic-blepharoplasty', title: 'Eyelid surgery if the lids are the cause', why: 'frontalis activity halved at a year in the randomised trial' },
      { id: 'clinic-hifu-brow', title: 'Or an ultrasound brow lift', why: 'about 2 mm for a year, no surgery' },
    ],
  },
  {
    concern: 'Toxin made my brows drop last time',
    paths: [
      { id: 'safety-toxin-brow', title: 'What happened', why: 'the wrong forehead, the wrong site or too much dose' },
      { id: 'type-compensatory', title: 'Check whether your forehead is working', why: 'the eyelid test' },
      { id: 'inj-microbotox', title: 'Micro-dosing next time', why: 'surface fibres only, brow height preserved in reports' },
      { id: 'inj-toxin-glabella-first', title: 'Or the frown lines alone', why: 'the plan with no downside' },
    ],
  },
  {
    concern: 'Lines on one side of my forehead only',
    paths: [
      { id: 'type-asymmetric', title: 'One-sided lines', why: 'all 28 in the series had ptosis on that side' },
      { id: 'workup', title: 'Compare the lids in a photograph', why: 'the lined side shows less upper lid' },
      { id: 'clinic-blepharoplasty', title: 'The lid, not the line', why: 'an oculoplastic opinion before any toxin on that side' },
    ],
  },
  {
    concern: 'Deep furrows in a thick forehead that toxin only softens',
    paths: [
      { id: 'type-static', title: 'Etched furrows', why: 'skin and structure, not just muscle' },
      { id: 'inj-toxin-frontalis', title: 'Toxin as the base', why: 'stops the folding' },
      { id: 'inj-forehead-volume', title: 'Support on the bone', why: 'a convex forehead folds less — 132-patient double-blind trial' },
      { id: 'clinic-fractional-laser', title: 'Resurfacing for the print', why: 'after the muscle is quiet' },
    ],
  },
  {
    concern: "I'm in my twenties and want to prevent them",
    paths: [
      { id: 'faq-prevent', title: 'Prevention in the twenties', why: 'how often the skin folds and how well it springs back' },
      { id: 'home-spf', title: 'Sunscreen and a hat', why: 'the most sun-exposed skin on the face' },
      { id: 'home-eyes', title: 'Glasses and sunglasses', why: 'so the brows stay down' },
      { id: 'inj-toxin-frontalis', title: 'Light toxin when a line lingers', why: 'the strongest evidence on the page' },
    ],
  },
];

// The action plan, month by month.
const planRows = [
  {
    id: 'workup',
    step: 'Week 0: the raise test, the eyelid test — and photograph',
    when: 'Before any consultation',
    blurb: 'Dynamic or etched; working or resting; both sides compared. A straight-on photograph at rest and raised, with the brows’ resting height visible.',
  },
  {
    id: 'home-spf',
    step: 'Day 1 onward: the skin base and the habits',
    when: 'Whatever else you do',
    blurb: 'Sunscreen and a hat, a retinoid, an eye test and sunglasses; notice the eyebrows when you talk.',
  },
  {
    id: 'inj-toxin-frontalis',
    step: 'Month 1: the frown lines, then the frontalis lightly and high',
    when: 'Reviewed at two weeks',
    blurb: 'Glabella first; small doses above the convergence line, nothing within a centimetre of the brow. For the working forehead, the glabella alone.',
  },
  {
    id: 'clinic-blepharoplasty',
    step: 'Months 3–12: skin work for the residue, or the lid and the brow',
    when: 'Once the muscle has been quiet for a cycle',
    blurb: 'A superficial filler or resurfacing for the etched print; eyelid surgery, an ultrasound brow lift or a brow lift when the forehead was working.',
  },
];
---

<BaseLayout title={title} description={description} locale={locale} path="forehead-lines" type="article">
  <article class="bg-bone">
    <!-- ════════════ HERO: title, description, the explainer video ════════════ -->
    <header class="relative">
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 pt-14 md:pt-20 pb-12">
        <p class="eyebrow mb-4">Problem · Forehead lines (horizontal lines)</p>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.02] max-w-3xl">
          Forehead lines, honestly.
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl text-ink/75 leading-relaxed">
          Folded by the only muscle that lifts your brows &mdash; a muscle that, in many foreheads, is also holding
          heavy lids out of your eyes. Below, the eyelid test that tells you which forehead you have, every treatment
          from toxin to the brow lift graded by the trials behind it, and the dropped brow in numbers.
        </p>
        <p class="meta">
          Updated 7 Sep 2026 · ~{readingMinutes} min full read · {allSections().length} sections
        </p>

        <div id="intro" class="scroll-mt-32 mt-10 md:mt-12">
          <MediaPlaceholder kind="video" ratio="16/9" label="The whole guide in two minutes" />
        </div>
      </div>
    </header>

    <!-- ════════════ WHAT'S HAPPENING (three drivers + drawers) · WHICH TYPE ════════════ -->
    <section id="overview" class="scroll-mt-32 max-w-[1440px] mx-auto px-5 md:px-14 py-12 space-y-12">
      {topInfoGroups.map((g) => (
        <section id={g.id} class="scroll-mt-32 pt-2">
          <h2 class="text-[32px] md:text-[44px] leading-none">{g.title}</h2>
          {g.id === 'basics' && (
            <div class="tiles mt-6 md:grid-cols-3">
              {drivers.map((d) => (
                <a href={`#${d.id}`} class="tile group">
                  <p class="eyebrow">{d.kind}</p>
                  <h3 class="text-xl leading-tight transition-colors">{d.title}</h3>
                  <p class="mt-2 text-sm text-ink/65 leading-snug">{d.blurb}</p>
                </a>
              ))}
            </div>
          )}
          <div class={g.id === 'basics' ? 'mt-4 grid' : 'mt-6 grid'}>
            {g.sections.map((s) => (
              <ExpandableDrawer id={s.id} title={s.title} bodyHtml={s.bodyHtml} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ════════════ MAIN CONTENT (the graded chart) ════════════ -->
    <section>
      <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        <div class="mb-10 pt-7 border-t-2 border-ink">
          <p class="eyebrow">The full breakdown</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl mt-2 leading-[1.05]">Forehead lines — what the evidence says</h2>
        </div>

        <div id="guide-body" class="min-w-0">
          {evidenceGroups.map((g) => (
          <>
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>

            {g.id === 'inj' && (
              <div class="mt-6 grid md:grid-cols-2 gap-4">
                <MediaPlaceholder kind="video" ratio="16/9" label="The convergence line, the five points and the centimetre above the brow" />
                <MediaPlaceholder kind="image" ratio="16/9" label="Resting, working and one-sided — the three foreheads in the eyelid test" />
              </div>
            )}

            <div class="chart mt-8">
                {orderedSections(g).map((s) => (
                  <EvidenceRow
                    s={s}
                    figure={g.id === 'clinic'}
                  />
                ))}
            </div>
          </section>

          {g.id === lastChartGroupId && (
            <div id="picks" class="band bleed scroll-mt-32 mb-16 py-12 md:py-14">
              <p class="eyebrow">Editor's choice</p>
              <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Our picks</h2>
              <p class="mt-3 text-ink/70 max-w-2xl">One per problem — where the evidence is actually good.</p>

              <div class="tiles mt-8 sm:grid-cols-2 lg:grid-cols-4">
                {[
                  {
                    id: 'inj-toxin-frontalis',
                    kind: 'For dynamic lines',
                    title: 'Toxin with the frown lines',
                    blurb: 'Two phase 3 trials — 61% two grades better at a month against 0% on placebo — and a label that prints the trade: brow droop 2%, eyelid droop 2%.',
                  },
                  {
                    id: 'clinic-blepharoplasty',
                    kind: 'When the lids are the cause',
                    title: 'Upper blepharoplasty',
                    blurb: 'Fix the lid and the frontalis stands down: its electrical activity halved at a year in a 54-patient randomised trial, with fewer headaches.',
                  },
                  {
                    id: 'inj-ha-static',
                    kind: 'For etched lines',
                    title: 'A superficial filler, by cannula',
                    blurb: 'The one filler licensed for forehead lines in Europe improved 83% at 12 weeks; the forehead is the highest-risk site for filler blindness, so expert hands only.',
                  },
                  {
                    id: 'clinic-hifu-brow',
                    kind: 'For the low brow',
                    title: 'An ultrasound brow lift',
                    blurb: 'About 2 mm of brow for a year in a 42-person randomised blinded study — the non-surgical way to unload a working forehead.',
                  },
                ].map((pick) => (
                  <a
                    href={`#${pick.id}`}
                    class="pick-card tile tile--flush group overflow-hidden"
                  >
                    <MediaPlaceholder kind="image" ratio="4/3" label={pick.title} />
                    <div class="p-5 flex flex-col flex-1">
                      <p class="eyebrow">{pick.kind}</p>
                      <h3 class="text-xl leading-tight mt-1 transition-colors">{pick.title}</h3>
                      <p class="mt-2 text-sm text-ink/65 leading-snug flex-1">{pick.blurb}</p>
                      <span class="cta mt-4 self-start">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          </>
        ))}
        </div>
      </div>
    </section>

    <!-- ════════════ SAFETY / FAQ TAIL + MATCHER / PLAN / REFERENCES ════════════ -->
    <div class="max-w-[1440px] mx-auto px-5 md:px-14 py-12">

        {tailInfoGroups.map((g) => (
          <section id={g.id} class="group-section scroll-mt-32 mb-16" data-group={g.id}>
            <p class="eyebrow">Part {String(partNo(g)).padStart(2, '0')}</p>
            <h2 class="text-[32px] md:text-[44px] leading-none mt-2">{g.title}</h2>
            <div class="mt-8 grid">
              {g.sections.map((s) => (
                <ExpandableDrawer id={s.id} title={s.title} short={faqAnswer[s.id] ?? s.tldr} bodyHtml={s.bodyHtml} />
              ))}
            </div>
          </section>
        ))}

        <!-- ════════════ SITUATION MATCHER ════════════ -->
        <section id="matcher" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">Interactive</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">Match a plan to your forehead</h2>
          <p class="mt-2 text-ink/70 max-w-2xl">Open the situation that is yours &mdash; each link jumps to the graded section, in the order to try them.</p>

          <div class="mt-8 grid">
            {matcher.map((m) => (
              <details class="matcher-item group border-t border-ink last:border-b">
                <summary class="cursor-pointer flex items-center justify-between gap-4 py-3.5 min-h-[44px]">
                  <h3 class="text-[19px] md:text-2xl leading-tight group-hover:text-accent group-open:text-accent transition-colors">{m.concern}</h3>
                  <span class="shrink-0 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-accent group-hover:text-ink transition" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-open:rotate-180">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="pb-5">
                  {m.paths.map((p, i) => (
                    <a href={`#${p.id}`} class="group/path grid grid-cols-[40px_minmax(0,1fr)] gap-4 py-3 border-t border-ink/15">
                      <span class="label label--steel pt-1">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <span class="block font-display font-medium text-[17px] tracking-tight leading-snug group-hover/path:text-accent transition-colors">{p.title}</span>
                        <span class="block mt-1 text-sm text-ink/65 leading-normal">{p.why}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- ════════════ THE PLAN, MONTH BY MONTH ════════════ -->
        <section id="plan" class="scroll-mt-32 mb-16 pt-8 border-t border-ink">
          <p class="eyebrow">The action plan</p>
          <h2 class="text-[32px] md:text-[44px] leading-none mt-2">The plan, month by month</h2>
          <p class="mt-2 text-ink/65 max-w-2xl">What happens in which order &mdash; and when it is fair to judge it. The eyelid test first, the frown lines second, the frontalis lightly, and the lid or brow when the forehead was working.</p>

          <div class="tiles mt-6 sm:grid-cols-2 lg:grid-cols-4">
            {planRows.map((r, i) => (
              <a href={`#${r.id}`} class="tile group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-display font-semibold text-[32px] tracking-tight leading-none">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono uppercase">{r.when}</span>
                </div>
                <h3 class="text-xl leading-tight transition-colors">{r.step}</h3>
                <p class="mt-1 text-sm text-ink/65 leading-snug">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ════════════ REFERENCES ════════════ -->
        <section id="references" class="scroll-mt-32 pt-6 border-t border-ink">
          <h2 class="text-[32px] leading-none">References &amp; further reading</h2>
          <p class="mt-2 text-ink/70 text-sm">
            All claims cite peer-reviewed studies, phase 3 trials, prescribing information, consensus statements or
            clinical series, linked inline within each section. Primary sources: PubMed/PMC, Dermatologic Surgery,
            Plastic and Reconstructive Surgery, Aesthetic Plastic Surgery, Aesthetic Surgery Journal, the British
            Journal of Dermatology, DailyMed and the Journal of Plastic, Reconstructive &amp; Aesthetic Surgery.
          </p>
        </section>

        <p class="mt-10 text-xs text-ink/50 italic max-w-3xl">
          Educational content, not medical advice. The muscle that makes these lines is the muscle that keeps your
          brows and eyelids out of your eyes, and the arteries under this skin connect to the eye &mdash; toxin here
          is a matter of small doses and exact placement, filler belongs to an expert with hyaluronidase in the room,
          and a one-sided forehead deserves an eyelid examination before anything.
        </p>
    </div>
  </article>

  <style>
    details > summary::-webkit-details-marker { display: none; }
    details > summary { list-style: none; }

    details > summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .card[open] > summary { background: rgba(18,18,18,0.03); }

    section[id], details[id] {
      scroll-margin-top: calc(var(--header-h, 60px) + var(--bar-h, 56px) + 12px);
    }

    @media print {
      aside, .pointer-events-none { display: none !important; }
      details { break-inside: avoid; }
      .card { break-inside: avoid; border: 1px solid #ddd !important; box-shadow: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const guideBody = document.getElementById('guide-body');
      if (!guideBody) return;

      function measureChrome() {
        const header = document.querySelector('body > header');
        document.documentElement.style.setProperty('--header-h', (header?.getBoundingClientRect().height || 60) + 'px');
        document.documentElement.style.setProperty('--bar-h', '0px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function openHashTarget() {
        if (!location.hash) return;
        const el = document.getElementById(location.hash.slice(1));
        if (el?.tagName === 'DETAILS') el.setAttribute('open', '');
      }
      window.addEventListener('hashchange', openHashTarget);
      openHashTarget();
    })();
  </script>
</BaseLayout>
