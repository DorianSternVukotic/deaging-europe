---
// Default-locale (en) homepage lives at "/"
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, t } from '../i18n/utils';
import { type Locale } from '../i18n/ui';
import { allSections, evidenceCounts, readingMinutes } from '../data/collagen';
import { EVIDENCE_TIERS, evidenceColor, evidenceLabels } from '../data/evidence';
import { guides } from '../data/guides';

const locale: Locale = 'en';

const allProducts = await getCollection('products', ({ data }) => data.locale === locale);

// Collagen spotlight — the flagship guide. Everything here is derived from the
// guide's own data module so the card can't drift from /collagen.
const tiers = EVIDENCE_TIERS;
const counts = evidenceCounts();
const maxCount = Math.max(...tiers.map((e) => counts[e]));
const gradedCount = tiers.reduce((n, e) => n + counts[e], 0);
const ledger = tiers.map((e) => ({
  tier: e,
  label: evidenceLabels[e],
  count: counts[e],
  pct: Math.round((counts[e] / maxCount) * 100),
  color: evidenceColor[e],
}));
const guideMinutes = readingMinutes();
const sectionCount = allSections().length;

// The rest of the library — drafts, listed plainly under the collagen cluster.
const kindLabels: Record<string, string> = {
  foundation: 'Foundation',
  clinic: 'In-clinic',
  lifestyle: 'Lifestyle',
};
const drafts = guides.filter((g) => g.path !== 'collagen');

// The collagen product — the one product page that is fully sourced.
const product = allProducts.find((p) => p.data.slug === 'collagen-max-pro') ?? allProducts[0];
const productSymbol = product?.data.currency === 'EUR' ? '€' : `${product?.data.currency ?? ''} `;

---
<BaseLayout
  title="DeAging Europe | Evidence-based anti-aging information and products"
  description="The European hub for anti-aging protocols, ingredients and devices that actually work, backed by science and reviewed by clinicians."
  locale={locale}
>
  <section class="relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 pt-24 md:pt-32 pb-16 md:pb-20">
      <p class="text-xs uppercase tracking-[0.4em] text-sage">{t(locale, 'home.hero.eyebrow')}</p>
      <h1 class="font-display text-5xl md:text-7xl mt-6 max-w-4xl leading-[1.05]">
        {t(locale, 'home.hero.title')}
      </h1>
      <p class="mt-8 text-xl text-ink/75 max-w-2xl leading-relaxed">{t(locale, 'home.hero.sub')}</p>
      <div class="mt-10 flex gap-4 flex-wrap">
        <a href="/collagen" class="bg-ink text-bone px-8 py-4 rounded-full font-semibold hover:bg-rose transition">
          Read the collagen guide
        </a>
        <a href={localePath(locale, 'products/collagen-max-pro')} class="border-2 border-ink text-ink px-8 py-4 rounded-full font-semibold hover:bg-ink hover:text-bone transition">
          See our collagen pick
        </a>
      </div>
    </div>
    <div class="absolute -right-32 -top-32 w-96 h-96 bg-rose/10 rounded-full blur-3xl pointer-events-none"></div>
  </section>

  {/* ── Collagen: the guide and the product, the two pages that are done. ── */}
  <section id="collagen" class="scroll-mt-24 pb-20">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-[11px] uppercase tracking-[0.3em] font-semibold text-sage">Collagen · guide and product</p>

      {/* Flagship guide. One block link; the evidence ledger on the right is
          the guide's real grading, drawn to scale. */}
      <a
        href="/collagen"
        class="group relative mt-4 grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-14 items-center bg-white rounded-3xl border border-ink/10 p-7 md:p-10 hover:border-rose hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose transition"
      >
        <div>
          <p class="text-[11px] uppercase tracking-[0.3em] font-semibold text-sage">The flagship guide</p>
          <h2 class="font-display text-4xl md:text-5xl mt-3 leading-[1.02]">
            Collagen, end&#8209;to&#8209;end<span class="text-rose">.</span>
          </h2>
          <p class="mt-4 text-ink/70 max-w-md leading-relaxed">
            What it is, what supplements actually do, and which clinical treatments stimulate new collagen.
          </p>
          <span class="mt-6 inline-flex items-center gap-2 rounded-full bg-rose px-6 py-3 text-sm font-semibold text-bone group-hover:bg-ink transition">
            Read the guide
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
          <p class="mt-3 text-xs text-ink/50">
            ~{guideMinutes} min full read · skim it in 3 · {sectionCount} sections
          </p>
        </div>

        <div aria-label="Evidence at a glance">
          <p class="text-[11px] uppercase tracking-[0.3em] font-semibold text-ink/45">
            {gradedCount} options, graded by clinical evidence
          </p>
          <ul class="mt-4 space-y-2.5">
            {ledger.map((row) => (
              <li class="grid grid-cols-[5.5rem_1fr_2.5ch] items-center gap-3" aria-label={`${row.label}: ${row.count} options`}>
                <span class="text-[11px] uppercase tracking-widest font-semibold" style={`color: ${row.color};`}>{row.tier}</span>
                <span class="block h-6 rounded-full bg-ink/[0.07] overflow-hidden">
                  <span class="block h-full rounded-full" style={`width: ${row.pct}%; background: ${row.color};`}></span>
                </span>
                <span class="text-sm font-semibold tabular-nums text-right text-ink/80">{row.count}</span>
              </li>
            ))}
          </ul>
        </div>
      </a>

      {/* The product we sell — same white card language, so it reads as the
          guide's sibling. `#products` keeps the nav anchor working. */}
      {product && (
        <a
          id="products"
          href={localePath(locale, `products/${product.data.slug}`)}
          class="group scroll-mt-24 mt-5 grid md:grid-cols-[minmax(0,300px)_1fr] gap-6 md:gap-10 items-center bg-white rounded-3xl border border-ink/10 p-5 md:p-7 hover:border-rose hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose transition"
        >
          <div class="product-ground rounded-2xl overflow-hidden">
            <img src={product.data.image} alt={product.data.title} loading="lazy" class="w-full aspect-[4/3] object-contain p-4" />
          </div>
          <div class="md:py-2">
            <p class="text-[11px] uppercase tracking-[0.3em] font-semibold text-sage">Our pick · {product.data.brand}</p>
            <h2 class="font-display text-3xl md:text-4xl mt-2 leading-tight">{product.data.title}</h2>
            <p class="mt-3 text-ink/70 max-w-lg leading-relaxed">{product.data.tagline}</p>
            <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
              <span class="inline-flex items-center gap-2 rounded-full bg-rose px-6 py-3 text-sm font-semibold text-bone group-hover:bg-ink transition">
                See the product
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
              {product.data.price && (
                <span class="text-sm text-ink/60">
                  <span class="font-display text-2xl text-ink">{productSymbol}{product.data.price}</span>
                  {product.data.servings && <> · {product.data.servings} servings</>}
                </span>
              )}
            </div>
          </div>
        </a>
      )}
    </div>
  </section>

  {/* ── Everything else: drafts. Clickable, deliberately quiet. ── */}
  <section id="guides" class="scroll-mt-24 py-14 border-t border-ink/5">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-[11px] uppercase tracking-[0.3em] text-ink/40">In progress</p>
      <h2 class="font-display text-2xl md:text-3xl mt-2 text-ink/70">More guides, still being cited</h2>
      <p class="mt-2 text-sm text-ink/50 max-w-xl">
        Readable drafts. The grading is in place; citations and photography are still being filled in.
      </p>
      <ul class="mt-6 max-w-3xl columns-1 sm:columns-2 gap-x-12">
        {drafts.map((g) => (
          <li class="break-inside-avoid border-b border-ink/[0.06] py-2 text-sm">
            <a href={`/${g.path}`} class="text-ink/55 hover:text-ink hover:underline decoration-ink/30 underline-offset-2 transition">
              {g.title}
            </a>
            <span class="ml-2 text-[10px] uppercase tracking-widest text-ink/30">{kindLabels[g.kind] ?? g.kind}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    /* The tub's own label mint, paled, matching the product page's gallery ground. */
    .product-ground {
      background: linear-gradient(180deg, #e3f1ed 0%, #d3eae4 100%);
    }
  </style>
</BaseLayout>
